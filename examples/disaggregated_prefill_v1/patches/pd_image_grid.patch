+def _pd_image_grids(engine_input):
+    """Return per-image identity and grid in prompt order, or omit the hint."""
+    hashes = engine_input.get("mm_hashes") or {}
+    if set(hashes) != {"image"}:
+        return None
+    items = (engine_input.get("mm_kwargs") or {}).get("image", ())
+    if len(items) != len(hashes["image"]):
+        return None
+    result = []
+    for key, item in zip(hashes["image"], items):
+        field = item.get("image_grid_thw") if item is not None else None
+        if field is not None:
+            grid = field.data.reshape(-1).tolist()
+            if len(grid) != 3 or any(type(n) is not int or n <= 0 for n in grid):
+                return None
+            _pd_grid_cache[key] = grid
+            if len(_pd_grid_cache) > 8192:
+                _pd_grid_cache.popitem(last=False)
+        elif key not in _pd_grid_cache:
+            return None
+        _pd_grid_cache.move_to_end(key)
+        result.append({"hash": key, "grid": _pd_grid_cache[key]})
+    return result
+
+
+_pd_grid_cache = OrderedDict()
+
