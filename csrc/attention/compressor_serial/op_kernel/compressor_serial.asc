#include "arch35/compressor_serial_pool.h"
#include "arch35/compressor_serial_finalize.h"
#include "arch35/compressor_serial_cache.h"
using namespace AscendC;

template<typename Input, int Tile>
__global__ __vector__ void serial_cast(GM_ADDR input, GM_ADDR output, uint64_t count)
{
    TPipe pipe;
    TBuf<TPosition::VECCALC> buffer;
    pipe.InitBuffer(buffer, Tile * 8);
    auto src = buffer.Get<Input>();
    auto dst = buffer.Get<float>()[Tile];
    GlobalTensor<Input> x;
    GlobalTensor<float> y;
    x.SetGlobalBuffer((__gm__ Input*)input);
    y.SetGlobalBuffer((__gm__ float*)output);
    for (uint64_t off = GetBlockIdx() * Tile; off < count; off += GetBlockNum() * Tile) {
        uint32_t n = count - off < Tile ? count - off : Tile;
        DataCopyExtParams copyIn{1, static_cast<uint32_t>(n * sizeof(Input)), 0, 0, 0};
        DataCopyPadExtParams<Input> pad{false, 0, 0, 0};
        DataCopyPad(src, x[off], copyIn, pad);
        PipeBarrier<PIPE_ALL>();
        Cast(dst, src, RoundMode::CAST_NONE, n);
        PipeBarrier<PIPE_ALL>();
        DataCopyExtParams copyOut{1, static_cast<uint32_t>(n * sizeof(float)), 0, 0, 0};
        DataCopyPad(y[off], dst, copyOut);
        PipeBarrier<PIPE_ALL>();
    }
}

template<int Threads>
__global__ __vector__ void serial_pool(GM_ADDR projection, GM_ADDR state, GM_ADDR ape,
    GM_ADDR table, GM_ADDR cu, GM_ADDR used, GM_ADDR start, GM_ADDR pooled, GM_ADDR params)
{
    auto p = (__gm__ const CompressorSerialParams*)params;
    if (p->ratio == 4 && p->dim == 128 && p->coff == 2) {
    Simt::VF_CALL<CompressorSerial::Pool<Threads,4,128,2>>(Simt::Dim3(Threads),
        (__gm__ const float*)projection, (__gm__ const float*)state, (__gm__ const float*)ape,
        (__gm__ const int32_t*)table, (__gm__ const int32_t*)cu, (__gm__ const int32_t*)used,
        (__gm__ const int32_t*)start, (__gm__ float*)pooled, p);
    } else if (p->ratio == 4 && p->dim == 512 && p->coff == 2) {
    Simt::VF_CALL<CompressorSerial::Pool<Threads,4,512,2>>(Simt::Dim3(Threads),
        (__gm__ const float*)projection, (__gm__ const float*)state, (__gm__ const float*)ape,
        (__gm__ const int32_t*)table, (__gm__ const int32_t*)cu, (__gm__ const int32_t*)used,
        (__gm__ const int32_t*)start, (__gm__ float*)pooled, p);
    } else if (p->ratio == 128 && p->dim == 512 && p->coff == 1) {
    Simt::VF_CALL<CompressorSerial::PoolWarp<Threads,128,512,1>>(Simt::Dim3(Threads),
        (__gm__ const float*)projection, (__gm__ const float*)state, (__gm__ const float*)ape,
        (__gm__ const int32_t*)table, (__gm__ const int32_t*)cu, (__gm__ const int32_t*)used,
        (__gm__ const int32_t*)start, (__gm__ float*)pooled, p);
    } else if (p->ratio >= 32) {
    Simt::VF_CALL<CompressorSerial::PoolWarp<Threads>>(Simt::Dim3(Threads),
        (__gm__ const float*)projection, (__gm__ const float*)state, (__gm__ const float*)ape,
        (__gm__ const int32_t*)table, (__gm__ const int32_t*)cu, (__gm__ const int32_t*)used,
        (__gm__ const int32_t*)start, (__gm__ float*)pooled, p);
    } else {
    Simt::VF_CALL<CompressorSerial::Pool<Threads>>(Simt::Dim3(Threads),
        (__gm__ const float*)projection, (__gm__ const float*)state, (__gm__ const float*)ape,
        (__gm__ const int32_t*)table, (__gm__ const int32_t*)cu, (__gm__ const int32_t*)used,
        (__gm__ const int32_t*)start, (__gm__ float*)pooled, p);
    }
}

template<typename Output, int Threads>
__global__ __vector__ void serial_finalize(GM_ADDR projection, GM_ADDR state, GM_ADDR ape,
    GM_ADDR gamma, GM_ADDR sin, GM_ADDR cos, GM_ADDR table, GM_ADDR cu, GM_ADDR used,
    GM_ADDR start, GM_ADDR pooled, GM_ADDR output, GM_ADDR params)
{
    auto p = (__gm__ const CompressorSerialParams*)params;
    CompressorSerial::Finalize<Output> finalize;
    finalize.Run(pooled, gamma, sin, cos, output, p);
    if (p->tokens >= 32) {
        CompressorSerial::CacheUpdate update;
        update.Run(projection, state, ape, table, cu, used, start, p);
    } else {
    Simt::VF_CALL<CompressorSerial::Update<Threads>>(Simt::Dim3(Threads),
        (__gm__ const float*)projection, (__gm__ float*)state, (__gm__ const float*)ape,
        (__gm__ const int32_t*)table, (__gm__ const int32_t*)cu, (__gm__ const int32_t*)used,
        (__gm__ const int32_t*)start, p);
    }
}

extern "C" void compressor_serial_cast_launch(uint32_t blocks, void* stream, void* x, void* y,
                                              uint64_t count, int dtype)
{
    if (count >= 65536) {
        if (dtype == 0) serial_cast<bfloat16_t,16384><<<blocks, nullptr, stream>>>((uint8_t*)x, (uint8_t*)y, count);
        else serial_cast<half,16384><<<blocks, nullptr, stream>>>((uint8_t*)x, (uint8_t*)y, count);
    } else {
        if (dtype == 0) serial_cast<bfloat16_t,4096><<<blocks, nullptr, stream>>>((uint8_t*)x, (uint8_t*)y, count);
        else serial_cast<half,4096><<<blocks, nullptr, stream>>>((uint8_t*)x, (uint8_t*)y, count);
    }
}

#define POOL_ARGS (uint8_t*)projection,(uint8_t*)state,(uint8_t*)ape,(uint8_t*)table,(uint8_t*)cu,(uint8_t*)used,(uint8_t*)start,(uint8_t*)pooled,(uint8_t*)params
#define FINAL_ARGS (uint8_t*)projection,(uint8_t*)state,(uint8_t*)ape,(uint8_t*)gamma,(uint8_t*)sin,(uint8_t*)cos,(uint8_t*)table,(uint8_t*)cu,(uint8_t*)used,(uint8_t*)start,(uint8_t*)pooled,(uint8_t*)output,(uint8_t*)params
extern "C" void compressor_serial_vector_launch(uint32_t blocks, void* stream, void* projection,
    void* state, void* ape, void* gamma, void* sin, void* cos, void* table, void* cu, void* used,
    void* start, void* pooled, void* output, void* params, int stage, int dtype, int threads)
{
    if (stage == 0) {
        if (threads == 128) serial_pool<128><<<blocks,nullptr,stream>>>(POOL_ARGS);
        else if (threads == 512) serial_pool<512><<<blocks,nullptr,stream>>>(POOL_ARGS);
        else serial_pool<256><<<blocks,nullptr,stream>>>(POOL_ARGS);
    } else if (dtype == 0) {
        serial_finalize<bfloat16_t,256><<<blocks,nullptr,stream>>>(FINAL_ARGS);
    } else {
        serial_finalize<half,256><<<blocks,nullptr,stream>>>(FINAL_ARGS);
    }
}
