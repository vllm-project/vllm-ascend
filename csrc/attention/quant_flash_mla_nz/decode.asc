// Reuse the arch35 QuantFlashMla block implementations shipped with ops-transformer.
#include "decode.h"
#include "kernel_operator.h"

#if defined(__DAV_C310__)
#include "kernel_operator_list_tensor_intf.h"
#include "util.h"
#include "arch35/flash_attention_score_common_regbase_arch35.h"
#include "vector_common.h"
#include "quant_flash_mla_kernel.h"

using namespace AscendC;
using namespace optiling;
#ifdef __DAV_C310_CUBE__
#include "pv_tail.h"
#endif

template <bool causal>
__aicore__ inline void Decode(GM_ADDR q, GM_ADDR kv, GM_ADDR qScale, GM_ADDR kvScale, GM_ADDR table,
    GM_ADDR lengths, GM_ADDR cu, GM_ADDR used, GM_ADDR mask, GM_ADDR schedule, GM_ADDR out, GM_ADDR workspace,
    const QuantMlaShape& shape)
{
    constexpr auto in = LayOutTypeEnum::LAYOUT_TND;
    constexpr auto outLayout = LayOutTypeEnum::LAYOUT_NTD;
    constexpr auto m = S1TemplateType::Aligned64;
    constexpr auto n = S2TemplateType::Aligned256;
    constexpr auto k = DTemplateType::Aligned576;
    constexpr auto v = DTemplateType::Aligned512;
    constexpr uint8_t nz = 2;
    using Fp8 = fp8_e4m3fn_t;
#ifdef __DAV_C310_CUBE__
    using Cube = BaseApi::DecodeNzCube;
    using Vec = BaseApi::QuantFlashMlaBlockVecFp8Dummy<Fp8, float, bfloat16_t, in, outLayout, m, n, k, v, causal, nz, true>;
    using Reduce = BaseApi::QuantFlashMlaBlockVecFlashDecodeFp8Dummy<Fp8, float, bfloat16_t, in, outLayout, m, n, k, v>;
#else
    using Cube = BaseApi::QuantFlashMlaBlockCubeFp8Dummy<Fp8, float, in, m, n, k, v, nz>;
    using Vec = BaseApi::QuantFlashMlaBlockVecFp8<Fp8, float, bfloat16_t, in, outLayout, m, n, k, v, causal, nz, true>;
    using Reduce = BaseApi::QuantFlashMlaBlockVecFlashDecodeFp8<Fp8, float, bfloat16_t, in, outLayout, m, n, k, v>;
#endif
    fa_base_matmul::ResetIdCounter();
    InitSocState();
    SetSysWorkspaceForce(workspace);
    QuantFlashMlaTilingData tiling{};
    auto& base = tiling.baseParams;
    base.bSize = shape.requests;
    base.t1Size = shape.tokens;
    base.n1Size = shape.heads;
    base.n2Size = 1;
    base.gSize = shape.heads;
    base.s1Size = shape.tokens;
    base.s2Size = shape.tableWidth * 128;
    base.dSize = 576;
    base.dSizeV = 512;
    base.cuSeqLensQSize = shape.requests + 1;
    base.seqUsedQSize = shape.requests;
    base.scaleValue = shape.scale;
    base.isMetadataEnable = 1;
    base.coreNum = shape.cores;
    base.outputLayout = QFMLA_LAYOUT_NTD;
    base.keyStrides.bnStride = shape.pageStride;
    tiling.attenMaskParams.maskMode = causal ? 3 : 0;
    tiling.attenMaskParams.attenMaskS1Size = causal ? 2048 : 0;
    tiling.attenMaskParams.attenMaskS2Size = causal ? 2048 : 0;
    tiling.pageAttentionParams.paLayoutType = nz;
    tiling.pageAttentionParams.blockSize = 128;
    tiling.pageAttentionParams.maxBlockNumPerBatch = shape.tableWidth;
    // Two partial tiles per core. The reducer consumes 512 accumulators and two eight-float LSE
    // records per row. The offsets are in elements and must agree with the metadata producer.
    const uint32_t partialRows = shape.cores * 2 * 64;
    tiling.workspaceParams.accumOutSize = partialRows * 512;
    tiling.workspaceParams.logSumExpSize = partialRows * 8;
    TPipe pipe;
    BaseApi::QuantFlashMlaKernelFp8<Cube, Vec, Reduce> op;
    op.Init(q, kv, qScale, kvScale, table, lengths, cu, used, mask, schedule, out, nullptr, workspace, tiling);
    op.Process();
}
#endif

template <bool causal>
__global__ __mix__(1, 2) void QuantFlashMlaNz(GM_ADDR q, GM_ADDR kv, GM_ADDR qScale, GM_ADDR kvScale, GM_ADDR table,
    GM_ADDR lengths, GM_ADDR cu, GM_ADDR used, GM_ADDR mask, GM_ADDR schedule, GM_ADDR out, GM_ADDR workspace,
    QuantMlaShape shape)
{
#if defined(__DAV_C310__)
    Decode<causal>(q, kv, qScale, kvScale, table, lengths, cu, used, mask, schedule, out, workspace, shape);
#endif
}

extern "C" void launch_quant_flash_mla_nz(void* stream, uint8_t* q, uint8_t* kv, uint8_t* qScale, uint8_t* kvScale,
    uint8_t* table, uint8_t* lengths, uint8_t* cu, uint8_t* used, uint8_t* mask, uint8_t* schedule, uint8_t* out,
    uint8_t* workspace, QuantMlaShape shape)
{
    if (mask != nullptr) {
        QuantFlashMlaNz<true><<<shape.cores, nullptr, stream>>>(
            q, kv, qScale, kvScale, table, lengths, cu, used, mask, schedule, out, workspace, shape);
    } else {
        QuantFlashMlaNz<false><<<shape.cores, nullptr, stream>>>(
            q, kv, qScale, kvScale, table, lengths, cu, used, nullptr, schedule, out, workspace, shape);
    }
}
