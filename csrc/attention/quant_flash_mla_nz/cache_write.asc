#include "kernel_operator.h"

namespace {
constexpr uint32_t kPageTokens = 128;
constexpr uint32_t kFragment = 32;
constexpr uint32_t kLatent = 512;
constexpr uint32_t kRope = 64;

template <typename Slot>
__global__ __vector__ void WritePages(__gm__ uint8_t* latent, __gm__ uint8_t* rope,
                                      __gm__ uint8_t* latentPages, __gm__ uint8_t* ropePages,
                                      __gm__ Slot* slots, uint32_t count, uint64_t pages,
                                      uint64_t latentStride, uint64_t ropeStride, uint64_t pageStride)
{
    using namespace AscendC;
    GlobalTensor<uint8_t> k, r, kCache, rCache;
    k.SetGlobalBuffer(latent);
    r.SetGlobalBuffer(rope);
    kCache.SetGlobalBuffer(latentPages);
    rCache.SetGlobalBuffer(ropePages);
    LocalTensor<uint8_t> row(TPosition::VECIN, 0, kLatent + kRope);
    for (uint32_t i = GetBlockIdx(); i < count; i += GetBlockNum()) {
        const int64_t slot = slots[i];
        if (slot < 0 || static_cast<uint64_t>(slot) / kPageTokens >= pages) {
            continue;
        }
        DataCopy(row, k[i * latentStride], kLatent);
        DataCopy(row[kLatent], r[i * ropeStride], kRope);
        SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);

        // [page, head=1, D/32, token, 32]. Each burst writes one channel fragment.
        const uint64_t offset = slot / kPageTokens * pageStride + slot % kPageTokens * kFragment;
        DataCopy(kCache[offset], row, DataCopyParams(kLatent / kFragment, 1, 0, kPageTokens - 1));
        DataCopy(rCache[offset], row[kLatent], DataCopyParams(kRope / kFragment, 1, 0, kPageTokens - 1));
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}
}  // namespace

extern "C" void launch_quant_flash_mla_cache_write(void* stream, uint32_t blocks, uint8_t* latent, uint8_t* rope,
                                                    uint8_t* latentPages, uint8_t* ropePages, void* slots, bool wideSlots,
                                                    uint32_t count, uint64_t pages, uint64_t latentStride,
                                                    uint64_t ropeStride, uint64_t pageStride)
{
    if (wideSlots) {
        WritePages<int64_t><<<blocks, nullptr, stream>>>(latent, rope, latentPages, ropePages,
            static_cast<int64_t*>(slots), count, pages, latentStride, ropeStride, pageStride);
    } else {
        WritePages<int32_t><<<blocks, nullptr, stream>>>(latent, rope, latentPages, ropePages,
            static_cast<int32_t*>(slots), count, pages, latentStride, ropeStride, pageStride);
    }
}
