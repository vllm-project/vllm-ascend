// Runtime-geometry recurrent FSA planner. v5 state stores LRU-ordered token/slot
// pairs in two banks. The next bank is published only by ordered stream work.
// req int64[N]; topk int32[N,K]; stable/visible int32[N].
// last int64[R]; banks int32[R]; state int32[R,2,2,C]; map int32[4*R].
// payload: aligned signed int16[K+16] wire, then eight int32 metadata words.
#include "kernel_operator.h"
#include "acl/acl.h"
#include <cstdint>
namespace AscendC {
template <typename T>
__aicore__ inline void FsaLruFastProgression(
    const LocalTensor<T>& dst, T start, T diff, int32_t count)
{
    constexpr int32_t kSeed = 32 / sizeof(T);
    const auto vectorToScalar = GetTPipePtr()->FetchEventID(HardEvent::V_S);
    SetFlag<HardEvent::V_S>(vectorToScalar);
    WaitFlag<HardEvent::V_S>(vectorToScalar);
    for (int32_t lane = 0; lane < kSeed; ++lane) {
        dst.SetValue(lane, start + static_cast<T>(lane) * diff);
    }
    const auto scalarToVector = GetTPipePtr()->FetchEventID(HardEvent::S_V);
    SetFlag<HardEvent::S_V>(scalarToVector);
    WaitFlag<HardEvent::S_V>(scalarToVector);
    for (int32_t filled = kSeed; filled < count; filled *= 2) {
        const int32_t remaining = count - filled;
        const int32_t length = remaining < filled ? remaining : filled;
        Adds(dst[filled], dst, static_cast<T>(filled) * diff, length);
        PipeBarrier<PIPE_V>();
    }
}
} // namespace AscendC

#define ArithProgression FsaLruFastProgression
#include "fsa-lru-plan-a3.h"
namespace {
using namespace AscendC;
constexpr uint32_t kWordBytes=sizeof(int32_t);
constexpr uint32_t kMembershipRowShorts=16400;
constexpr uint32_t kControlOffset=16384;
template <typename T, bool Paged = true>
class RowTable {
public:
    __aicore__ RowTable(GM_ADDR address, LocalTensor<T> cache,
                       uint32_t count, uint32_t pageElements)
        : cache_(cache), count_(count), pageElements_(pageElements)
    {
        gm_.SetGlobalBuffer(reinterpret_cast<__gm__ T*>(address), count);
    }

    __aicore__ T Get(uint32_t index)
    {
        if constexpr (Paged) {
            Load(index);
        }
        return cache_.GetValue(index - begin_);
    }

    __aicore__ void Set(uint32_t index, T value)
    {
        if constexpr (Paged) {
            Load(index);
            dirty_ = true;
        }
        cache_.SetValue(index - begin_, value);
    }

    // Do not fetch the old contents of output-only mapping pages.
    __aicore__ void Initialize(uint32_t index, T value)
    {
        if constexpr (Paged) {
            Load(index, false);
            dirty_ = true;
        }
        cache_.SetValue(index - begin_, value);
    }

    __aicore__ void LoadAll()
    {
        CopyIn(0, count_);
    }

    __aicore__ void Flush()
    {
        if constexpr (!Paged) {
            CopyOut(0, count_);
        } else {
            if (!dirty_) {
                return;
            }
            SetFlag<HardEvent::S_MTE3>(0);
            WaitFlag<HardEvent::S_MTE3>(0);
            CopyOut(begin_, length_);
            SetFlag<HardEvent::MTE3_S>(0);
            WaitFlag<HardEvent::MTE3_S>(0);
            dirty_ = false;
        }
    }

private:
    __aicore__ void CopyIn(uint32_t begin, uint32_t count)
    {
        const DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        const DataCopyPadExtParams<T> noPad{false, 0, 0, 0};
        DataCopyPad(cache_, gm_[begin], copy, noPad);
    }

    __aicore__ void CopyOut(uint32_t begin, uint32_t count)
    {
        const DataCopyExtParams copy{1, static_cast<uint32_t>(count * sizeof(T)), 0, 0, 0};
        DataCopyPad(gm_[begin], cache_, copy);
    }

    __aicore__ void Load(uint32_t index, bool readPrevious = true)
    {
        if (loaded_ && index >= begin_ && index - begin_ < length_) {
            return;
        }
        const uint32_t begin = index / pageElements_ * pageElements_;
        Flush();
        begin_ = begin;
        length_ = count_ - begin < pageElements_ ? count_ - begin : pageElements_;
        if (readPrevious) {
            CopyIn(begin_, length_);
            SetFlag<HardEvent::MTE2_S>(0);
            WaitFlag<HardEvent::MTE2_S>(0);
        }
        loaded_ = true;
    }

    GlobalTensor<T> gm_;
    LocalTensor<T> cache_;
    uint32_t count_, pageElements_, begin_ = 0, length_ = 0;
    bool loaded_ = false, dirty_ = false;
};

// Reserve all existing matches before assigning any new request. This retains
// CPU stable-row semantics, including repeated IDs and first-unused eviction.
template <bool Paged>
__aicore__ inline void MapStableRowsImpl(
    GM_ADDR reqIds, GM_ADDR lastIds, GM_ADDR bankTags, GM_ADDR output,
    uint32_t logicalRows, uint32_t physicalRows, uint32_t pageRows)
{
    TPipe pipe;
    TBuf<TPosition::VECCALC> scratch;
    // Two int64 tables and five int32 tables; pageRows is chosen from actual UB.
    pipe.InitBuffer(scratch, pageRows * (2 * sizeof(int64_t) + 5 * sizeof(int32_t)));
    auto words = scratch.Get<int32_t>();
    RowTable<int64_t, Paged> req(reqIds, words.ReinterpretCast<int64_t>(), logicalRows, pageRows);
    RowTable<int64_t, Paged> last(lastIds, words[2 * pageRows].ReinterpretCast<int64_t>(), physicalRows, pageRows);
    RowTable<int32_t, Paged> banks(bankTags, words[4 * pageRows], physicalRows, pageRows);
    RowTable<int32_t, Paged> mapped(output, words[5 * pageRows], logicalRows, pageRows);
    RowTable<int32_t, Paged> used(output + physicalRows * kWordBytes, words[6 * pageRows], physicalRows, pageRows);
    RowTable<int32_t, Paged> reset(output + 2 * physicalRows * kWordBytes, words[7 * pageRows], logicalRows, pageRows);
    RowTable<int32_t, Paged> oldBank(output + 3 * physicalRows * kWordBytes, words[8 * pageRows], logicalRows, pageRows);
    if constexpr (!Paged) {
        // All tables have disjoint UB storage. Batch the original transfers.
        req.LoadAll();
        last.LoadAll();
        banks.LoadAll();
        SetFlag<HardEvent::MTE2_S>(0);
        WaitFlag<HardEvent::MTE2_S>(0);
    }
    for (uint32_t slot = 0; slot < physicalRows; ++slot) {
        used.Initialize(slot, 0);
    }
    for (uint32_t row = 0; row < logicalRows; ++row) {
        const int64_t id = req.Get(row);
        int32_t selected = -1;
        for (uint32_t slot = 0; slot < physicalRows; ++slot) {
            if (used.Get(slot) == 0 && last.Get(slot) == id) {
                selected = static_cast<int32_t>(slot);
                used.Set(slot, 1);
                break;
            }
        }
        mapped.Initialize(row, selected);
    }
    // Matches are all reserved now. Ensuing assignments only consume slots,
    // so both cursors advance without revisiting occupied or nonempty rows.
    uint32_t firstVacant = 0;
    uint32_t firstUnused = 0;
    bool lastIdsChanged = false;
    for (uint32_t row = 0; row < logicalRows; ++row) {
        int32_t selected = mapped.Get(row);
        const bool needsReset = selected < 0;
        if (needsReset) {
            while (firstVacant < physicalRows &&
                   (used.Get(firstVacant) != 0 || last.Get(firstVacant) != -1)) {
                ++firstVacant;
            }
            if (firstVacant < physicalRows) {
                selected = static_cast<int32_t>(firstVacant++);
            } else {
                // logicalRows <= physicalRows guarantees an unreserved slot.
                while (used.Get(firstUnused) != 0) {
                    ++firstUnused;
                }
                selected = static_cast<int32_t>(firstUnused++);
            }
            mapped.Set(row, selected);
            used.Set(selected, 1);
            last.Set(selected, req.Get(row));
            lastIdsChanged = true;
        }
        reset.Initialize(row, needsReset ? 1 : 0);
        const int32_t bank = banks.Get(selected);
        oldBank.Initialize(row, bank);
        banks.Set(selected, 1 - bank);
    }
    if constexpr (!Paged) {
        SetFlag<HardEvent::S_MTE3>(0);
        WaitFlag<HardEvent::S_MTE3>(0);
    }
    mapped.Flush();
    used.Flush();
    reset.Flush();
    oldBank.Flush();
    if (lastIdsChanged) {
        last.Flush();
    }
    banks.Flush();
    // Whole-table buffers are dead after the final flush.
}

__aicore__ inline void MapStableRows(
    GM_ADDR reqIds, GM_ADDR lastIds, GM_ADDR bankTags, GM_ADDR output,
    uint32_t logicalRows, uint32_t physicalRows, uint32_t pageRows)
{
    if (physicalRows <= pageRows) {
        MapStableRowsImpl<false>(reqIds, lastIds, bankTags, output, logicalRows, physicalRows, pageRows);
    } else {
        MapStableRowsImpl<true>(reqIds, lastIds, bankTags, output, logicalRows, physicalRows, pageRows);
    }
}

__aicore__ inline void PublishRows(
    GM_ADDR payload, GM_ADDR membership, GM_ADDR metadata,
    uint32_t row, uint32_t rows, uint32_t topk, bool hasNextRow)
{
    const uint32_t kWireWords = FsaLruGeometry::AlignWords((topk + 17) / 2);
    const uint32_t kPayloadWords = kWireWords + 8;
    constexpr uint32_t kLaneWords = 32 / sizeof(int32_t);
    TPipe pipe;
    TBuf<TPosition::VECCALC> scratch;
    pipe.InitBuffer(scratch, (kWireWords + kLaneWords * kLaneWords + kLaneWords) * kWordBytes);
    auto wire = scratch.Get<int32_t>();
    GlobalTensor<int32_t> payloadGM;
    GlobalTensor<int16_t> memberGM;
    payloadGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(payload));
    memberGM.SetGlobalBuffer(reinterpret_cast<__gm__ int16_t*>(membership));
    DataCopy(wire, payloadGM[row * kPayloadWords], kWireWords);
    SetFlag<HardEvent::MTE2_MTE3>(0);
    WaitFlag<HardEvent::MTE2_MTE3>(0);
    const DataCopyExtParams wireCopy{1, (topk + 16) * uint32_t{sizeof(int16_t)}, 0, 0, 0};
    DataCopyPad(memberGM[row * kMembershipRowShorts + kControlOffset - topk],
                wire.ReinterpretCast<int16_t>(), wireCopy);

    if (row == 0) {
        // A single block writes [status, current slots] in DMA-aligned chunks.
        // Other blocks never race on a partial metadata cache line.
        auto strided = wire[kWireWords];
        auto compact = strided[kLaneWords * kLaneWords];
        GlobalTensor<int32_t> metadataGM;
        metadataGM.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(metadata));
        const DataCopyPadExtParams<int32_t> noPad{false, 0, 0, 0};
        for (uint32_t begin = 0; begin <= rows; begin += kLaneWords) {
            const uint32_t count = rows + 1 - begin < kLaneWords ? rows + 1 - begin : kLaneWords;
            const uint32_t statusWords = begin == 0 ? 1 : 0;
            const uint32_t slots = count - statusWords;
            if (slots != 0) {
                const uint32_t firstRow = begin == 0 ? 0 : begin - 1;
                const DataCopyExtParams gatherSlots{static_cast<uint16_t>(slots), kWordBytes,
                                                    (kPayloadWords - 1) * kWordBytes, 0, 0};
                DataCopyPad(strided, payloadGM[firstRow * kPayloadWords + kWireWords], gatherSlots, noPad);
                SetFlag<HardEvent::MTE2_S>(0);
                WaitFlag<HardEvent::MTE2_S>(0);
            }
            if (statusWords) {
                compact.SetValue(0, int32_t{0});
            }
            for (uint32_t i = 0; i < slots; ++i) {
                compact.SetValue(i + statusWords, strided.GetValue(i * kLaneWords));
            }
            SetFlag<HardEvent::S_MTE3>(0);
            WaitFlag<HardEvent::S_MTE3>(0);
            const DataCopyExtParams metaCopy{1, count * kWordBytes, 0, 0, 0};
            DataCopyPad(metadataGM[begin], compact, metaCopy);
            if (begin + count < rows + 1 || hasNextRow) {
                SetFlag<HardEvent::MTE3_S>(0);
                WaitFlag<HardEvent::MTE3_S>(0);
            }
        }
    } else if (hasNextRow) {
        // Complete the wire transfer before this block reuses its UB.
        SetFlag<HardEvent::MTE3_S>(0);
        WaitFlag<HardEvent::MTE3_S>(0);
    }
}
} // namespace
#undef ArithProgression
extern "C" __global__ __vector__ void fsa_lru_abi_map(
    GM_ADDR req, GM_ADDR last, GM_ADDR banks, GM_ADDR map,
    uint32_t rows, uint32_t physicalRows, uint32_t pageRows) {
    MapStableRows(req,last,banks,map,rows,physicalRows,pageRows);
}
extern "C" __global__ __vector__ void fsa_lru_abi_plan(
    GM_ADDR topk, GM_ADDR stable, GM_ADDR visible, GM_ADDR state, GM_ADDR map, GM_ADDR payload,
    uint32_t rows,uint32_t physicalRows,uint32_t topkWidth,uint32_t capacity,
    uint32_t paddedTopk,uint32_t tileWidth,uint32_t workWords,
    uint32_t lookupMaskWords,int32_t maxToken) {
    for(uint32_t row=GetBlockIdx();row<rows;row+=GetBlockNum())
        PlanRow(topk,stable,visible,state,map,payload,row,rows,physicalRows,topkWidth,capacity,
                paddedTopk,tileWidth,workWords,lookupMaskWords,maxToken,row+GetBlockNum()<rows);
}
extern "C" __global__ __vector__ void fsa_lru_abi_publish(
    GM_ADDR payload,GM_ADDR membership,GM_ADDR metadata,uint32_t rows,uint32_t topk) {
    for(uint32_t row=GetBlockIdx();row<rows;row+=GetBlockNum())
        PublishRows(payload,membership,metadata,row,rows,topk,row+GetBlockNum()<rows);
}
extern "C" __attribute__((visibility("default"))) int fsa_lru_plan_async_v5(
    void* req,void* topk,void* stable,void* visible,void* last,void* banks,
    void* state,void* mapping,void* payload,uint32_t rows,uint32_t physicalRows,
    uint32_t vectorCores,uint32_t pageRows,uint32_t topkWidth,uint32_t capacity,
    uint32_t ubBytes,int32_t maxToken,aclrtStream stream) {
    if(!req||!topk||!stable||!visible||!last||!banks||!state||!mapping||!payload||
       rows==0||rows>physicalRows||physicalRows>32768||!vectorCores||
       !pageRows||pageRows%8||uint64_t(pageRows)*36>ubBytes||
       !topkWidth||topkWidth>2048||capacity<topkWidth||capacity>32767||maxToken<=0)
        return ACL_ERROR_INVALID_PARAM;
    const FsaLruGeometry geometry(topkWidth,capacity,ubBytes);
    if(geometry.workWords*4>ubBytes) return ACL_ERROR_INVALID_PARAM;
    const uint32_t blocks=rows<vectorCores?rows:vectorCores;
    // A previous failure is sticky on this thread. Return it before mutating planner state.
    aclError status = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    if (status != ACL_SUCCESS) return status;
    fsa_lru_abi_map<<<1,0,stream>>>(static_cast<uint8_t*>(req),static_cast<uint8_t*>(last),
        static_cast<uint8_t*>(banks),static_cast<uint8_t*>(mapping),rows,physicalRows,pageRows);
    status = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    if (status != ACL_SUCCESS) return status;
    fsa_lru_abi_plan<<<blocks,0,stream>>>(static_cast<uint8_t*>(topk),static_cast<uint8_t*>(stable),
        static_cast<uint8_t*>(visible),static_cast<uint8_t*>(state),static_cast<uint8_t*>(mapping),
        static_cast<uint8_t*>(payload),rows,physicalRows,topkWidth,capacity,
        geometry.topkWidth,geometry.tile,geometry.workWords,geometry.lookupMaskWords,maxToken);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
extern "C" __attribute__((visibility("default"))) int fsa_lru_publish_async_v4(
    void* payload,void* membership,void* metadata,uint32_t rows,uint32_t vectorCores,
    uint32_t topk,aclrtStream stream) {
    if(!payload||!membership||!metadata||!rows||rows>32768||!vectorCores||!topk||topk>2048)
        return ACL_ERROR_INVALID_PARAM;
    const uint32_t blocks=rows<vectorCores?rows:vectorCores;
    const aclError status = aclrtGetLastError(ACL_RT_THREAD_LEVEL);
    if (status != ACL_SUCCESS) return status;
    fsa_lru_abi_publish<<<blocks,0,stream>>>(static_cast<uint8_t*>(payload),
        static_cast<uint8_t*>(membership),static_cast<uint8_t*>(metadata),rows,topk);
    return aclrtGetLastError(ACL_RT_THREAD_LEVEL);
}
