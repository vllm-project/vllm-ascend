        auto AIC_NUM = ascendcPlatform.GetCoreNumAic();
        auto AIV_NUM = ascendcPlatform.GetCoreNumAiv();
        qwen3_4b_14b_910b_dbf_kernel<<<AIC_NUM, nullptr, stream>>>(
                    num_reqs_0, num_tokens_0, num_tokens_1, 
                    (GM_ADDR)weights_params.data_ptr(), layer_num, (GM_ADDR)cos_sin_cache.data_ptr(), 
                    hidden_dim, q_size, gate_up_dim, (float)scaling, kv_block_stride, 
                    (GM_ADDR)positions.data_ptr(), (GM_ADDR)slot_mapping.data_ptr(),
                    (GM_ADDR)tasks_0.data_ptr(), tasks_0.size(1), (GM_ADDR)cu_q_lens_0.data_ptr(), 
                    (GM_ADDR)tasks_1.data_ptr(), tasks_1.size(1), (GM_ADDR)cu_q_lens_1.data_ptr(), 
                    (GM_ADDR)kv_lens.data_ptr(), (GM_ADDR)block_table.data_ptr(), block_table.size(1), 
                    (GM_ADDR)mask.data_ptr(), (GM_ADDR)fa_ws.data_ptr(), 
                    (GM_ADDR)hidden_states.data_ptr(), (GM_ADDR)residual.data_ptr(), 
                    (GM_ADDR)qkv.data_ptr(), (GM_ADDR)q.data_ptr(), 
                    (GM_ADDR)gate_up.data_ptr(), (GM_ADDR)silu.data_ptr(), AIC_NUM, AIV_NUM);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("qwen3_4b_14b_910b_dbf_npu", acl_call);
    return 0;
