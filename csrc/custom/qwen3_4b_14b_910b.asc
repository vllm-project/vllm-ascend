                           const torch::Tensor &weights_params, const int64_t layer_num, const torch::Tensor &cos_sin_cache, 
                           const int64_t hidden_dim, const int64_t q_size, const int64_t gate_up_dim, const double scaling, const int64_t kv_block_stride, 
                           const torch::Tensor &positions, const torch::Tensor &slot_mapping, 
                           const torch::Tensor &tasks_0, const torch::Tensor &cu_q_lens_0, 
