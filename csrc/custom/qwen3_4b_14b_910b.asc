#include <ATen/Operators.h>
#include <torch/all.h>
#include <torch/library.h>
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "torch_npu/csrc/framework/OpCommand.h"
#include "kernel_operator.h"
#include "platform/platform_ascendc.h"
#include <type_traits>

namespace ascend_ops {
namespace qwen3_4b_14b_910b {

constexpr int HEAD_DIM = 128;
constexpr int BLOCK_SIZE = 128;
constexpr int KV_HEADS = 8;
constexpr int KV_SIZE = KV_HEADS * HEAD_DIM;
constexpr float NEG_INF = -1e30f;
constexpr float EPSILON = 1e-6f;

constexpr uint16_t PAIR_V2A = 4;  // AIV producer -> its AIC
constexpr uint16_t PAIR_A2V = 5;  // AIC producer -> its two AIVs
constexpr uint16_t ALL_AIC  = 6;  // all AIC rendezvous
constexpr uint16_t ALL_AIV  = 7;  // all AIV rendezvous

// ========================= common ========================= 

// AscendC::CrossCoreSetFlag<0x2, PIPE_MTE3>(PAIR_V2A);
__aicore__ void wait_all_aiv() { // aic wait aiv
    AscendC::CrossCoreWaitFlag<0x2>(PAIR_V2A);
    AscendC::CrossCoreSetFlag<0x0, PIPE_MTE2>(ALL_AIC);
    AscendC::CrossCoreWaitFlag<0x0>(ALL_AIC);
}

// AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(PAIR_A2V);
__aicore__ void wait_all_aic() { // aiv wait aic
    AscendC::CrossCoreWaitFlag<0x2>(PAIR_A2V);
    AscendC::CrossCoreSetFlag<0x0, PIPE_MTE3>(ALL_AIV);
    AscendC::CrossCoreWaitFlag<0x0>(ALL_AIV);
}

__aicore__ int ceil(const int base, const int num) {
    return (num + base - 1) / base * base;
}

__aicore__ int min(const int a, const int b) {
    return likely(a <= b) ? a : b;
}

__aicore__ void matmul_aic(GM_ADDR aGm, GM_ADDR bGm, GM_ADDR cGm, 
                           const int m, const int k, const int n, 
                           const int blockIdx, const int AIC_NUM)
{
    const int baseM = 256;
    const int baseN = 128;
    const int baseK = 64;
    const int stepKa = 4;
    const int kL1a = stepKa * baseK;
    const int stepKb = 8;
    const int kL1b = stepKb * baseK;
    const int l1BOffset[2] = {0, kL1b * baseN};
    const int mTileNum = (m + baseM - 1) / baseM;
    const int tailM = m - (mTileNum - 1) * baseM;
    const int tailM16 = ceil(16, tailM);
    const int nTileNum = n / baseN;
    const int tileNum = mTileNum * nTileNum;
    const int kL1bTileNum = k / kL1b;

    AscendC::GlobalTensor<bfloat16_t> aGlobal, bGlobal, cGlobal;
    aGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(aGm));
    bGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(bGm));
    cGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(cGm));
    cGlobal.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);

    AscendC::LocalTensor<bfloat16_t> l1ALocal0(AscendC::TPosition::A1, 0, baseM*kL1a);
    AscendC::LocalTensor<bfloat16_t> l1ALocal1(AscendC::TPosition::A1, baseM*kL1a*2, baseM*kL1a);
    AscendC::LocalTensor<bfloat16_t> l1BLocal(AscendC::TPosition::B1, baseM*kL1a*4, kL1b*baseN*2);
    AscendC::LocalTensor<bfloat16_t> l0ALocal0(AscendC::TPosition::A2, 0, baseM*baseK);
    AscendC::LocalTensor<bfloat16_t> l0ALocal1(AscendC::TPosition::A2, baseM*baseK*2, baseM*baseK);
    AscendC::LocalTensor<bfloat16_t> l0BLocal0(AscendC::TPosition::B2, 0, baseK*baseN*2);
    AscendC::LocalTensor<bfloat16_t> l0BLocal1(AscendC::TPosition::B2, baseK*baseN*4, baseK*baseN*2);
    AscendC::LocalTensor<float> l0CLocal(AscendC::TPosition::CO1, 0, baseM * baseN);

    int l1PingPong = 0;
    // GM -> L1
    AscendC::Nd2NzParams aNd2nzParams[2]{{1, (uint16_t)baseM, (uint16_t)kL1a, 0, (uint16_t)k, (uint16_t)baseM, 1, 0},
                                         {1, (uint16_t)tailM, (uint16_t)kL1a, 0, (uint16_t)k, (uint16_t)tailM16, 1, 0}};
    AscendC::DataCopyParams bDataCopyParams{(uint16_t)(baseN / 16), (uint16_t)(kL1b), (uint16_t)(k - kL1b), 0};
    // L1 -> L0
    // l1W * channelSize -> mExtension * kExtension
    AscendC::LoadData3DParamsV2<bfloat16_t> aLoad3DParams[2];
    aLoad3DParams[0].l1H = aLoad3DParams[1].l1H = 1;
    aLoad3DParams[0].l1W = aLoad3DParams[0].mExtension = baseM;
    aLoad3DParams[1].l1W = aLoad3DParams[1].mExtension = tailM16;
    aLoad3DParams[0].channelSize = aLoad3DParams[1].channelSize = baseK;
    aLoad3DParams[0].kExtension = aLoad3DParams[1].kExtension = baseK;
    
    AscendC::LoadData3DParamsV2<bfloat16_t> bLoad3DParams;
    bLoad3DParams.l1H = 1;
    bLoad3DParams.l1W = kL1b;
    bLoad3DParams.mExtension = baseK * 2;
    bLoad3DParams.channelSize = bLoad3DParams.kExtension = baseN;
    // mmad
    AscendC::MmadParams initMmParams[2]{{baseM, baseN, baseK, 0, false, true},
                                     {(uint16_t)tailM16, baseN, baseK, 0, false, true}};
    AscendC::MmadParams addMmParams[2]{{baseM, baseN, baseK, 0, false, false},
                                    {(uint16_t)tailM16, baseN, baseK, 0, false, false}};
    AscendC::MmadParams lastMmParams[2]{{baseM, baseN, baseK, 3, false, false},
                                     {(uint16_t)tailM16, baseN, baseK, 3, false, false}};
    // L0C -> GM
    AscendC::FixpipeParamsV220 fixpipeParams[2];
    fixpipeParams[0].nSize = baseN;
    fixpipeParams[0].mSize = baseM;
    fixpipeParams[0].srcStride = baseM;
    fixpipeParams[0].dstStride = n;
    fixpipeParams[0].quantPre = QuantMode_t::F322BF16;
    fixpipeParams[0].ndNum = 1;
    fixpipeParams[0].srcNdStride = 0;
    fixpipeParams[0].dstNdStride = 0;
    fixpipeParams[0].unitFlag = 3;

    fixpipeParams[1].nSize = baseN;
    fixpipeParams[1].mSize = tailM;
    fixpipeParams[1].srcStride = tailM16;
    fixpipeParams[1].dstStride = n;
    fixpipeParams[1].quantPre = QuantMode_t::F322BF16;
    fixpipeParams[1].ndNum = 1;
    fixpipeParams[1].srcNdStride = 0;
    fixpipeParams[1].dstNdStride = 0;
    fixpipeParams[1].unitFlag = 3;

    wait_all_aiv();

    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(0);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(1);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(2);
    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(3);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(0);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(1);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(2);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(3);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(0);

    // SWAT
    int mainWindow = min(AIC_NUM / 4, mTileNum);
    int mainRow = mTileNum / mainWindow - 1;
    int tailWindow = mTileNum - mainRow * mainWindow;
    for (int tileIdx = blockIdx; tileIdx < tileNum; tileIdx += AIC_NUM) {
        int mTileIdx, nTileIdx;
        auto rowIdx = tileIdx / nTileNum / mainWindow;
        if (rowIdx < mainRow) {
            mTileIdx = rowIdx * mainWindow + tileIdx % mainWindow;
            nTileIdx = (tileIdx / mainWindow) % nTileNum;
        } else {
            rowIdx = mainRow;
            auto tailIndex = tileIdx - mainRow * mainWindow * nTileNum;
            mTileIdx = mainRow * mainWindow + tailIndex % tailWindow;
            nTileIdx = (tailIndex / tailWindow) % nTileNum;
        }
        if (rowIdx % 2 != 0) {
            nTileIdx = nTileNum - 1 - nTileIdx;
        }
        int tailRow = mTileIdx == mTileNum - 1;

        AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(0);
        for (int ikb1 = 0; ikb1 < kL1bTileNum; ++ikb1) {
            // GM -> L1
            int l1Bslot = l1PingPong & 1;
            int offset_k = ikb1 * kL1b;
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1Bslot);
            AscendC::DataCopy(l1BLocal[l1BOffset[l1Bslot]],
                bGlobal[k*nTileIdx*baseN + offset_k*16],
                bDataCopyParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1Bslot);
            {
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(2);
                AscendC::DataCopy(l1ALocal0, aGlobal[mTileIdx*baseM*k + offset_k], aNd2nzParams[tailRow]);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(2);
                {
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1Bslot);
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(0);
                    AscendC::LoadData(l0BLocal0, l1BLocal[l1BOffset[l1Bslot]], bLoad3DParams);
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(0);
                    {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(2);
                        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(2);
                        AscendC::LoadData(l0ALocal0, l1ALocal0, aLoad3DParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(2);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(0);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(2);
                        AscendC::Mmad(l0CLocal, l0ALocal0, l0BLocal0, ikb1 == 0 ? initMmParams[tailRow] : addMmParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(2);

                        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(3);
                        AscendC::LoadData(l0ALocal1, l1ALocal0[aNd2nzParams[tailRow].dstNzC0Stride*baseK], aLoad3DParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(3);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(3);
                        AscendC::Mmad(l0CLocal, l0ALocal1, l0BLocal0[baseK*baseN], addMmParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(3);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(0);

                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(1);
                    AscendC::LoadData(l0BLocal1, l1BLocal[l1BOffset[l1Bslot] + 2*baseK*16], bLoad3DParams);
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(1);
                    {
                        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(2);
                        AscendC::LoadData(l0ALocal0, l1ALocal0[aNd2nzParams[tailRow].dstNzC0Stride*2*baseK], aLoad3DParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(2);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(1);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(2);
                        AscendC::Mmad(l0CLocal, l0ALocal0, l0BLocal1, addMmParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(2);

                        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(3);
                        AscendC::LoadData(l0ALocal1, l1ALocal0[aNd2nzParams[tailRow].dstNzC0Stride*3*baseK], aLoad3DParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(3);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(3);
                        AscendC::Mmad(l0CLocal, l0ALocal1, l0BLocal1[baseK*baseN], addMmParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(3);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(1);
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(2);

                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(3);
                AscendC::DataCopy(l1ALocal1, aGlobal[mTileIdx*baseM*k + offset_k + kL1a], aNd2nzParams[tailRow]);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(3);
                {
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(0);
                    AscendC::LoadData(l0BLocal0, l1BLocal[l1BOffset[l1Bslot] + 4*baseK*16], bLoad3DParams);
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(0);
                    {
                        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(3);
                        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(2);
                        AscendC::LoadData(l0ALocal0, l1ALocal1, aLoad3DParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(2);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(0);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(2);
                        AscendC::Mmad(l0CLocal, l0ALocal0, l0BLocal0, addMmParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(2);

                        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(3);
                        AscendC::LoadData(l0ALocal1, l1ALocal1[aNd2nzParams[tailRow].dstNzC0Stride*baseK], aLoad3DParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(3);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(3);
                        AscendC::Mmad(l0CLocal, l0ALocal1, l0BLocal0[baseK*baseN], addMmParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(3);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(0);

                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(1);
                    AscendC::LoadData(l0BLocal1, l1BLocal[l1BOffset[l1Bslot] + 6*baseK*16], bLoad3DParams);
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(1);
                    {
                        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(2);
                        AscendC::LoadData(l0ALocal0, l1ALocal1[aNd2nzParams[tailRow].dstNzC0Stride*2*baseK], aLoad3DParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(2);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(1);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(2);
                        AscendC::Mmad(l0CLocal, l0ALocal0, l0BLocal1, addMmParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(2);

                        AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(3);
                        AscendC::LoadData(l0ALocal1, l1ALocal1[aNd2nzParams[tailRow].dstNzC0Stride*3*baseK], aLoad3DParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(3);
                        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(3);
                        AscendC::Mmad(l0CLocal, l0ALocal1, l0BLocal1[baseK*baseN], ikb1+1 == kL1bTileNum ? lastMmParams[tailRow] : addMmParams[tailRow]);
                        AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(3);
                    }
                    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(1);

                }
                AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(3);
            }
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1Bslot);
            l1PingPong++;
        }
        AscendC::Fixpipe(cGlobal[mTileIdx*baseM*n + nTileIdx*baseN], l0CLocal, fixpipeParams[tailRow]);
        AscendC::SetFlag<AscendC::HardEvent::FIX_M>(0);
    }

    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(2);
    AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(3);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(0);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(1);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(2);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(3);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(0);

    AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(PAIR_A2V);
}

__aicore__ void swi_glu_aiv(GM_ADDR xGm, GM_ADDR yGm, const int n, const int d, 
                            const int blockIdx, const int AIV_NUM)
{
    AscendC::PipeBarrier<PIPE_ALL>();

    AscendC::GlobalTensor<bfloat16_t> xGlobal, yGlobal;
    xGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(xGm));
    yGlobal.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(yGm));
    xGlobal.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    yGlobal.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);

    const int MAXD = 10752;
    int64_t ubPtr = 0;
    AscendC::LocalTensor<bfloat16_t> xF16Locals(AscendC::TPosition::VECCALC, ubPtr, MAXD * 4); ubPtr += MAXD * 8;
    AscendC::LocalTensor<float> xF32Local(AscendC::TPosition::VECCALC, ubPtr, MAXD); ubPtr += MAXD * 4;
    AscendC::LocalTensor<float> siluLocal(AscendC::TPosition::VECCALC, ubPtr, MAXD); ubPtr += MAXD * 4;
    AscendC::LocalTensor<bfloat16_t> yLocal(AscendC::TPosition::VECCALC, ubPtr, MAXD); ubPtr += MAXD * 2;


    auto silu_calc_save = [&](const AscendC::LocalTensor<bfloat16_t> &xF16Local,
                    const int count, const int slot, const int yDst) __aicore__ {
        // bf16 -> f32
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(slot);
        AscendC::Cast(xF32Local, xF16Local, AscendC::RoundMode::CAST_NONE, count);
        AscendC::PipeBarrier<PIPE_V>();
        // -gate
        AscendC::Muls(siluLocal, xF32Local, -1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        // exp(-gate)
        AscendC::Exp(siluLocal, siluLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        // exp(-gate)+1
        AscendC::Adds(siluLocal, siluLocal, 1.0f, count);
        AscendC::PipeBarrier<PIPE_V>();
        // silu(gate) = gate / (exp(-gate)+1)
        AscendC::Div(siluLocal, xF32Local, siluLocal, count);
        AscendC::PipeBarrier<PIPE_V>();
        // silu(gate) * up
        AscendC::Cast(xF32Local, xF16Local[count], AscendC::RoundMode::CAST_NONE, count);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(slot);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(siluLocal, siluLocal, xF32Local, count);
        AscendC::PipeBarrier<PIPE_V>();
        // f32 -> bf16
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
        AscendC::Cast(yLocal, siluLocal, AscendC::RoundMode::CAST_RINT, count);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        // UB -> GM
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::DataCopy(yGlobal[yDst], yLocal, count);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
    };

    wait_all_aic();

    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(1);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
    if (d <= MAXD) {
        int D = d * 2;
        int pingpong = 0;
        for (int row = blockIdx; row < n; row += AIV_NUM) {
            int slot  = pingpong++ & 1;
            auto xF16Local = xF16Locals[slot * D];
            // GM -> UB
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(slot);
            AscendC::DataCopy(xF16Local, xGlobal[row * D], D);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(slot);
            silu_calc_save(xF16Local, d, slot, row * d);
        }
    } else {
        int dd = d / 2;
        AscendC::DataCopyParams dataCopyParams{2, (uint16_t)(dd / 16), (uint16_t)(dd / 16), 0};
        for (int row = blockIdx; row < n; row += AIV_NUM) {
            int x_offset = row * d * 2;
            auto xF16Local0 = xF16Locals;
            auto xF16Local1 = xF16Locals[d];
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
            AscendC::DataCopy(xF16Local0, xGlobal[x_offset], dataCopyParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(1);
            AscendC::DataCopy(xF16Local1, xGlobal[x_offset + dd], dataCopyParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(1);
            silu_calc_save(xF16Local0, dd, 0, row * d);
            silu_calc_save(xF16Local1, dd, 1, row * d + dd);
        }
    }
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);

    AscendC::CrossCoreSetFlag<0x2, PIPE_MTE3>(PAIR_V2A);
}

__aicore__ void add_rms_norm_aiv(GM_ADDR x1Gm, GM_ADDR x2Gm, GM_ADDR gammaGm, const int n, const int d, 
                                const int blockIdx, const int AIV_NUM)
{
    AscendC::PipeBarrier<PIPE_ALL>();

    // copy gamma
    int64_t ubPtr = 0;
    AscendC::GlobalTensor<float> gammaGlobal;
    gammaGlobal.SetGlobalBuffer((__gm__ float*)gammaGm, d);
    AscendC::LocalTensor<float> gammaLocal (AscendC::TPosition::VECCALC, ubPtr, d); ubPtr += d * 4;
    AscendC::DataCopy(gammaLocal, gammaGlobal, d);
    AscendC::PipeBarrier<PIPE_MTE2>();

    AscendC::GlobalTensor<bfloat16_t> x1Global, x2Global;
    x1Global.SetGlobalBuffer((__gm__ bfloat16_t*)x1Gm);
    x2Global.SetGlobalBuffer((__gm__ bfloat16_t*)x2Gm);
    x1Global.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    x2Global.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    // merge模式
    int mergeD = 10240;
    int mergeN = mergeD / d;
    int n_ = (n + mergeN - 1) / mergeN;
    AscendC::LocalTensor<float> xfp32Local(AscendC::TPosition::VECCALC, ubPtr, mergeD); ubPtr += mergeD * 4;
    AscendC::LocalTensor<float> sqx32Local(AscendC::TPosition::VECCALC, ubPtr, mergeD); ubPtr += mergeD * 4;
    AscendC::LocalTensor<bfloat16_t> x1Local(AscendC::TPosition::VECCALC, ubPtr, mergeD); ubPtr += mergeD * 2;
    AscendC::LocalTensor<bfloat16_t> x2Local(AscendC::TPosition::VECCALC, ubPtr, mergeD); ubPtr += mergeD * 2;
    AscendC::LocalTensor<bfloat16_t> outLocal(AscendC::TPosition::VECCALC, ubPtr, mergeD); ubPtr += mergeD * 2;
    AscendC::LocalTensor<float> reduceLocal(AscendC::TPosition::VECCALC, ubPtr, mergeN * 64); ubPtr += mergeN * 256;
    int rstdByteSize = (mergeN * 4 + 31) / 32 * 32;  // 对齐到32字节
    AscendC::LocalTensor<float> rstdLocal(AscendC::TPosition::VECCALC, ubPtr, mergeN); ubPtr += rstdByteSize;
    AscendC::LocalTensor<float> onesLocal(AscendC::TPosition::VECCALC, ubPtr, mergeN); ubPtr += mergeN * 4;
    AscendC::Duplicate(onesLocal, 1.0f, mergeN);
    AscendC::PipeBarrier<PIPE_V>();

    float avgFactor = 1.0f / (float)d;
    // reduce
    int mask = 64;
    int reduceTimes = d / mask;
    AscendC::BinaryRepeatParams reduceSumParams{1, 1, 1, 0, 8, 0};

    wait_all_aic();

    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(1);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
    for (int nrow = blockIdx; nrow < n_; nrow += AIV_NUM) {
        int offset = mergeD * nrow;
        if (nrow == n_ - 1) {
            mergeN = n - nrow * mergeN;
            mergeD = mergeN * d;
        }
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
        AscendC::DataCopy(x1Local, x1Global[offset], mergeD);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(1);
        AscendC::DataCopy(x2Local, x2Global[offset], mergeD);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(1);

        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);
        AscendC::Cast(xfp32Local, x1Local, AscendC::RoundMode::CAST_NONE, mergeD);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(1);
        AscendC::Cast(sqx32Local, x2Local, AscendC::RoundMode::CAST_NONE, mergeD);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(1);
        AscendC::PipeBarrier<PIPE_V>();
        // x = x1 + x2
        AscendC::Add(xfp32Local, xfp32Local, sqx32Local, mergeD);
        AscendC::PipeBarrier<PIPE_V>();
        // x fp32 -> bf16, write to x2
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
        AscendC::Cast(outLocal, xfp32Local, AscendC::RoundMode::CAST_RINT, mergeD);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::DataCopy(x2Global[offset], outLocal, mergeD);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
        // x^2
        AscendC::Mul(sqx32Local, xfp32Local, xfp32Local, mergeD);
        AscendC::PipeBarrier<PIPE_V>();
        // ---- reduce sum: d elements per row → 64 partial sums ----
        AscendC::Duplicate(reduceLocal, 0.0f, mergeN * 64);
        AscendC::PipeBarrier<PIPE_V>();
        for (int r = 0; r < mergeN; r++) {
            AscendC::Add(reduceLocal[r * 64], sqx32Local[r * d], reduceLocal[r * 64],
                         mask, reduceTimes, reduceSumParams);
        }
        AscendC::PipeBarrier<PIPE_V>();
        WholeReduceSum<float, false>(rstdLocal, reduceLocal, 64, mergeN, 1, 1, 8);
        AscendC::PipeBarrier<PIPE_V>();
        // sum / d
        AscendC::Muls(rstdLocal, rstdLocal, avgFactor, mergeN);
        AscendC::PipeBarrier<PIPE_V>();
        // rstd = 1 / sqrt(sum + ε)
        AscendC::Adds(rstdLocal, rstdLocal, EPSILON, mergeN);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sqrt(rstdLocal, rstdLocal, mergeN);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(rstdLocal, onesLocal, rstdLocal, mergeN);
        AscendC::PipeBarrier<PIPE_V>();
        // ---- xfp32Local *= rstd
        AscendC::SetFlag<AscendC::HardEvent::V_S>(0);
        AscendC::WaitFlag<AscendC::HardEvent::V_S>(0);
        for (int r = 0; r < mergeN; r++) {
            float rstdVal = rstdLocal.GetValue(r);
            AscendC::Muls(xfp32Local[r * d], xfp32Local[r * d], rstdVal, d);
        }
        AscendC::PipeBarrier<PIPE_V>();
        // ---- xfp32Local *= gamma, 逐行Mul (mergeN条) ----
        for (int r = 0; r < mergeN; r++) {
            AscendC::Mul(xfp32Local[r * d], xfp32Local[r * d], gammaLocal, d);
        }
        AscendC::PipeBarrier<PIPE_V>();
        // x fp32 -> bf16, write to x1 (rms result)
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
        AscendC::Cast(outLocal, xfp32Local, AscendC::RoundMode::CAST_RINT, mergeD);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::DataCopy(x1Global[offset], outLocal, mergeD);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
    }
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);

    AscendC::CrossCoreSetFlag<0x2, PIPE_MTE3>(PAIR_V2A);
}

__aicore__ void split_qkv_rmsnorm_mrope_kv_cache_aiv(
                            GM_ADDR qkv_addr, GM_ADDR q_addr, const int n, const int q_size, 
                            GM_ADDR q_gamma_addr, GM_ADDR k_gamma_addr,
                            GM_ADDR cos_sin_cache_addr, GM_ADDR position_addr, GM_ADDR slot_mapping_addr,
                            GM_ADDR key_cache_addr, GM_ADDR value_cache_addr, const int64_t kv_block_stride, 
                            const int blockIdx, const int AIV_NUM)
{
    AscendC::PipeBarrier<PIPE_ALL>();

    // copy gamma
    int64_t ubPtr = 0;
    AscendC::LocalTensor<float> q_gamma(AscendC::TPosition::VECCALC, ubPtr, HEAD_DIM); ubPtr += HEAD_DIM * 4; // 512
    AscendC::LocalTensor<float> k_gamma(AscendC::TPosition::VECCALC, ubPtr, HEAD_DIM); ubPtr += HEAD_DIM * 4; // 512
    AscendC::GlobalTensor<float> q_gamma_global, k_gamma_global;
    q_gamma_global.SetGlobalBuffer((__gm__ float*)q_gamma_addr);
    k_gamma_global.SetGlobalBuffer((__gm__ float*)k_gamma_addr);
    AscendC::DataCopy(q_gamma, q_gamma_global, HEAD_DIM);
    AscendC::DataCopy(k_gamma, k_gamma_global, HEAD_DIM);
    AscendC::PipeBarrier<PIPE_MTE2>();

    AscendC::GlobalTensor<bfloat16_t> qkv, q, cos_sin_cache, key_cache, value_cache;
    AscendC::GlobalTensor<int32_t> position, slot_mapping;
    qkv.SetGlobalBuffer((__gm__ bfloat16_t*)qkv_addr);
    q.SetGlobalBuffer((__gm__ bfloat16_t*)q_addr);
    cos_sin_cache.SetGlobalBuffer((__gm__ bfloat16_t*)cos_sin_cache_addr);
    position.SetGlobalBuffer((__gm__ int32_t*)position_addr);
    slot_mapping.SetGlobalBuffer((__gm__ int32_t*)slot_mapping_addr);
    key_cache.SetGlobalBuffer((__gm__ bfloat16_t*)key_cache_addr);
    value_cache.SetGlobalBuffer((__gm__ bfloat16_t*)value_cache_addr);
    qkv.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    q.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    cos_sin_cache.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    key_cache.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    value_cache.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);

    const float avgFactor = 1.0f / (float)HEAD_DIM;
    const int qkv_dim = q_size + KV_SIZE * 2;
    const int qk_dim = q_size + KV_SIZE;
    const int q_heads = q_size / HEAD_DIM;
    const int k_heads = KV_SIZE / HEAD_DIM;
    // KV cache 的 block 步长由 framework 决定：MRV1 为 dense(==BLOCK_SIZE*KV_SIZE)，
    // MRV2 为页式合并(K/V 同页交错，通常 2 倍，还可能带对齐 padding)。跨 block 寻址必须
    // 用运行期 stride；页内 offset(token/head)仍是 dense，所以只需这一个标量。
    auto kvSlotOffset = [&](const int s) __aicore__ {
        return (int64_t)(s / BLOCK_SIZE) * kv_block_stride + (int64_t)(s % BLOCK_SIZE) * KV_SIZE;
    };
    int mergeD = qk_dim * 2;
    int mergeN = mergeD / HEAD_DIM;
    AscendC::LocalTensor<bfloat16_t> xfp16(AscendC::TPosition::VECCALC, ubPtr, qkv_dim * 2); ubPtr += qkv_dim * 4; // mergeD * 2 + KV_SIZE * 4
    AscendC::LocalTensor<float> xfp32(AscendC::TPosition::VECCALC, ubPtr, mergeD); ubPtr += mergeD * 4;
    AscendC::LocalTensor<float> sqx(AscendC::TPosition::VECCALC, ubPtr, mergeD); ubPtr += mergeD * 4;
    AscendC::LocalTensor<float> reduce(AscendC::TPosition::VECCALC, ubPtr, mergeN * 64); ubPtr += mergeN * 256; // mergeD * 2
    AscendC::LocalTensor<float> rstd(AscendC::TPosition::VECCALC, ubPtr, mergeN); ubPtr += mergeN * 4;
    AscendC::LocalTensor<float> ones(AscendC::TPosition::VECCALC, ubPtr, mergeN); ubPtr += mergeN * 4;
    AscendC::Duplicate(ones, 1.0f, mergeN);
    AscendC::PipeBarrier<PIPE_V>();
    AscendC::LocalTensor<int32_t> pos(AscendC::TPosition::VECCALC, ubPtr, 2048); ubPtr += 2048 * 4;
    AscendC::LocalTensor<int32_t> slot(AscendC::TPosition::VECCALC, ubPtr, 2048); ubPtr += 2048 * 4;
    AscendC::LocalTensor<bfloat16_t> cos_sin_double(AscendC::TPosition::VECCALC, ubPtr, HEAD_DIM * 2); ubPtr += HEAD_DIM * 4; // 512
    AscendC::LocalTensor<float> cos_sin_fp32(AscendC::TPosition::VECCALC, ubPtr, 128); ubPtr += 512;
    AscendC::LocalTensor<bfloat16_t> out(AscendC::TPosition::VECCALC, ubPtr, mergeD); ubPtr += mergeD * 2;

    AscendC::DataCopyParams qDataCopyParams[2]{{2, (uint16_t)(q_size/16), (uint16_t)(KV_SIZE/16), 0},
                                            {1, (uint16_t)(q_size/16), 0, 0}};
    AscendC::DataCopyParams kDataCopyParams[2]{{2, (uint16_t)(KV_SIZE/16), (uint16_t)(q_size/16), 0},
                                            {1, (uint16_t)(KV_SIZE/16), 0, 0}};
    AscendC::DataCopyParams vDataCopyParams[2]{{2, (uint16_t)(KV_SIZE/16), (uint16_t)(qk_dim/16), 0},
                                            {1, (uint16_t)(KV_SIZE/16), 0, 0}};

    AscendC::BinaryRepeatParams reduceSumParams{1, 1, 1, 8, HEAD_DIM / 8, 8};
    AscendC::BinaryRepeatParams xMulrstdParams{1, 1, 0, HEAD_DIM / 8, HEAD_DIM / 8, 1};
    AscendC::BinaryRepeatParams xMulgammaParams{1, 1, 1, HEAD_DIM / 8, HEAD_DIM / 8, 0};

    wait_all_aic();

    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(1);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(0);
    // 一次处理两行
    int n_ = (n + 1) / 2;
    int cache_pos = 0;
    for (int batch = blockIdx; batch < n_; batch += AIV_NUM) {
        int pos1, pos2, slot1, slot2;
        bool single_line = batch == n_ - 1 && (n & 1) == 1;
        int offset = batch * 2;
        // qkv: GM -> UB
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0); // q, k
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(0); // v
        AscendC::DataCopy(xfp16, qkv[offset * qkv_dim], qkv_dim * (2 - single_line));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(0);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(0);
        // all wait
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(0);
        // cast q and k
        AscendC::Cast(xfp32, xfp16, AscendC::RoundMode::CAST_NONE, qk_dim);
        // save value_cache
        if (offset >= cache_pos) {
            int begin = offset / 2048 * 2048;
            int new_cache_pos = begin + 2048;
            if (unlikely(new_cache_pos > n)) {
                new_cache_pos = n;
                AscendC::DataCopyExtParams positionDataCopyParams{1, (uint32_t)(n - begin) * 4, 0, 0, 0};
                AscendC::DataCopyPadExtParams<int32_t> padParams{false, 0, 0, 0};
                AscendC::DataCopyPad(pos, position[begin], positionDataCopyParams, padParams);
                AscendC::DataCopyPad(slot, slot_mapping[begin], positionDataCopyParams, padParams);
            } else {
                AscendC::DataCopy(pos, position[begin], 2048);
                AscendC::DataCopy(slot, slot_mapping[begin], 2048);
            }
            AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(0);
            cache_pos = new_cache_pos;
        }
        int posi = offset & 2047;
        slot1 = slot.GetValue(posi);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(0);
        AscendC::DataCopy(value_cache[kvSlotOffset(slot1)], xfp16[qk_dim], KV_SIZE);
        // cos_sin: GM -> UB
        pos1 = pos.GetValue(posi);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(1);
        AscendC::DataCopy(cos_sin_double, cos_sin_cache[pos1 * HEAD_DIM], HEAD_DIM);
        if (unlikely(single_line)) {
            mergeD /= 2;
            mergeN /= 2;
        } else {
            AscendC::Cast(xfp32[qk_dim], xfp16[qkv_dim], AscendC::RoundMode::CAST_NONE, qk_dim);
            slot2 = slot.GetValue(posi + 1);
            AscendC::DataCopy(value_cache[kvSlotOffset(slot2)], xfp16[qkv_dim + qk_dim], KV_SIZE);
            pos2 = pos.GetValue(posi + 1);
            AscendC::DataCopy(cos_sin_double[HEAD_DIM], cos_sin_cache[pos2 * HEAD_DIM], HEAD_DIM);
        }
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(1);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(0);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(0);
        AscendC::PipeBarrier<PIPE_V>();
        // x^2
        AscendC::Mul(sqx, xfp32, xfp32, mergeD);
        AscendC::PipeBarrier<PIPE_V>();
        // reduce sum
        AscendC::Duplicate(reduce, 0.0f, mergeN * 64);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(reduce, sqx, reduce, 64, mergeN, reduceSumParams);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(reduce, sqx[64], reduce, 64, mergeN, reduceSumParams);
        AscendC::PipeBarrier<PIPE_V>();
        WholeReduceSum<float, false>(rstd, reduce, 64, mergeN, 1, 1, 8);
        AscendC::PipeBarrier<PIPE_V>();
        // sum / d
        AscendC::Muls(rstd, rstd, avgFactor, mergeN);
        AscendC::PipeBarrier<PIPE_V>();
        // rstd = 1 / sqrt(sum + ε)
        AscendC::Adds(rstd, rstd, EPSILON, mergeN);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Sqrt(rstd, rstd, mergeN);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Div(rstd, ones, rstd, mergeN);
        AscendC::PipeBarrier<PIPE_V>();
        // xfp32 *= rstd
        AscendC::Brcb(sqx, rstd, (mergeN + 7) / 8, {1, 8});
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(xfp32, xfp32, sqx, 64, mergeN, xMulrstdParams);
        AscendC::Mul(xfp32[64], xfp32[64], sqx, 64, mergeN, xMulrstdParams);
        AscendC::PipeBarrier<PIPE_V>();
        // xfp32 *= gamma
        auto q_x1 = xfp32;
        AscendC::Mul(q_x1, q_x1, q_gamma, 64, q_heads, xMulgammaParams);
        AscendC::Mul(q_x1[64], q_x1[64], q_gamma[64], 64, q_heads, xMulgammaParams);
        auto k_x1 = xfp32[q_size];
        AscendC::Mul(k_x1, k_x1, k_gamma, 64, k_heads, xMulgammaParams);
        AscendC::Mul(k_x1[64], k_x1[64], k_gamma[64], 64, k_heads, xMulgammaParams);
        if (likely(!single_line)) {
            auto q_x2 = xfp32[qk_dim];
            auto k_x2 = xfp32[qk_dim + q_size];
            AscendC::Mul(q_x2, q_x2, q_gamma, 64, q_heads, xMulgammaParams);
            AscendC::Mul(q_x2[64], q_x2[64], q_gamma[64], 64, q_heads, xMulgammaParams);
            AscendC::Mul(k_x2, k_x2, k_gamma, 64, k_heads, xMulgammaParams);
            AscendC::Mul(k_x2[64], k_x2[64], k_gamma[64], 64, k_heads, xMulgammaParams);
        }
        AscendC::PipeBarrier<PIPE_V>();

        // rope
        int qk_heads = q_heads + k_heads;
        auto cos = cos_sin_fp32;
        auto sin = cos_sin_fp32[64];
        auto mul1 = sqx;
        auto mul2 = sqx[qk_dim];
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(1);
        // cast
        AscendC::Cast(cos_sin_fp32, cos_sin_double, AscendC::RoundMode::CAST_NONE, HEAD_DIM);
        AscendC::PipeBarrier<PIPE_V>();
        // mul1 : [x2 * (-sin), x1 * sin]
        // mul2: [x1 * cos,    x2 * cos]
        auto x = xfp32;
        AscendC::Mul(mul1[64], x, sin, 64, qk_heads, xMulgammaParams);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Muls(sin, sin, -1.0f, 64);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Mul(mul1, x[64], sin, 64, qk_heads, xMulgammaParams);
        AscendC::Mul(mul2, x, cos, 64, qk_heads, xMulgammaParams);
        AscendC::Mul(mul2[64], x[64], cos, 64, qk_heads, xMulgammaParams);
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::Add(x, mul1, mul2, qk_dim);
        if (likely(!single_line)) {
            AscendC::Cast(cos_sin_fp32, cos_sin_double[HEAD_DIM], AscendC::RoundMode::CAST_NONE, HEAD_DIM);
            AscendC::PipeBarrier<PIPE_V>();
            auto x = xfp32[qk_dim];
            AscendC::Mul(mul1[64], x, sin, 64, qk_heads, xMulgammaParams);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Muls(sin, sin, -1.0f, 64);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Mul(mul1, x[64], sin, 64, qk_heads, xMulgammaParams);
            AscendC::Mul(mul2, x, cos, 64, qk_heads, xMulgammaParams);
            AscendC::Mul(mul2[64], x[64], cos, 64, qk_heads, xMulgammaParams);
            AscendC::PipeBarrier<PIPE_V>();
            AscendC::Add(x, mul1, mul2, qk_dim);
        }
        AscendC::PipeBarrier<PIPE_V>();
        AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(1); // cos_sin
        // cast
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
        AscendC::Cast(out, xfp32, AscendC::RoundMode::CAST_RINT, mergeD);
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(0);
        // save q, k, key_cache
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(0);
        AscendC::DataCopy(q[offset * q_size], out, qDataCopyParams[single_line]);
        AscendC::DataCopy(key_cache[kvSlotOffset(slot1)], out[q_size], KV_SIZE);
        if (likely(!single_line)) {
            AscendC::DataCopy(key_cache[kvSlotOffset(slot2)], out[qk_dim + q_size], KV_SIZE);
        }
        AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(0);
    }
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(0);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(1);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(0);

    AscendC::CrossCoreSetFlag<0x2, PIPE_MTE3>(PAIR_V2A);
}

/* 
*  |   ping    |   pong    |     | ping | pong |
*  |gS0(P0)|gO0|gS1(P1)|gO1| x20 |gOAcc0|gOAcc1| x20
*/
#define FA_HEAD \
constexpr int QBLOCK_SIZE = 128; \
constexpr int BC_BLOCKS = 8; \
constexpr int BC = QBLOCK_SIZE * BC_BLOCKS; \
AscendC::GlobalTensor<bfloat16_t> gQ, gK, gV; \
gQ.SetGlobalBuffer((__gm__ bfloat16_t*)q_addr); \
gK.SetGlobalBuffer((__gm__ bfloat16_t*)key_cache_addr); \
gV.SetGlobalBuffer((__gm__ bfloat16_t*)value_cache_addr); \
gQ.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE); \
 \
AscendC::GlobalTensor<int32_t> gTasks, gBlockTable, gCuQLens, gKvLens; \
gTasks.SetGlobalBuffer((__gm__ int32_t*)tasks_addr); \
gBlockTable.SetGlobalBuffer((__gm__ int32_t*)bt_addr); \
gCuQLens.SetGlobalBuffer((__gm__ int32_t*)cu_q_lens_addr); \
gKvLens.SetGlobalBuffer((__gm__ int32_t*)kv_lens_addr); \
 \
int aicIdx = blockIdx; \
if ASCEND_IS_AIV { aicIdx /= 2; } \
const int group = q_size / HEAD_DIM / KV_HEADS; \
const int qTokens = group * QBLOCK_SIZE; \
const int sBytes = group * QBLOCK_SIZE * BC * 4; \
const int oBytes = group * QBLOCK_SIZE * HEAD_DIM * 4; \
 \
const int kvHead0 = (aicIdx % 4) * 2; \
const int kvHead1 = kvHead0 + 1; \
const int64_t taskOffset = (int64_t)(aicIdx / 4) * tasks_size; \
 \
AscendC::GlobalTensor<float> gS[2], gO[2], gOAcc[2]; \
AscendC::GlobalTensor<bfloat16_t> gP[2]; \
auto wsPtr = ws_addr + aicIdx * (2 * sBytes + 2 * oBytes); \
auto accPtr = ws_addr + AIC_NUM * (2 * sBytes + 2 * oBytes) + aicIdx * 2 * oBytes; \
gS[0].SetGlobalBuffer((__gm__ float*)wsPtr); \
gO[0].SetGlobalBuffer((__gm__ float*)(wsPtr + sBytes)); \
gP[0].SetGlobalBuffer((__gm__ bfloat16_t*)wsPtr);                         /* P0 嵌入 S0 每行前半 */ \
gP[1].SetGlobalBuffer((__gm__ bfloat16_t*)(wsPtr + sBytes + oBytes));     /* P1 嵌入 S1 每行前半 */ \
gS[1].SetGlobalBuffer((__gm__ float*)(wsPtr + sBytes + oBytes)); \
gO[1].SetGlobalBuffer((__gm__ float*)(wsPtr + 2 * sBytes + oBytes)); \
gOAcc[0].SetGlobalBuffer((__gm__ float*)accPtr); \
gOAcc[1].SetGlobalBuffer((__gm__ float*)(accPtr + oBytes)); \
 \
int t[3], req[3], qBlock[3], cuBr[3], br[3], kvHead[3], blockNum[3], b[3], bc[3]; \
int64_t gQBase[3]; \
int block01 = 0; \
auto cid  = [&](const int w) __aicore__ { return t[w] * (kvHead1 - kvHead0 + 1) + (kvHead[w] - kvHead0); }; \
 \
auto calcBr = [&](const int which) __aicore__ { \
    const int kvLen = gKvLens.GetValue(req[which]); \
    const int64_t cuQLen = gCuQLens.GetValue(req[which]); \
    const int64_t lastCuQLen = req[which] == 0 ? 0 : gCuQLens.GetValue(req[which] - 1); \
    const int qLen = (int)(cuQLen - lastCuQLen); \
    int qOffset; \
    if (qLen == kvLen) { \
        qOffset = qBlock[which] * QBLOCK_SIZE; \
        br[which] = min(QBLOCK_SIZE, qLen - qOffset); \
        cuBr[which] = qOffset + br[which]; \
    } else { \
        int chunked = kvLen - qLen; \
        if (qBlock[which] == 0) { \
            qOffset = 0; \
            br[which] = min(QBLOCK_SIZE - (chunked % QBLOCK_SIZE), qLen); \
            cuBr[which] = chunked + br[which]; \
        } else { \
            qOffset = QBLOCK_SIZE - (chunked % QBLOCK_SIZE) + (qBlock[which] - 1) * QBLOCK_SIZE; \
            br[which] = min(QBLOCK_SIZE, qLen - qOffset); \
            cuBr[which] = chunked + qOffset + br[which]; \
        } \
    } \
    blockNum[which] = (cuBr[which] + BC - 1) / BC; \
    gQBase[which] = (lastCuQLen + qOffset) * q_size + kvHead[which] * group * HEAD_DIM; \
}; \
 \
auto calcNewTask = [&](const int which) __aicore__ { \
    int tid = gTasks.GetValue(taskOffset + t[which]); \
    if (tid >= 0) { \
        req[which] = tid >> 16; \
        qBlock[which] = tid & 0xFFFF; \
        kvHead[which] = kvHead0; \
        calcBr(which); \
        b[which] = 0; \
        bc[which] = blockNum[which] > 1 ? BC : cuBr[which]; \
    } else { \
        req[which] = -1; \
    } \
}; \
 \
auto calcNextBlock = [&](const int which) __aicore__ { \
    const int next = which + 1; \
 \
    auto copy0 = [&](const int bNext) __aicore__ { \
        t[next] = t[which]; \
        req[next] = req[which]; \
        qBlock[next] = qBlock[which]; \
        cuBr[next] = cuBr[which]; \
        br[next] = br[which]; \
        blockNum[next] = blockNum[which]; \
        b[next] = bNext; \
        bc[next] = b[next] < blockNum[next] - 1 ? BC : cuBr[next] - b[next] * BC; \
    }; \
 \
    if (b[which] + 1 < blockNum[which]) { \
        copy0(b[which] + 1); \
        kvHead[next] = kvHead[which]; \
        gQBase[next] = gQBase[which]; \
    } else if (kvHead[which] < kvHead1) { \
        copy0(0); \
        kvHead[next] = kvHead[which] + 1; \
        gQBase[next] = gQBase[which] + group * HEAD_DIM; \
    } else { \
        t[next] = t[which] + 1; \
        if (t[next] < tasks_size) { \
            calcNewTask(next); \
        } else { \
            req[next] = -1; \
        } \
    } \
}; \
 \
auto nextStep = [&]() __aicore__ { \
    t[0] = t[1]; \
    req[0] = req[1]; \
    qBlock[0] = qBlock[1]; \
    kvHead[0] = kvHead[1]; \
    cuBr[0] = cuBr[1]; \
    br[0] = br[1]; \
    blockNum[0] = blockNum[1]; \
    gQBase[0] = gQBase[1]; \
    b[0] = b[1]; \
    bc[0] = bc[1]; \
 \
    t[1] = t[2]; \
    req[1] = req[2]; \
    qBlock[1] = qBlock[2]; \
    kvHead[1] = kvHead[2]; \
    cuBr[1] = cuBr[2]; \
    br[1] = br[2]; \
    blockNum[1] = blockNum[2]; \
    gQBase[1] = gQBase[2]; \
    b[1] = b[2]; \
    bc[1] = bc[2]; \
};

__aicore__ void fa_aic(GM_ADDR tasks_addr, const int tasks_size, 
                        GM_ADDR q_addr, const int q_size, const float scaling,
                        GM_ADDR key_cache_addr, GM_ADDR value_cache_addr, 
                        GM_ADDR bt_addr, const int bt_size, GM_ADDR cu_q_lens_addr, GM_ADDR kv_lens_addr, 
                        GM_ADDR mask_addr, GM_ADDR ws_addr, const int64_t kv_block_stride, 
                        const int blockIdx, const int AIC_NUM)
{
    FA_HEAD
    const int kvPageSize = BLOCK_SIZE * HEAD_DIM; // 16K
    const int qSize = qTokens * HEAD_DIM; // 80K
    const int pBufSize = 128 * HEAD_DIM; // 16K
    const int l1BufSize = BC_BLOCKS * kvPageSize + qSize + 2 * pBufSize;
    AscendC::LocalTensor<bfloat16_t> l1Buf(AscendC::TPosition::A1, 0, l1BufSize); // 320KB
    AscendC::LocalTensor<bfloat16_t> l1KV[BC_BLOCKS];
    AscendC::LocalTensor<bfloat16_t> l1Q = l1Buf[BC_BLOCKS * kvPageSize];
    AscendC::LocalTensor<bfloat16_t> l1P[2] = {l1Buf[BC_BLOCKS * kvPageSize + qSize], l1Buf[BC_BLOCKS * kvPageSize + qSize + pBufSize]};
    int l1KVFlag[4] = {0, 1, 2, 3};
    const int l1QFlag = 4;
    const int l1PFlag[2] = {5, 6};
    for (int i = 0; i < BC_BLOCKS; ++i) {
        l1KV[i] = l1Buf[i * kvPageSize];
    }

    constexpr int KB32 = 32 * 1024;
    constexpr int KB16 = 16 * 1024;
    AscendC::LocalTensor<bfloat16_t> l0ABuf(AscendC::TPosition::A2, 0, KB32);
    AscendC::LocalTensor<bfloat16_t> l0A[2] = {l0ABuf, l0ABuf[KB16]};
    const int l0AFlag[2] = {0, 1};

    AscendC::LocalTensor<bfloat16_t> l0BBuf(AscendC::TPosition::B2, 0, KB32);
    AscendC::LocalTensor<bfloat16_t> l0B[2] = {l0BBuf, l0BBuf[KB16]};
    const int l0BFlag[2] = {2, 3};

    AscendC::LocalTensor<float> l0CBuf(AscendC::TPosition::CO1, 0, KB32);
    AscendC::LocalTensor<float> l0C[2] = {l0CBuf, l0CBuf[KB16]};
    const int l0CFlag[2] = {0, 1};

    // br * (group*HEAD_DIM) -> ceil16(group*br) * HEAD_DIM
    AscendC::Nd2NzParams qNd2nzParams;
    qNd2nzParams.ndNum = QBLOCK_SIZE;
    qNd2nzParams.nValue = group;
    qNd2nzParams.dValue = HEAD_DIM;
    qNd2nzParams.srcNdMatrixStride = q_size;
    qNd2nzParams.srcDValue = HEAD_DIM;
    qNd2nzParams.dstNzC0Stride = qNd2nzParams.ndNum * qNd2nzParams.nValue;
    qNd2nzParams.dstNzNStride = QBLOCK_SIZE;
    qNd2nzParams.dstNzMatrixStride = 16;

    // (group*br) * bc -> ceil16(group*br) * ceil16(bc)
    AscendC::Nd2NzParams pNd2nzParams;
    pNd2nzParams.ndNum = 1;
    pNd2nzParams.dValue = BLOCK_SIZE;
    pNd2nzParams.nValue = 128;
    pNd2nzParams.srcDValue = 2 * BC;   // P 嵌入 S 每行前半：P 行距 2*BC 个 bf16
    pNd2nzParams.dstNzC0Stride = 128;
    pNd2nzParams.dstNzNStride = 1;

    AscendC::Nd2NzParams kvNd2nzParams;
    kvNd2nzParams.ndNum = 1;
    kvNd2nzParams.nValue = BLOCK_SIZE;
    kvNd2nzParams.dValue = HEAD_DIM;
    kvNd2nzParams.srcDValue = KV_HEADS * HEAD_DIM;
    kvNd2nzParams.dstNzC0Stride = BLOCK_SIZE;
    kvNd2nzParams.dstNzNStride = 1;

    // l1W * channelSize -> mExtension * kExtension
    AscendC::LoadData3DParamsV2<bfloat16_t> loadL0AParams; // qp
    loadL0AParams.l1H = 1;                                  // 二维矩阵恒取1
    loadL0AParams.l1W = qNd2nzParams.dstNzC0Stride;         // 源缓冲区行
    loadL0AParams.channelSize = 128;     // channelSize不参与计算，但是要>=kExtension
    loadL0AParams.mExtension = 128;                         // 有效行
    loadL0AParams.kExtension = 128;                         // 有效列
    
    AscendC::LoadData3DParamsV2<bfloat16_t> loadL0VParams;
    loadL0VParams.l1H = 1;
    loadL0VParams.l1W = BLOCK_SIZE;
    loadL0VParams.channelSize = HEAD_DIM;
    loadL0VParams.mExtension = BLOCK_SIZE;
    loadL0VParams.kExtension = HEAD_DIM;

    AscendC::LoadData2DParams loadL0KParams;
    loadL0KParams.startIndex = 0;
    loadL0KParams.repeatTimes = (HEAD_DIM / 16) * (BLOCK_SIZE / 16); // 列*行
    loadL0KParams.srcStride = 1;
    loadL0KParams.dstGap = 0;
    loadL0KParams.ifTranspose = false;
    
    AscendC::MmadParams qkParams;
    qkParams.m = QBLOCK_SIZE;
    qkParams.n = BLOCK_SIZE;
    qkParams.k = HEAD_DIM;
    qkParams.unitFlag = 3;

    AscendC::FixpipeParamsV220 qkFixParams;
    qkFixParams.nSize = BC;                  // 有效列数
    qkFixParams.mSize = QBLOCK_SIZE * group; // 有效行数 
    qkFixParams.srcStride = 128;             // L0C行数 ceil16(br)
    qkFixParams.dstStride = BC;              // GM 缓冲区行宽 
    qkFixParams.ndNum = 1;
    qkFixParams.srcNdStride = 0;
    qkFixParams.dstNdStride = 0;
    qkFixParams.unitFlag = 3;

    AscendC::MmadParams pvParams;
    pvParams.cmatrixInitVal = true; // 初始值化清零
    pvParams.m = QBLOCK_SIZE;
    pvParams.n = HEAD_DIM;
    pvParams.k = 128;
    pvParams.unitFlag = 3;

    AscendC::FixpipeParamsV220 pvFixParams;
    pvFixParams.nSize = HEAD_DIM;
    pvFixParams.mSize = QBLOCK_SIZE * group;
    pvFixParams.srcStride = 128;
    pvFixParams.dstStride = HEAD_DIM;
    pvFixParams.ndNum = 1;
    pvFixParams.srcNdStride = 0;
    pvFixParams.dstNdStride = 0;
    pvFixParams.unitFlag = 3;

    int l1P01 = 0;
    int l0A01 = 0;
    int l0B01 = 0;
    int l0C01 = 0;
    int l1BCached[2];
    bool blockCalced[BC_BLOCKS];
    
    int bids[BC_BLOCKS];
    auto getBids = [&](const int which) __aicore__ {
        const int64_t offset = (int64_t)req[which] * bt_size + b[which] * BC_BLOCKS;
        const int blocks = (bc[which] + BLOCK_SIZE - 1) / BLOCK_SIZE;
        for (int i = 0; i < blocks; ++i) {
            bids[i] = gBlockTable.GetValue(offset + i);
        }
        return blocks;
    };

    auto loadL1KV = [&](AscendC::GlobalTensor<bfloat16_t> &gKV, 
                        const int which, const int blocks, const int kvi2) __aicore__ {
        const int flag = l1KVFlag[kvi2 / 2];
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(flag);
        kvNd2nzParams.nValue = min(BLOCK_SIZE, bc[which] - kvi2 * BLOCK_SIZE);
        kvNd2nzParams.dstNzC0Stride = ceil(16, kvNd2nzParams.nValue);
        AscendC::DataCopy(l1KV[kvi2], 
            gKV[(int64_t)bids[kvi2] * kv_block_stride + (int64_t)kvHead[which] * HEAD_DIM], 
            kvNd2nzParams);
        if (kvi2 < blocks - 1) {
            const int i = kvi2 + 1;
            kvNd2nzParams.nValue = min(BLOCK_SIZE, bc[which] - i * BLOCK_SIZE);
            kvNd2nzParams.dstNzC0Stride = ceil(16, kvNd2nzParams.nValue);
            AscendC::DataCopy(l1KV[i], 
                gKV[(int64_t)bids[i] * kv_block_stride + (int64_t)kvHead[which] * HEAD_DIM], 
                kvNd2nzParams);
        }
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(flag);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(flag); // for loadL0KV
    };

    auto qk = [&](const int which) __aicore__ {
        const int blocks = getBids(which);
        const int gbr = br[which] * group;
        qNd2nzParams.ndNum = qNd2nzParams.dstNzNStride = br[which];
        loadL0AParams.l1W = qNd2nzParams.dstNzC0Stride = ceil(16, gbr);
        loadL0AParams.kExtension = HEAD_DIM;

        l1BCached[0] = l1BCached[1] = -1;
        if (b[which] == 0) {
            // loadL1Q
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1QFlag);
            AscendC::DataCopy(l1Q, gQ[gQBase[which]], qNd2nzParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1QFlag);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1QFlag);
        }
        for (int r = 0; r < gbr; r += 128) {
            const int row = min(128, gbr - r);
            // loadL0Q
            // 当 M = 1 时，会默认开启 GEMV（General Matrix-Vector Multiplication）功能。在这种情况下，Mmad API 从 L0A Buffer 读取数据时，会以 ND 格式进行读取，而不会将其视为 ZZ 格式。所以此时左矩阵需要直接按照 ND 格式进行排布。所以m要16对齐，k，n不需要
            qkParams.m = loadL0AParams.mExtension = qkFixParams.srcStride = ceil(16, row);
            qkFixParams.mSize = row;
            AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AFlag[l0A01]);
            AscendC::LoadData(l0A[l0A01], l1Q[r*16], loadL0AParams);
            AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0AFlag[l0A01]);
            AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0AFlag[l0A01]);
            for (int ki = 0; ki < BC_BLOCKS; ++ki) {
                blockCalced[ki] = false;
            }

            auto mm = [&](const int ki, const bool releaseL1KV) __aicore__ {
                AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(l0CFlag[l0C01]);
                AscendC::Mmad(l0C[l0C01], l0A[l0A01], l0B[l0B01], qkParams);
                AscendC::Fixpipe(gS[block01][r*BC + ki*BLOCK_SIZE], l0C[l0C01], qkFixParams);
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BFlag[l0B01]);
                AscendC::SetFlag<AscendC::HardEvent::FIX_M>(l0CFlag[l0C01]);
                blockCalced[ki] = true;
                if (releaseL1KV && r + row >= gbr && ((ki & 1) == 1 || ki == blocks - 1)) {
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1KVFlag[ki/2]);
                }
                l0B01 = 1 - l0B01;
                l0C01 = 1 - l0C01;
            };

            for (int i = 0; i < 2; ++i) {
                int ki = l1BCached[l0B01];
                if (ki >= 0) {
                    qkParams.n = qkFixParams.nSize = min(BLOCK_SIZE, bc[which] - ki * BLOCK_SIZE);
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BFlag[l0B01]);
                    mm(ki, false);
                } else {
                    l0B01 = 1 - l0B01;
                }
            }
            for (int ki = 0; ki < blocks; ++ki) {
                if (blockCalced[ki]) {
                    if (r + row >= gbr && ((ki & 1) == 1 || ki == blocks - 1)) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1KVFlag[ki/2]);
                    }
                    continue;
                }
                const int col = min(BLOCK_SIZE, bc[which] - ki * BLOCK_SIZE);
                const int col16 = ceil(16, col);
                qkParams.n = qkFixParams.nSize = col;
                if (r == 0 && (ki & 1) == 0) {
                    loadL1KV(gK, which, blocks, ki);
                }
                // loadL0K
                loadL0KParams.repeatTimes = col16 * HEAD_DIM / 256;
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BFlag[l0B01]);
                AscendC::LoadData(l0B[l0B01], l1KV[ki], loadL0KParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0BFlag[l0B01]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0BFlag[l0B01]);
                l1BCached[l0B01] = ki;
                mm(ki, true);
            }
            AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AFlag[l0A01]);
            l0A01 = 1 - l0A01;
        }
        if (b[which] == blockNum[which] - 1) {
            AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1QFlag);
        }

        AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(1);
    };
    
    auto pv = [&] __aicore__ { // which = 0
        AscendC::CrossCoreWaitFlag<0x2>(2);
        const int blocks = getBids(0);
        const int gbr = br[0] * group;
        l1BCached[0] = l1BCached[1] = -1;

        for (int r = 0; r < gbr; r += 128) {
            const int row = min(128, gbr - r);
            int calced = 0;
            pNd2nzParams.nValue = pvFixParams.mSize = row;
            pvParams.m = loadL0AParams.l1W = loadL0AParams.mExtension = pNd2nzParams.dstNzC0Stride = pvFixParams.srcStride = ceil(16, row);
            for (int ki = 0; ki < BC_BLOCKS; ++ki) {
                blockCalced[ki] = false;
            }

            auto loadP = [&](const int vi) __aicore__ {
                // GM -> L1
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(l1PFlag[l1P01]);
                AscendC::DataCopy(l1P[l1P01], gP[block01][r*pNd2nzParams.srcDValue + vi*BLOCK_SIZE], pNd2nzParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(l1PFlag[l1P01]);
                // L1 -> L0
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(l1PFlag[l1P01]);
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0AFlag[l0A01]);
                AscendC::LoadData(l0A[l0A01], l1P[l1P01], loadL0AParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0AFlag[l0A01]);
                AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1PFlag[l1P01]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0AFlag[l0A01]); // for mm
                l1P01 = 1 - l1P01;
            };

            auto mm = [&](const int vi, const bool releaseL1KV) __aicore__ {
                pvParams.unitFlag = ++calced == blocks ? 3 : 0;
                AscendC::Mmad(l0C[l0C01], l0A[l0A01], l0B[l0B01], pvParams);
                // aicore 要求：同一 L0C 上连续 Mmad 累加时，若输出规模过小，后一条 mad 对 L0C
                // 的读会与上一条 mad 尚未落账的回写相撞（aicore exception，L0C access conflict），
                // 必须在 Mmad 之后立即排空 cube 流水。
                // 判据与写法照抄 CANN 官方实现：
                //   asc-devkit      impl/adv_api/detail/matmul/stage/compute/mmad_compute.h:68
                //   ops-transformer attention/common/op_kernel/matmul.h:544（MatmulKPP，k 轴累加）
                // 官方原句注释："add pipe_M required by aicore"，判据 (m/16)*(n/16) < 10。
                if (pvParams.m * pvParams.n < 2560) {
                    AscendC::PipeBarrier<PIPE_M>();
                }
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0AFlag[l0A01]);
                AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(l0BFlag[l0B01]);
                blockCalced[vi] = true;
                if (pvParams.cmatrixInitVal) {
                    pvParams.cmatrixInitVal = false;
                }
                if (releaseL1KV && r + row >= gbr && ((vi & 1) == 1 || vi == blocks - 1)) {
                    AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1KVFlag[vi/2]);
                }
                l0A01 = 1 - l0A01;
                l0B01 = 1 - l0B01;
            };

            AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(l0CFlag[l0C01]);
            pvParams.cmatrixInitVal = true;
            for (int i = 0; i < 2; ++i) {
                int vi = l1BCached[l0B01];
                if (vi >= 0) {
                    pvParams.k = pNd2nzParams.dValue = min(BLOCK_SIZE, bc[0] - vi * BLOCK_SIZE);
                    loadL0AParams.kExtension = ceil(16, pvParams.k);
                    loadP(vi);
                    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BFlag[l0B01]);
                    mm(vi, false);
                } else {
                    l0B01 = 1 - l0B01;
                }
            }
            for (int vi = 0; vi < blocks; ++vi) {
                if (blockCalced[vi]) {
                    if (r + row >= gbr && ((vi & 1) == 1 || vi == blocks - 1)) {
                        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(l1KVFlag[vi/2]);
                    }
                    continue;
                }
                const int col = min(BLOCK_SIZE, bc[0] - vi * BLOCK_SIZE);
                const int col16 = ceil(16, col);
                pvParams.k = pNd2nzParams.dValue = col;
                loadL0AParams.kExtension = loadL0VParams.l1W = loadL0VParams.mExtension = col16;
                loadP(vi);
                if (r == 0 && (vi & 1) == 0) {
                    loadL1KV(gV, 0, blocks, vi);
                }
                // loadL0V
                AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(l0BFlag[l0B01]);
                AscendC::LoadData(l0B[l0B01], l1KV[vi], loadL0VParams);
                AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(l0BFlag[l0B01]);
                AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(l0BFlag[l0B01]); // for mm
                l1BCached[l0B01] = vi;
                mm(vi, true);
            }
            if (b[0] == 0) {
                AscendC::Fixpipe(gOAcc[cid(0) & 1][r*pvFixParams.dstStride], l0C[l0C01], pvFixParams);
            } else {
                AscendC::Fixpipe(gO[block01][r*pvFixParams.dstStride], l0C[l0C01], pvFixParams);
            }
            AscendC::SetFlag<AscendC::HardEvent::FIX_M>(l0CFlag[l0C01]);
            l0C01 = 1 - l0C01;
        }

        AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(3);
    };

    wait_all_aiv();

    for (int i = 0; i < 7; ++i) {
        AscendC::SetFlag<AscendC::HardEvent::MTE1_MTE2>(i);
    }
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(0);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(1);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(2);
    AscendC::SetFlag<AscendC::HardEvent::M_MTE1>(3);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(0);
    AscendC::SetFlag<AscendC::HardEvent::FIX_M>(1);

    t[0] = 0;
    calcNewTask(0);
    if (req[0] >= 0) {
        calcNextBlock(0);
        qk(0);
        if (req[1] >= 0) {
            block01 = 1 - block01;
        }
    } else {
        req[1] = -1;
    }
    while (req[1] >= 0) {
        calcNextBlock(1);
        qk(1);
        block01 = 1 - block01;
        pv();
        nextStep();
        if (req[1] < 0) {
            block01 = 1 - block01;
        }
    }
    if (req[0] >= 0) {
        pv();
    }

    for (int i = 0; i < 7; ++i) {
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_MTE2>(i);
    }
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(0);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(1);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(2);
    AscendC::WaitFlag<AscendC::HardEvent::M_MTE1>(3);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(0);
    AscendC::WaitFlag<AscendC::HardEvent::FIX_M>(1);
}

__aicore__ void fa_aiv(GM_ADDR tasks_addr, const int tasks_size, 
                        GM_ADDR q_addr, const int q_size, const float scaling,
                        GM_ADDR key_cache_addr, GM_ADDR value_cache_addr, 
                        GM_ADDR bt_addr, const int bt_size, GM_ADDR cu_q_lens_addr, GM_ADDR kv_lens_addr, 
                        GM_ADDR mask_addr, GM_ADDR ws_addr, const int64_t kv_block_stride, 
                        const int blockIdx, const int AIC_NUM)
{
    AscendC::PipeBarrier<PIPE_ALL>();
    FA_HEAD
    const int aivIdx = blockIdx & 1;
    AscendC::GlobalTensor<float> gMask;
    gMask.SetGlobalBuffer((__gm__ float*)mask_addr);
    int64_t ubPtr = 0;
    AscendC::LocalTensor<float> maskF32(AscendC::TPosition::VECCALC, ubPtr, 32 * 32); ubPtr += 32 * 32 * 4;   // 4KB
    AscendC::DataCopy(maskF32, gMask, 32 * 32);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(0);

    constexpr int SOBUF_SIZE = 8192; // 8K
    constexpr int MAX_SBUF_ROWS = SOBUF_SIZE / 64; // 128 
    constexpr int OBUF_ROWS = SOBUF_SIZE / HEAD_DIM;
    AscendC::LocalTensor<float> soBuf(AscendC::TPosition::VECCALC, ubPtr, SOBUF_SIZE * 2); ubPtr += SOBUF_SIZE * 8; // 64KB
    AscendC::LocalTensor<float> s[2] = {soBuf, soBuf[SOBUF_SIZE]};                            // MTE3_MTE2_0, MTE3_MTE2_1
    AscendC::LocalTensor<float> oAcc[2] = {soBuf, soBuf[SOBUF_SIZE]};
    AscendC::LocalTensor<bfloat16_t> poBf16[2] = {s[0].ReinterpretCast<bfloat16_t>(), s[1].ReinterpretCast<bfloat16_t>()};
    AscendC::LocalTensor<float> bcast(AscendC::TPosition::VECCALC, ubPtr, MAX_SBUF_ROWS * 8);
    AscendC::LocalTensor<float> reduceBuf(AscendC::TPosition::VECCALC, ubPtr, 4096); ubPtr += 4096 * 4;      // 16KB
    AscendC::LocalTensor<float> oTmp(AscendC::TPosition::VECCALC, ubPtr, OBUF_ROWS * HEAD_DIM); ubPtr += OBUF_ROWS * HEAD_DIM * 4; // 32KB
    AscendC::LocalTensor<float> mLocal(AscendC::TPosition::VECCALC, ubPtr, MAX_SBUF_ROWS); ubPtr += MAX_SBUF_ROWS * 4;             // 512
    AscendC::LocalTensor<float> mNew(AscendC::TPosition::VECCALC, ubPtr, MAX_SBUF_ROWS); ubPtr += MAX_SBUF_ROWS * 4;               // 512
    AscendC::LocalTensor<float> m(AscendC::TPosition::VECCALC, ubPtr, qTokens); ubPtr += qTokens * 4;          // 2560
    AscendC::LocalTensor<float> alphas(AscendC::TPosition::VECCALC, ubPtr, qTokens * 2); ubPtr += qTokens * 8; // 5120
    AscendC::LocalTensor<float> ls(AscendC::TPosition::VECCALC, ubPtr, qTokens * 2); ubPtr += qTokens * 8;     // 5120
    AscendC::LocalTensor<float> alpha[2] = {alphas, alphas[qTokens]};
    AscendC::LocalTensor<float> l[2] = {ls, ls[qTokens]};
    // (512+2560+5120)*2 + (4+64+16+32)KB = (16 + 116)KB = 132KB

    auto brcb8 = [&](const AscendC::LocalTensor<float> &_t_, const int row) __aicore__ {
        AscendC::Brcb(bcast, _t_, (row + 7) / 8, {1, 8});
        AscendC::PipeBarrier<PIPE_V>();
    };

    int so01 = 0;
    const int OTMP_FLAG = 2;   // oTmp 单缓冲专用 V_MTE2/MTE2_V，避开 so01 的 0/1
    
    AscendC::DataCopyExtParams ext;

    auto stage1 = [&](const int which) __aicore__ {
        const int gbr = br[which] * group;
        const int half = min(ceil(8, gbr / 2), gbr);
        const int er = aivIdx == 0 ? half : gbr;
        const int col = bc[which];
        const int col64 = ceil(64, col);
        const int bufRow = SOBUF_SIZE / col64 / 8 * 8;
        AscendC::CrossCoreWaitFlag<0x2>(1);

        for (int r = aivIdx * half; r < er; r += bufRow, so01 = 1 - so01) {
            const int row = min(bufRow, er - r);
            const int count = row * col64;

            // load and mask
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(so01);
            if (b[which] < blockNum[which] - 1) {
                AscendC::DataCopy(s[so01], gS[block01][r * BC], count);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(so01);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(so01);
            } else {
                // 0 ~ col：有效值
                // col ~ col8: 填充-inf
                const int col8 = ceil(8, col);
                ext.blockCount = row;
                ext.blockLen   = col * sizeof(float);                 // 单位：字节（支持非对齐）
                ext.srcStride  = (BC - col) * sizeof(float);  // 源为 GM ⇒ 单位字节
                ext.dstStride  = (col64 - col8) / 8;                  // 目的为 UB ⇒ 单位 dataBlock(32B)
                AscendC::DataCopyPad(s[so01], gS[block01][r * BC], 
                                    ext, {true, 0, (uint8_t)(col8 - col), NEG_INF});
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(so01);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(so01);
                if (col8 < col64) {
                    AscendC::Duplicate<float>(s[so01][col8], NEG_INF, col64 - col8, row, 1, col64 / 8);
                    AscendC::PipeBarrier<PIPE_V>();
                }
                if (br[which] > 1) {
                    const uint8_t rs = (uint8_t)(col64 / 8);
                    int rr = 0;
                    auto maskHead = [&](const int headR0) __aicore__ {
                        const int headR1 = min(br[which] - headR0, row - rr);
                        // ① 定位：先找对角所在的那个 QBLOCK_SIZE(128) 块，再取块内偏移
                        //    d0   = 本 bc 块内的对角列（b 已含在 - b*BC 里，chunked 下也精确）
                        //    wOff = 该 128 块在本行内的列偏移（块首）
                        //    r0   = 块内偏移（0..127）
                        //    wLen = 尾窗实际列数（行尾不足 128 列时 < 128）
                        const int d0   = cuBr[which] - br[which] + headR0 - b[which] * BC;
                        const int wOff = (d0 / QBLOCK_SIZE) * QBLOCK_SIZE;
                        const int r0   = d0 - wOff;
                        const int wLen = min(QBLOCK_SIZE, col64 - wOff);
                        const auto addr = s[so01][rr * col64 + wOff];

                        // ② 4 个 32 列分块：本块查表 + 本块之后整段 -inf；行溢出到下一块时从表第 0 行继续
                        int u = 0, rel = r0;
                        while (u < headR1) {
                            const int base = (rel / 32) * 32;                  // 0 / 32 / 64 / 96
                            const int r1   = min(32 - (rel - base), headR1 - u);  // 对角落在本块的行数
                            auto cur = addr[u * col64 + base];
                            // (a) 本块：查 32x32 表（表行 = 块内偏移）
                            AscendC::Add(cur, cur, maskF32[(rel - base) * 32], 32, r1, {1, 1, 1, rs, rs, 4});
                            // (b) 本块之后的列：整段 -inf（按 ≤64 列一段，最多两段）
                            //     ★ cur 已按 base 列偏移，故 dst 必须用 lo-base 相对寻址；
                            //       写成 cur[lo] 会再叠加一次 base，把 -inf 掩到本行更右侧并溢出到下一行。
                            const int lo = base + 32;
                            if (lo < wLen) {
                                const int w1 = min(64, wLen - lo);
                                AscendC::Duplicate<float>(cur[lo - base], NEG_INF, w1, r1, 1, rs);
                                if (lo + w1 < wLen) {
                                    AscendC::Duplicate<float>(cur[lo + w1 - base], NEG_INF, wLen - lo - w1, r1, 1, rs);
                                }
                            }
                            u   += r1;
                            rel  = lo;                                          // 剩余行的对角从下一块块首开始
                        }
                        return headR1;
                    };
                    int headR0 = r % br[which];
                    rr += maskHead(headR0);
                    for (; rr < row; rr += maskHead(0));
                    AscendC::PipeBarrier<PIPE_V>();
                }
            }

            auto aiv_row_reduce = [&](const AscendC::LocalTensor<float> &dst, const bool is_max) __aicore__ {
                // 算子选择器：调用点传字面量 true/false，内联后分支折叠 ⇒ 等价于手写两份
                auto aiv_red_sel = [&](const AscendC::LocalTensor<float> &d,
                                    const AscendC::LocalTensor<float> &src, const int rep) __aicore__ {
                    if (is_max) AscendC::BlockReduceMax<float, false>(d, src, rep, 0, 1, 1, 8);
                    else        AscendC::BlockReduceSum<float, false>(d, src, rep, 0, 1, 1, 8);
                };
                auto aiv_mrg_sel = [&](const AscendC::LocalTensor<float> &d,
                                    const AscendC::LocalTensor<float> &a,
                                    const AscendC::LocalTensor<float> &b,
                                    const int dstRep, const int src0Rep, const int src1Rep) __aicore__ {
                    if (is_max) AscendC::Max<float, false>(d, a, b, 64, row, {1, 1, 1, (uint8_t)dstRep, (uint8_t)src0Rep, (uint8_t)src1Rep});
                    else        AscendC::Add<float, false>(d, a, b, 64, row, {1, 1, 1, (uint8_t)dstRep, (uint8_t)src0Rep, (uint8_t)src1Rep});
                };

                const int reps = (row * 8 + 63) / 64;
                if (col64 == 1024) {
                    // 1024 列 = 128 datablock/行：
                    //   8 -> 1（每 datablock）; 16 datablock -> 2 repeat/行;
                    //   再 Max/Add 合并成 1 datablock/行; 最后 BlockReduce 出 1 值/行。
                    // 不走 WholeReduceMax，避免其 value/index 输出布局差异。
                    aiv_red_sel(reduceBuf, s[so01], row * 16);
                    AscendC::PipeBarrier<PIPE_V>();
                    aiv_red_sel(reduceBuf, reduceBuf, row * 2);
                    AscendC::PipeBarrier<PIPE_V>();
                    if (is_max) {
                        AscendC::Max<float, false>(reduceBuf, reduceBuf, reduceBuf[8],
                            8, row, {1, 1, 1, 1, 2, 2});
                    } else {
                        AscendC::Add<float, false>(reduceBuf, reduceBuf, reduceBuf[8],
                            8, row, {1, 1, 1, 1, 2, 2});
                    }
                    AscendC::PipeBarrier<PIPE_V>();
                    aiv_red_sel(dst, reduceBuf, reps);
                    AscendC::PipeBarrier<PIPE_V>();
                } else if (col64 == 512) {
                    aiv_red_sel(reduceBuf, s[so01], row * 8);
                    AscendC::PipeBarrier<PIPE_V>();
                    aiv_red_sel(reduceBuf, reduceBuf, row);         // 64 -> 8 /行（原地）
                    AscendC::PipeBarrier<PIPE_V>();
                    aiv_red_sel(dst, reduceBuf, reps);              // 8 -> 1 /行
                    AscendC::PipeBarrier<PIPE_V>();
                } else if (col64 == 64) {                           // row ≤ 128
                    aiv_red_sel(reduceBuf, s[so01], row);
                    AscendC::PipeBarrier<PIPE_V>();
                    aiv_red_sel(dst, reduceBuf, reps);
                    AscendC::PipeBarrier<PIPE_V>();
                } else {                                            // 128 / 192 / 256 / 320 / 384 / 448
                    const int cs = col64 / 64;
                    const int rp = cs * 8;                          // 源行距（32B 块）= col64 floats
                    aiv_mrg_sel(reduceBuf, s[so01], s[so01][64], 8, rp, rp);   // cs==2 时 rp=16 ≡ bak 的 {1,1,1,8,16,16}
                    AscendC::PipeBarrier<PIPE_V>();
                    for (int k = 2; k < cs; ++k) {
                        aiv_mrg_sel(reduceBuf, reduceBuf, s[so01][k * 64], 8, 8, rp);
                        AscendC::PipeBarrier<PIPE_V>();
                    }
                    aiv_red_sel(reduceBuf, reduceBuf, row);         // 64 -> 8 /行
                    AscendC::PipeBarrier<PIPE_V>();
                    aiv_red_sel(dst, reduceBuf, reps);              // 8 -> 1 /行
                    AscendC::PipeBarrier<PIPE_V>();
                }
            };

            auto s1p = [&](const AscendC::LocalTensor<float> &_m_) __aicore__ {
                // p = exp(s - mNew.unsqueeze(-1))
                brcb8(_m_, row);                                 // bcast：每行 8 个值（Brcb 布局）

                // s -= bcast：逐 64 列窗，cs = col64/64 次
                //   Sub 的 repeatTime 形参是 uint8_t（≤255）；row ≤ MAX_SBUF_ROWS = 128
                const int cs = col64 / 64;
                const int rp = cs * 8;                           // 行距（32B 块）= col64 floats
                if (row <= cs) {
                    // 行方向：一行一个 Sub，repeat=cs，bcast 固定为该行标量。
                    // BC1024(row=8,cs=16): 16 次 -> 8 次指令。
                    for (int rr = 0; rr < row; ++rr) {
                        AscendC::Sub(s[so01][rr * col64], s[so01][rr * col64], bcast[rr * 8],
                                        64, cs, {1, 1, 0, 8, 8, 0});
                    }
                } else {
                    // 列方向：一个 64 列窗一个 Sub，repeat=row。
                    for (int k = 0; k < cs; ++k) {
                        AscendC::Sub(s[so01][k * 64], s[so01][k * 64], bcast,
                                        64, row, {1, 1, 0, (uint8_t)rp, (uint8_t)rp, 1});
                    }
                }
                AscendC::PipeBarrier<PIPE_V>();

                AscendC::Exp(s[so01], s[so01], count);
                AscendC::PipeBarrier<PIPE_V>();
            };

            // s *= scaling
            AscendC::Muls(s[so01], s[so01], scaling, count);
            AscendC::PipeBarrier<PIPE_V>();
            if (unlikely(b[which] == 0)) {
                // m = mNew = mLocal = rowmax(s)
                // alpha = exp(-inf) = 0
                aiv_row_reduce(m[r], true);
                // p = exp(s - mNew.unsqueeze(-1))
                s1p(m[r]);
                // l = rowsum(p)
                aiv_row_reduce(l[cid(which) & 1][r], false);
            } else {
                // mLocal = rowmax(s)
                aiv_row_reduce(mLocal, true);
                // mNew = max(mLocal, m)
                AscendC::Max(mNew, mLocal, m[r], row);
                AscendC::PipeBarrier<PIPE_V>();
                // alpha = exp(m - mNew)
                AscendC::Sub(alpha[block01][r], m[r], mNew, row);
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Exp(alpha[block01][r], alpha[block01][r], row);
                // m = mNew
                AscendC::Adds(m[r], mNew, 0.0f, row);
                // p = exp(s - mNew.unsqueeze(-1))
                s1p(mNew);
                // l = alpha*l + rowsum(p)
                aiv_row_reduce(mNew, false); // use mNew as buf
                AscendC::FusedMulAdd(l[cid(which) & 1][r], alpha[block01][r], mNew, row);
                AscendC::PipeBarrier<PIPE_V>();
            }
            // write p
            AscendC::Cast(poBf16[so01], s[so01], AscendC::RoundMode::CAST_RINT, count);
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(so01);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(so01);
            // P 不再有独立区域：P row r 写入 S row r 的前半行。
            // 目的行距 2*BC 个 bf16，故满块也不能用连续 DataCopy。
            ext.blockCount = row;
            ext.blockLen   = col * sizeof(bfloat16_t);
            ext.srcStride  = (col64 - ceil(16, col)) / 16;              // 源为 UB ⇒ 单位 dataBlock(32B)
            ext.dstStride  = (2 * BC - col) * sizeof(bfloat16_t);      // 目的为 GM ⇒ 单位字节
            AscendC::DataCopyPad(gP[block01][r * 2 * BC], poBf16[so01], ext);
            AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(so01);
        }

        AscendC::CrossCoreSetFlag<0x2, PIPE_MTE3>(2);
    };

    AscendC::DataCopyParams qDataCopyParams;
    qDataCopyParams.blockCount = QBLOCK_SIZE;
    qDataCopyParams.blockLen   = HEAD_DIM * sizeof(bfloat16_t) / 32;
    qDataCopyParams.srcStride  = 0;
    qDataCopyParams.dstStride  = (q_size - HEAD_DIM) / 16;

    auto stage2 = [&]() __aicore__ { // which = 0
        const int gbr = br[0] * group;
        const int half = min(ceil(8, gbr / 2), gbr);
        const int er = aivIdx == 0 ? half : gbr;

        auto loadOAcc = [&](const AscendC::GlobalTensor<float> &_gOAcc_, const int count) __aicore__ {
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(so01);
            AscendC::DataCopy(oAcc[so01], _gOAcc_, count);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(so01);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(so01);
        };
        
        AscendC::CrossCoreWaitFlag<0x2>(3);

        if (b[0] == 0 && b[0] != blockNum[0] - 1) {
            return;
        }

        for (int r = aivIdx * half; r < er; r += OBUF_ROWS, so01 = 1 - so01) {
            const auto _gOAcc_ = gOAcc[cid(0) & 1][r * HEAD_DIM];
            const auto _gO_ = gO[block01][r * HEAD_DIM];
            const int row = min(OBUF_ROWS, er - r);
            const int count = row * HEAD_DIM;
            int head = r / br[0];
            if (b[0] > 0) {
                brcb8(alpha[block01][r], row);
                loadOAcc(_gOAcc_, count);
                AscendC::Mul(oAcc[so01], oAcc[so01], bcast, 64, row, {1, 1, 0, 16, 16, 1});
                AscendC::Mul(oAcc[so01][64], oAcc[so01][64], bcast, 64, row, {1, 1, 0, 16, 16, 1});
                AscendC::PipeBarrier<PIPE_V>();
                // ---- bak 语义：一次 oAcc（<=64 行）对应一次 oTmp 搬入，无 ping-pong ----
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(OTMP_FLAG);
                AscendC::DataCopy(oTmp, _gO_, count);
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(OTMP_FLAG);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(OTMP_FLAG);
                AscendC::Add(oAcc[so01], oAcc[so01], oTmp, count);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(OTMP_FLAG);
                if (b[0] != blockNum[0] - 1) {
                    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(so01);
                    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(so01);
                    AscendC::DataCopy(_gOAcc_, oAcc[so01], count);
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(so01);
                }
            }
            if (b[0] == blockNum[0] - 1) {
                if (b[0] == 0) {
                    loadOAcc(_gOAcc_, count);
                }
                brcb8(l[cid(0) & 1][r], row);
                AscendC::Div(oAcc[so01], oAcc[so01], bcast, 64, row, {1, 1, 0, 16, 16, 1});
                AscendC::Div(oAcc[so01][64], oAcc[so01][64], bcast, 64, row, {1, 1, 0, 16, 16, 1});
                AscendC::PipeBarrier<PIPE_V>();
                AscendC::Cast(poBf16[so01], oAcc[so01], AscendC::RoundMode::CAST_RINT, count);
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(so01);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(so01);
                // write
                if (br[0] == 1) {
                    AscendC::DataCopy(gQ[gQBase[0] + r * HEAD_DIM], poBf16[so01], row * HEAD_DIM);
                } else {
                    const int r0 = r % br[0];
                    const int r1 = br[0] - r0;
                    if (r1 > row) {
                        qDataCopyParams.blockCount = row;
                        AscendC::DataCopy(gQ[gQBase[0]+head*HEAD_DIM+r0*q_size], poBf16[so01], qDataCopyParams);
                    } else {
                        qDataCopyParams.blockCount = r1;
                        AscendC::DataCopy(gQ[gQBase[0]+head*HEAD_DIM+r0*q_size], poBf16[so01], qDataCopyParams);
                        ++head;
                        int rr = r1;
                        const int n = (row - r1) / br[0];
                        qDataCopyParams.blockCount = br[0];
                        for (int h = 0; h < n; ++h, ++head, rr += br[0]) {
                            AscendC::DataCopy(gQ[gQBase[0]+head*HEAD_DIM], poBf16[so01][rr * HEAD_DIM], qDataCopyParams);
                        }
                        if (rr < row) {
                            qDataCopyParams.blockCount = row - rr;
                            AscendC::DataCopy(gQ[gQBase[0]+head*HEAD_DIM], poBf16[so01][rr * HEAD_DIM], qDataCopyParams);
                        }
                    }
                }
                AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(so01);
            }
        }
    };

    AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(0);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(0);
    AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(1);
    AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(OTMP_FLAG);

    t[0] = 0;
    calcNewTask(0);
    if (req[0] >= 0) {
        calcNextBlock(0);
        stage1(0);
        block01 = 1 - block01;
    } else {
        req[1] = -1;
    }
    while (req[1] >= 0) {
        calcNextBlock(1);
        stage1(1);
        block01 = 1 - block01;
        stage2();
        nextStep();
    }
    if (req[0] >= 0) {
        block01 = 1 - block01;
        stage2();
    }

    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(1);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(OTMP_FLAG);

    AscendC::CrossCoreSetFlag<0x2, PIPE_MTE3>(PAIR_V2A);
}

#undef FA_HEAD

// ========================= kernel ========================= 

__global__ __mix__(1, 2) void qwen3_4b_14b_910b_kernel(const int num_tokens, 
                                GM_ADDR weights_params_addr, const int layer_num, GM_ADDR cos_sin_cache_addr, 
                                const int hidden_dim, const int q_size, const int gate_up_dim, const float scaling, const int64_t kv_block_stride, 
                                GM_ADDR positions_addr, GM_ADDR slot_mapping_addr, 
                                GM_ADDR tasks_addr, const int tasks_size, GM_ADDR cu_q_lens_addr, GM_ADDR kv_lens_addr, 
                                GM_ADDR block_table_addr, const int block_table_size, GM_ADDR mask_addr, GM_ADDR fa_ws_addr, 
                                GM_ADDR hidden_states_addr, GM_ADDR residual_addr, 
                                GM_ADDR qkv_addr, GM_ADDR q_addr, 
                                GM_ADDR gate_up_addr, GM_ADDR silu_addr,
                                const int AIC_NUM, const int AIV_NUM)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<int64_t> gWeights;
    gWeights.SetGlobalBuffer((__gm__ int64_t*)weights_params_addr);
    const int qkv_dim = q_size + 2 * KV_SIZE;
    const int silu_dim = gate_up_dim / 2;
    const int blockIdx = AscendC::GetBlockIdx();

    if ASCEND_IS_AIC {
        AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(PAIR_A2V);
    }
    for (int i = 0; i < layer_num; ++i) {
        const int weightsOffset = i * 10;
        if ASCEND_IS_AIV {
            add_rms_norm_aiv(hidden_states_addr, residual_addr, (GM_ADDR)gWeights.GetValue(weightsOffset), num_tokens, hidden_dim, blockIdx, AIV_NUM);
        }

        if ASCEND_IS_AIC {
            matmul_aic(hidden_states_addr, (GM_ADDR)gWeights.GetValue(weightsOffset + 1), qkv_addr, num_tokens, hidden_dim, qkv_dim, blockIdx, AIC_NUM);
        }

        auto key_cache_addr = (GM_ADDR)gWeights.GetValue(weightsOffset + 4);
        auto value_cache_addr = (GM_ADDR)gWeights.GetValue(weightsOffset + 5);
        if ASCEND_IS_AIV {
            split_qkv_rmsnorm_mrope_kv_cache_aiv(qkv_addr, q_addr, num_tokens, q_size, 
                            (GM_ADDR)gWeights.GetValue(weightsOffset + 2), (GM_ADDR)gWeights.GetValue(weightsOffset + 3),
                            cos_sin_cache_addr, positions_addr, slot_mapping_addr, key_cache_addr, value_cache_addr, kv_block_stride, blockIdx, AIV_NUM);
        }

        if ASCEND_IS_AIC {
            fa_aic(tasks_addr, tasks_size, q_addr, q_size, scaling, key_cache_addr, value_cache_addr, 
                    block_table_addr, block_table_size, cu_q_lens_addr, kv_lens_addr, mask_addr, fa_ws_addr, kv_block_stride, blockIdx, AIC_NUM);
        } else {
            fa_aiv(tasks_addr, tasks_size, q_addr, q_size, scaling, key_cache_addr, value_cache_addr, 
                    block_table_addr, block_table_size, cu_q_lens_addr, kv_lens_addr, mask_addr, fa_ws_addr, kv_block_stride, blockIdx, AIC_NUM);
        }

        if ASCEND_IS_AIC {
            matmul_aic(q_addr, (GM_ADDR)gWeights.GetValue(weightsOffset + 6), hidden_states_addr, num_tokens, q_size, hidden_dim, blockIdx, AIC_NUM);
        }

        if ASCEND_IS_AIV {
            add_rms_norm_aiv(hidden_states_addr, residual_addr, (GM_ADDR)gWeights.GetValue(weightsOffset + 7), num_tokens, hidden_dim, blockIdx, AIV_NUM);
        }

        if ASCEND_IS_AIC {
            matmul_aic(hidden_states_addr, (GM_ADDR)gWeights.GetValue(weightsOffset + 8), gate_up_addr, num_tokens, hidden_dim, gate_up_dim, blockIdx, AIC_NUM);
        }

        if ASCEND_IS_AIV {
            swi_glu_aiv(gate_up_addr, silu_addr, num_tokens, silu_dim, blockIdx, AIV_NUM);
        }

        if ASCEND_IS_AIC {
            matmul_aic(silu_addr, (GM_ADDR)gWeights.GetValue(weightsOffset + 9), hidden_states_addr, num_tokens, silu_dim, hidden_dim, blockIdx, AIC_NUM);
        }

    }
    if ASCEND_IS_AIV {
        add_rms_norm_aiv(hidden_states_addr, residual_addr, (GM_ADDR)gWeights.GetValue(layer_num * 10), num_tokens, hidden_dim, blockIdx, AIV_NUM);
        AscendC::PipeBarrier<PIPE_ALL>();
    } else {
        wait_all_aiv();
    }
}

__global__ __mix__(1, 2) void qwen3_4b_14b_910b_dbf_kernel(
                                const int num_reqs_0, const int num_tokens_0, const int num_tokens_1, 
                                GM_ADDR weights_params_addr, const int layer_num, GM_ADDR cos_sin_cache_addr, 
                                const int hidden_dim, const int q_size, const int gate_up_dim, const float scaling, const int64_t kv_block_stride, 
                                GM_ADDR positions_addr, GM_ADDR slot_mapping_addr, 
                                GM_ADDR tasks_0_addr, const int tasks_0_size, GM_ADDR cu_q_lens_0_addr, 
                                GM_ADDR tasks_1_addr, const int tasks_1_size, GM_ADDR cu_q_lens_1_addr, 
                                GM_ADDR kv_lens_addr, GM_ADDR block_table_addr, const int block_table_size, 
                                GM_ADDR mask_addr, GM_ADDR fa_ws_addr, 
                                GM_ADDR hidden_states_addr, GM_ADDR residual_addr, 
                                GM_ADDR qkv_addr, GM_ADDR q_addr, 
                                GM_ADDR gate_up_addr, GM_ADDR silu_addr,
                                const int AIC_NUM, const int AIV_NUM)
{
    AscendC::InitSocState();
    AscendC::GlobalTensor<int64_t> gWeights;
    gWeights.SetGlobalBuffer((__gm__ int64_t*)weights_params_addr);
    const int qkv_dim = q_size + 2 * KV_SIZE;
    const int silu_dim = gate_up_dim / 2;
    const int blockIdx = AscendC::GetBlockIdx();

    GM_ADDR positions_0_addr = positions_addr;
    GM_ADDR positions_1_addr = positions_addr + sizeof(int32_t) * num_tokens_0;
    GM_ADDR slot_mapping_0_addr = slot_mapping_addr;
    GM_ADDR slot_mapping_1_addr = slot_mapping_addr + sizeof(int32_t) * num_tokens_0;
    GM_ADDR kv_lens_0_addr = kv_lens_addr;
    GM_ADDR kv_lens_1_addr = kv_lens_addr + sizeof(int32_t) * num_reqs_0;
    GM_ADDR block_table_0_addr = block_table_addr;
    GM_ADDR block_table_1_addr = block_table_addr + sizeof(int32_t) * num_reqs_0 * block_table_size;
    GM_ADDR hidden_states_0_addr = hidden_states_addr;
    GM_ADDR hidden_states_1_addr = hidden_states_addr + sizeof(bfloat16_t) * num_tokens_0 * hidden_dim;
    GM_ADDR residual_0_addr = residual_addr;
    GM_ADDR residual_1_addr = residual_addr + sizeof(bfloat16_t) * num_tokens_0 * hidden_dim;
    GM_ADDR qkv_0_addr = qkv_addr;
    GM_ADDR qkv_1_addr = qkv_addr + sizeof(bfloat16_t) * num_tokens_0 * qkv_dim;
    GM_ADDR q_0_addr = q_addr;
    GM_ADDR q_1_addr = q_addr + sizeof(bfloat16_t) * num_tokens_0 * q_size;
    GM_ADDR gate_up_0_addr = gate_up_addr;
    GM_ADDR gate_up_1_addr = gate_up_addr + sizeof(bfloat16_t) * num_tokens_0 * gate_up_dim;
    GM_ADDR silu_0_addr = silu_addr;
    GM_ADDR silu_1_addr = silu_addr + sizeof(bfloat16_t) * num_tokens_0 * gate_up_dim / 2;

    if ASCEND_IS_AIC {
        AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(PAIR_A2V);
        AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(PAIR_A2V);
    } else {
        add_rms_norm_aiv(hidden_states_0_addr, residual_0_addr, (GM_ADDR)gWeights.GetValue(0), num_tokens_0, hidden_dim, blockIdx, AIV_NUM);
    }
    for (int i = 0; i < layer_num; ++i) {
        const int weightsOffset = i * 10;
        auto qkv_weight_addr = (GM_ADDR)gWeights.GetValue(weightsOffset + 1);
        auto qnorm_gamma_fp32_addr = (GM_ADDR)gWeights.GetValue(weightsOffset + 2);
        auto knorm_gamma_fp32_addr = (GM_ADDR)gWeights.GetValue(weightsOffset + 3);
        auto key_cache_addr = (GM_ADDR)gWeights.GetValue(weightsOffset + 4);
        auto value_cache_addr = (GM_ADDR)gWeights.GetValue(weightsOffset + 5);
        auto o_weight_addr = (GM_ADDR)gWeights.GetValue(weightsOffset + 6);
        auto post_norm_gamma_fp32_addr = (GM_ADDR)gWeights.GetValue(weightsOffset + 7);
        auto gate_up_weight_addr = (GM_ADDR)gWeights.GetValue(weightsOffset + 8);
        auto down_weight_addr = (GM_ADDR)gWeights.GetValue(weightsOffset + 9);

        if ASCEND_IS_AIC {
            matmul_aic(hidden_states_0_addr, qkv_weight_addr, qkv_0_addr, num_tokens_0, hidden_dim, qkv_dim, blockIdx, AIC_NUM);
        } else {
            add_rms_norm_aiv(hidden_states_1_addr, residual_1_addr, (GM_ADDR)gWeights.GetValue(weightsOffset), num_tokens_1, hidden_dim, blockIdx, AIV_NUM);
        }

        if ASCEND_IS_AIC {
            matmul_aic(hidden_states_1_addr, qkv_weight_addr, qkv_1_addr, num_tokens_1, hidden_dim, qkv_dim, blockIdx, AIC_NUM);
        } else {
            split_qkv_rmsnorm_mrope_kv_cache_aiv(qkv_0_addr, q_0_addr, num_tokens_0, q_size, 
                            qnorm_gamma_fp32_addr, knorm_gamma_fp32_addr, cos_sin_cache_addr, 
                            positions_0_addr, slot_mapping_0_addr, key_cache_addr, value_cache_addr, kv_block_stride, blockIdx, AIV_NUM);
        }

        if ASCEND_IS_AIC {
            fa_aic(tasks_0_addr, tasks_0_size, q_0_addr, q_size, scaling, key_cache_addr, value_cache_addr, 
                    block_table_0_addr, block_table_size, cu_q_lens_0_addr, kv_lens_0_addr, mask_addr, fa_ws_addr, kv_block_stride, blockIdx, AIC_NUM);
        } else {
            fa_aiv(tasks_0_addr, tasks_0_size, q_0_addr, q_size, scaling, key_cache_addr, value_cache_addr, 
                    block_table_0_addr, block_table_size, cu_q_lens_0_addr, kv_lens_0_addr, mask_addr, fa_ws_addr, kv_block_stride, blockIdx, AIC_NUM);
        }
        
        if ASCEND_IS_AIC {
            matmul_aic(q_0_addr, o_weight_addr, hidden_states_0_addr, num_tokens_0, q_size, hidden_dim, blockIdx, AIC_NUM);
        } else {
            split_qkv_rmsnorm_mrope_kv_cache_aiv(qkv_1_addr, q_1_addr, num_tokens_1, q_size, 
                            qnorm_gamma_fp32_addr, knorm_gamma_fp32_addr, cos_sin_cache_addr, 
                            positions_1_addr, slot_mapping_1_addr, key_cache_addr, value_cache_addr, kv_block_stride, blockIdx, AIV_NUM);
        }

        if ASCEND_IS_AIC {
            fa_aic(tasks_1_addr, tasks_1_size, q_1_addr, q_size, scaling, key_cache_addr, value_cache_addr, 
                    block_table_1_addr, block_table_size, cu_q_lens_1_addr, kv_lens_1_addr, mask_addr, fa_ws_addr, kv_block_stride, blockIdx, AIC_NUM);
        } else {
            fa_aiv(tasks_1_addr, tasks_1_size, q_1_addr, q_size, scaling, key_cache_addr, value_cache_addr, 
                    block_table_1_addr, block_table_size, cu_q_lens_1_addr, kv_lens_1_addr, mask_addr, fa_ws_addr, kv_block_stride, blockIdx, AIC_NUM);
        }

        if ASCEND_IS_AIC {
            matmul_aic(q_1_addr, o_weight_addr, hidden_states_1_addr, num_tokens_1, q_size, hidden_dim, blockIdx, AIC_NUM);
        } else {
            add_rms_norm_aiv(hidden_states_0_addr, residual_0_addr, post_norm_gamma_fp32_addr, num_tokens_0, hidden_dim, blockIdx, AIV_NUM);
        }

        if ASCEND_IS_AIC {
            matmul_aic(hidden_states_0_addr, gate_up_weight_addr, gate_up_0_addr, num_tokens_0, hidden_dim, gate_up_dim, blockIdx, AIC_NUM);
        } else {
            add_rms_norm_aiv(hidden_states_1_addr, residual_1_addr, post_norm_gamma_fp32_addr, num_tokens_1, hidden_dim, blockIdx, AIV_NUM);
        }

        if ASCEND_IS_AIC {
            matmul_aic(hidden_states_1_addr, gate_up_weight_addr, gate_up_1_addr, num_tokens_1, hidden_dim, gate_up_dim, blockIdx, AIC_NUM);
        } else {
            swi_glu_aiv(gate_up_0_addr, silu_0_addr, num_tokens_0, silu_dim, blockIdx, AIV_NUM);
        }

        if ASCEND_IS_AIC {
            matmul_aic(silu_0_addr, down_weight_addr, hidden_states_0_addr, num_tokens_0, silu_dim, hidden_dim, blockIdx, AIC_NUM);
        } else {
            swi_glu_aiv(gate_up_1_addr, silu_1_addr, num_tokens_1, silu_dim, blockIdx, AIV_NUM);
        }

        if ASCEND_IS_AIC {
            matmul_aic(silu_1_addr, down_weight_addr, hidden_states_1_addr, num_tokens_1, silu_dim, hidden_dim, blockIdx, AIC_NUM);
        } else {
            if (i == layer_num - 1) {
                add_rms_norm_aiv(hidden_states_0_addr, residual_0_addr, (GM_ADDR)gWeights.GetValue(layer_num * 10), num_tokens_0, hidden_dim, blockIdx, AIV_NUM);
            } else {
                add_rms_norm_aiv(hidden_states_0_addr, residual_0_addr, (GM_ADDR)gWeights.GetValue(weightsOffset + 10), num_tokens_0, hidden_dim, blockIdx, AIV_NUM);
            }
        }
    }
    if ASCEND_IS_AIV {
        add_rms_norm_aiv(hidden_states_1_addr, residual_1_addr, (GM_ADDR)gWeights.GetValue(layer_num * 10), num_tokens_1, hidden_dim, blockIdx, AIV_NUM);
        AscendC::PipeBarrier<PIPE_ALL>();
    } else {
        wait_all_aiv();
        wait_all_aiv();
    }
}

// ========================= interface ========================= 

int64_t qwen3_4b_14b_910b_npu(const int64_t num_tokens, 
                           const torch::Tensor &weights_params, const int64_t layer_num, const torch::Tensor &cos_sin_cache, 
                           const int64_t hidden_dim, const int64_t q_size, const int64_t gate_up_dim, const double scaling, const int64_t kv_block_stride, 
                           const torch::Tensor &positions, const torch::Tensor &slot_mapping, 
                           const torch::Tensor &tasks, const torch::Tensor &cu_q_lens, const torch::Tensor &kv_lens, 
                           const torch::Tensor &block_table, const torch::Tensor &mask, const torch::Tensor &fa_ws, 
                           const torch::Tensor &hidden_states, const torch::Tensor &residual, 
                           const torch::Tensor &qkv, const torch::Tensor &q, 
                           const torch::Tensor &gate_up, const torch::Tensor &silu)
{
    const c10::OptionalDeviceGuard guard(weights_params.device());
    auto stream = c10_npu::getCurrentNPUStream().stream(false);
    auto acl_call = [=]() -> int {
        auto ascendcPlatform = *(platform_ascendc::PlatformAscendCManager::GetInstance());
        auto AIC_NUM = ascendcPlatform.GetCoreNumAic();
        auto AIV_NUM = ascendcPlatform.GetCoreNumAiv();
        qwen3_4b_14b_910b_kernel<<<AIC_NUM, nullptr, stream>>>(
                    num_tokens, (GM_ADDR)weights_params.data_ptr(), layer_num, (GM_ADDR)cos_sin_cache.data_ptr(), 
                    hidden_dim, q_size, gate_up_dim, (float)scaling, kv_block_stride, 
                    (GM_ADDR)positions.data_ptr(), (GM_ADDR)slot_mapping.data_ptr(),
                    (GM_ADDR)tasks.data_ptr(), tasks.size(1), (GM_ADDR)cu_q_lens.data_ptr(), (GM_ADDR)kv_lens.data_ptr(),
                    (GM_ADDR)block_table.data_ptr(), block_table.size(1), (GM_ADDR)mask.data_ptr(), (GM_ADDR)fa_ws.data_ptr(), 
                    (GM_ADDR)hidden_states.data_ptr(), (GM_ADDR)residual.data_ptr(), 
                    (GM_ADDR)qkv.data_ptr(), (GM_ADDR)q.data_ptr(), 
                    (GM_ADDR)gate_up.data_ptr(), (GM_ADDR)silu.data_ptr(), AIC_NUM, AIV_NUM);
        return 0;
    };
    at_npu::native::OpCommand::RunOpApi("qwen3_4b_14b_910b_npu", acl_call);
    return 0;
}

