//
// Lossless StateTree decode + BF16 GEMM for Ascend 950 / dav-3510.
// Adapted from https://github.com/ammarali32/StateTree-Representation.
// The reconstructed weight exists only in AIV UB, AIC L1, and L0B. There is
// no dense-weight GM workspace on the fused path.
#include <cstdint>
#include "c_api/asc_simd.h"
#include "acl/acl.h"

#ifndef ST_BN
#define ST_BN 128
#endif
#ifndef ST_BK
#define ST_BK 256
#endif
#ifndef ST_BM
#define ST_BM 16
#endif
#ifndef ST_ES
#define ST_ES 8
#endif

constexpr int BN = ST_BN;
constexpr int BK = ST_BK;
constexpr int BM = ST_BM;
constexpr int ES = ST_ES;
constexpr int LEAF_BYTES = BN * BK / 2;
constexpr int STATE_BYTES = BN * BK / 4;
constexpr int NODE_BYTES = BN * BK / 64;
constexpr int PATCH_OFFSET = LEAF_BYTES + STATE_BYTES + NODE_BYTES;
constexpr int RECORD_BYTES = PATCH_OFFSET + ES * 8;
#define ST_VECTORS 2
constexpr int VEC_COUNT = ST_VECTORS;
constexpr int CHUNKS = 2 / VEC_COUNT;
constexpr int BANK_BYTES = BN * BK + RECORD_BYTES + 256;
constexpr int BANKS =
    (4 * BANK_BYTES <= 248 * 1024 && 131072 + 8 * BN * BK <= 512 * 1024)
        ? 4
        : ((3 * BANK_BYTES <= 248 * 1024 &&
            131072 + 6 * BN * BK <= 512 * 1024)
               ? 3
               : 2);
constexpr bool L0_PINGPONG = BM >= 32;
constexpr int CK_MAX =
    (L0_PINGPONG ? 16384 : 32768) / (BM > BN ? BM : BN) / 64 * 64;
constexpr int CK = BK < CK_MAX ? BK : CK_MAX;
constexpr int AK = 32768 / BM;
static_assert(BK % CK == 0 && CK % 64 == 0);

__aicore__ inline void weight_arrive(pipe_t pipe, int64_t flag) {
    if constexpr (VEC_COUNT == 1)
        asc_sync_intra_arrive(pipe, flag);
    else
        asc_sync_block_arrive(pipe, flag);
}

__aicore__ inline void weight_wait(pipe_t pipe, int64_t flag) {
    if constexpr (VEC_COUNT == 1)
        asc_sync_intra_wait(pipe, flag);
    else
        asc_sync_block_wait(pipe, flag);
}

__simd_vf__ inline void decode_nz(
    __ubuf__ uint32_t* dst, __ubuf__ uint16_t* leaves,
    __ubuf__ uint8_t* states, __ubuf__ uint16_t* nodes,
    __ubuf__ uint32_t* positions, __ubuf__ uint32_t* values) {
    constexpr int HALF_N = BN / 2;
    auto m16 = asc_create_mask_b16(PAT_ALL);
    auto m32 = asc_create_mask_b32(PAT_ALL);
    auto m8 = asc_create_mask_b8(PAT_ALL);
    auto idx_signed = asc_arange(int16_t(0));
    auto idx = asc_shiftright_scalar((vector_uint16_t)idx_signed, 3, m16);
    auto lut_index = (vector_uint8_t)asc_arange(int8_t(0));
    auto lut = asc_or(
        asc_and(lut_index, asc_duplicate_scalar(uint8_t(7), m8), m8),
        asc_shiftleft_scalar(
            asc_and(lut_index, asc_duplicate_scalar(uint8_t(8), m8), m8),
            4, m8),
        m8);
    for (uint32_t group = 0; group < BK / 64; ++group) {
        auto egroup = asc_loadalign(nodes + group * HALF_N);
        for (uint32_t row = 0; row < HALF_N; row += 16) {
            auto eidx = asc_add_scalar(idx, uint16_t(row), m16);
            auto ev = asc_gather(egroup, eidx);
            for (uint32_t fragment = 0; fragment < 4; ++fragment) {
                const uint32_t i = group * HALF_N * 32 +
                    fragment * HALF_N * 8 + row * 8;
                auto lf16 = asc_loadalign(leaves + i);
                auto packed8 = asc_loadalign_unpack(states + i);
                auto d16 = (vector_uint16_t)packed8;
                // The lookup ignores the high nibble of every byte. Replicate
                // the packed byte four bits left without a redundant mask.
                auto ds = asc_or(d16, asc_shiftleft_scalar(d16, 4, m16), m16);
                // Expand one nibble to exponent delta + sign*128, then rebuild
                // the exact high BF16 byte with byte subtraction.
                auto expanded = asc_gather(lut, (vector_uint8_t)ds);
                auto ep = asc_sub((vector_uint8_t)ev, expanded, m8);
                vector_uint8_t joined0, joined1;
                asc_intlv(
                    joined0, joined1, (vector_uint8_t)lf16,
                    (vector_uint8_t)ep);
                asc_storealign(dst + i, (vector_uint32_t)joined0, m32);
                asc_storealign(dst + i + 64, (vector_uint32_t)joined1, m32);
            }
        }
    }

    // Rare exceptional pairs are patched before the tile leaves UB. Positions
    // are uint32 element indices; padding carries UINT32_MAX.
    asc_mem_bar(VST_VST);
    for (uint32_t i = 0; i < ES; i += 64) {
        uint32_t count = ES - i < 64 ? ES - i : 64;
        auto valid = asc_update_mask_b32(count);
        auto pos = asc_loadalign(positions + i);
        auto val = asc_loadalign(values + i);
        auto mask = asc_lt_scalar(
            pos, uint32_t(HALF_N * BK / 2), valid);
        asc_scatter(dst, val, pos, mask);
    }
}

__global__ __mix__(1, 2) void statetree_fused(
    __gm__ uint8_t* payload, __gm__ bfloat16_t* x, __gm__ bfloat16_t* y,
    uint32_t m, uint32_t n, uint32_t k) {
    asc_init();
    if ASC_IS_AIV {
        if constexpr (VEC_COUNT == 1) {
            if (asc_get_sub_block_id() != 0) return;
        }
    }
    __ubuf__ uint32_t decoded[BANKS][CHUNKS * BN / 2 * BK / 2];
    __ubuf__ uint8_t inputs[BANKS][CHUNKS * RECORD_BYTES + 256];
    auto a1 = reinterpret_cast<__cbuf__ bfloat16_t*>(0);
    auto b1 = reinterpret_cast<__cbuf__ bfloat16_t*>(131072);
    auto a0 = reinterpret_cast<__ca__ bfloat16_t*>(0);
    auto b0 = reinterpret_cast<__cb__ bfloat16_t*>(0);
    auto c0 = reinterpret_cast<__cc__ float*>(0);
    constexpr int READY = 0, FREE = 4;
    uint32_t sequence = 0;
    const uint32_t nt = (n + BN - 1) / BN;
    const uint32_t tasks = nt * ((m + BM - 1) / BM);
    if ASC_IS_AIC {
        for (uint32_t i = 0; i < BANKS; ++i)
            weight_arrive(PIPE_MTE1, FREE + i);
        if constexpr (L0_PINGPONG) {
            asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID4);
            asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID5);
        }
    }
    for (uint32_t task = block_idx; task < tasks; task += block_num) {
        const uint32_t tn = task % nt, tm = task / nt;
        const uint32_t mr = m - tm * BM < BM ? m - tm * BM : BM;
        const uint32_t nr = n - tn * BN < BN ? n - tn * BN : BN;
        const uint32_t aligned_m = (mr + 15) / 16 * 16;
        if ASC_IS_AIC {
            asc_set_gm2l1_nz_para(1, 1, BM, 0);
            asc_copy_gm2l1_nd2nz(
                a1, x + tm * BM * k, k * sizeof(bfloat16_t),
                asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM, mr,
                k < AK ? k : AK, 0, false);
            asc_sync_notify(PIPE_MTE2, PIPE_MTE1, EVENT_ID4);
        }
        for (uint32_t ki = 0; ki < k / BK; ++ki) {
            const uint32_t bank = sequence++ % BANKS;
            const auto event = static_cast<event_t>(bank);
            auto weight_l1 = b1 + bank * BN * BK;
            if ASC_IS_AIV {
                if (sequence > BANKS)
                    asc_sync_wait(PIPE_V, PIPE_MTE2, event);
                const uint32_t tile = tn * (k / BK) + ki;
                const uint32_t unit =
                    tile * 2 + asc_get_sub_block_id() * CHUNKS;
                // Stream immutable weights without allocating L2 lines. The
                // default policy evicts dirty recurrent state in full-model
                // execution even though isolated GEMM timing is unaffected.
                asc_copy_gm2ub_align(
                    inputs[bank], payload + uint64_t(unit) * RECORD_BYTES,
                    1, CHUNKS * RECORD_BYTES, 0, 0, false,
                    asc_load_l2_cache_mode::NOTALLOC_KEEP, 0, 0);
                asc_sync_notify(PIPE_MTE2, PIPE_V, event);
                asc_sync_wait(PIPE_MTE2, PIPE_V, event);
                weight_wait(PIPE_V, FREE + bank);
                for (uint32_t chunk = 0; chunk < CHUNKS; ++chunk) {
                    auto input = inputs[bank] + chunk * RECORD_BYTES;
                    auto output = decoded[bank] + chunk * BN * BK / 4;
                    asc_vf_call<decode_nz>(
                        output,
                        reinterpret_cast<__ubuf__ uint16_t*>(input),
                        input + LEAF_BYTES,
                        reinterpret_cast<__ubuf__ uint16_t*>(
                            input + LEAF_BYTES + STATE_BYTES),
                        reinterpret_cast<__ubuf__ uint32_t*>(
                            input + PATCH_OFFSET),
                        reinterpret_cast<__ubuf__ uint32_t*>(
                            input + PATCH_OFFSET + ES * 4));
                    asc_sync_notify(PIPE_V, PIPE_MTE3, event);
                    asc_sync_wait(PIPE_V, PIPE_MTE3, event);
                    asc_copy_ub2l1(
                        weight_l1 +
                            (asc_get_sub_block_id() * CHUNKS + chunk) *
                                (BN / 2) * 16,
                        output, BK / 16, BN / 2, 0, BN / 2);
                }
                asc_sync_notify(PIPE_V, PIPE_MTE2, event);
                weight_arrive(PIPE_MTE3, READY + bank);
            }
            if ASC_IS_AIC {
                for (uint32_t ks = 0; ks < BK; ks += CK) {
                    const uint32_t absolute_k = ki * BK + ks;
                    const uint32_t l0_bank =
                        L0_PINGPONG ? (absolute_k / CK) & 1 : 0;
                    const auto l0_event = static_cast<event_t>(l0_bank);
                    auto activation_l0 = a0 + l0_bank * 16384;
                    auto weight_l0 = b0 + l0_bank * 16384;
                    const uint32_t activation_offset = absolute_k % AK;
                    const uint32_t activation_bank = (absolute_k / AK) & 1;
                    const auto activation_event =
                        static_cast<event_t>(4 + activation_bank);
                    if (activation_offset == 0) {
                        asc_sync_wait(
                            PIPE_MTE2, PIPE_MTE1, activation_event);
                        const uint32_t next_k = absolute_k + AK;
                        if (next_k < k) {
                            const auto next_event = static_cast<event_t>(
                                4 + (activation_bank ^ 1));
                            if (absolute_k >= AK)
                                asc_sync_wait(
                                    PIPE_MTE1, PIPE_MTE2, next_event);
                            const uint32_t amount =
                                k - next_k < AK ? k - next_k : AK;
                            asc_set_gm2l1_nz_para(1, 1, BM, 0);
                            asc_copy_gm2l1_nd2nz(
                                a1 + (activation_bank ^ 1) * 32768,
                                x + tm * BM * k + next_k,
                                k * sizeof(bfloat16_t),
                                asc_load_l2_cache_mode::NORMAL_FIRST_VICTIM,
                                mr, amount, 0, false);
                            asc_sync_notify(
                                PIPE_MTE2, PIPE_MTE1, next_event);
                        }
                    }
                    if (ks == 0)
                        weight_wait(PIPE_MTE1, READY + bank);
                    if constexpr (L0_PINGPONG) {
                        asc_sync_wait(
                            PIPE_M, PIPE_MTE1,
                            static_cast<event_t>(4 + l0_bank));
                    }
                    asc_copy_l12l0a(
                        activation_l0,
                        a1 + activation_bank * 32768 +
                            activation_offset * BM,
                        0, 0, aligned_m / 16, CK / 16, BM / 16,
                        aligned_m / 16);
                    asc_copy_l12l0b(
                        weight_l0, weight_l1 + ks * BN, 0, 0,
                        BN / 16, CK / 16, BN / 16, BN / 16);
                    if (ks + CK == BK)
                        weight_arrive(PIPE_MTE1, FREE + bank);
                    if (activation_offset + CK == AK ||
                        absolute_k + CK == k) {
                        asc_sync_notify(
                            PIPE_MTE1, PIPE_MTE2, activation_event);
                    }
                    asc_sync_notify(PIPE_MTE1, PIPE_M, l0_event);
                    asc_sync_wait(PIPE_MTE1, PIPE_M, l0_event);
                    asc_mmad(
                        c0, activation_l0, weight_l0, mr, CK, BN,
                        asc_unit_flag_mode::DISABLE, true, false,
                        ki == 0 && ks == 0);
                    if constexpr (L0_PINGPONG) {
                        asc_sync_notify(
                            PIPE_M, PIPE_MTE1,
                            static_cast<event_t>(4 + l0_bank));
                    } else {
                        asc_sync_notify(PIPE_M, PIPE_MTE1, EVENT_ID0);
                        asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID0);
                    }
                }
            }
        }
        if ASC_IS_AIC {
            asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID4);
            if (k > AK)
                asc_sync_wait(PIPE_MTE1, PIPE_MTE2, EVENT_ID5);
            asc_sync_notify(PIPE_M, PIPE_FIX, EVENT_ID0);
            asc_sync_wait(PIPE_M, PIPE_FIX, EVENT_ID0);
            asc_set_l0c_copy_nz_para(1, 0, 0);
            asc_copy_l0c2gm(
                y + tm * BM * n + tn * BN, c0, nr, mr, n, aligned_m,
                asc_store_l2_cache_mode::NORMAL_FIRST_VICTIM,
                asc_unit_flag_mode::DISABLE, QuantMode_t::F322BF16,
                asc_relu_pre_mode::NONE, false, true, false, false);
            asc_sync_notify(PIPE_FIX, PIPE_M, EVENT_ID0);
            asc_sync_wait(PIPE_FIX, PIPE_M, EVENT_ID0);
        }
    }
    if ASC_IS_AIV {
        for (uint32_t i = 0; i < BANKS; ++i) {
            if (sequence > i)
                asc_sync_wait(
                    PIPE_V, PIPE_MTE2, static_cast<event_t>(i));
            weight_wait(PIPE_V, FREE + i);
        }
    }
    if ASC_IS_AIC {
        if constexpr (L0_PINGPONG) {
            asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID4);
            asc_sync_wait(PIPE_M, PIPE_MTE1, EVENT_ID5);
        }
    }
    asc_sync();
}

extern "C" int statetree_launch(
    void* stream, void* payload, void* x, void* y,
    uint32_t m, uint32_t n, uint32_t k) {
    const uint32_t tasks =
        ((n + BN - 1) / BN) * ((m + BM - 1) / BM);
    // Twenty producer/consumer groups saturate compressed reads. Balance the
    // final wave instead of leaving a few groups with an extra tile.
    const uint32_t cores = m <= 64 ? 20 : 28;
    const uint32_t waves = (tasks + cores - 1) / cores;
    const uint32_t blocks = (tasks + waves - 1) / waves;
    statetree_fused<<<blocks, 0, stream>>>(
        static_cast<uint8_t*>(payload), static_cast<bfloat16_t*>(x),
        static_cast<bfloat16_t*>(y), m, n, k);
    return 0;
}

// Large prefills use the native GEMM accumulation schedule. Decode directly
// to its row-major input using strided DMA: no full-sized NZ intermediate or
// follow-up transpose/copy. Independent banks overlap load, decode and store.
__global__ __vector__ void statetree_decode_dense(
    __gm__ uint8_t* payload, __gm__ uint32_t* output,
    uint32_t units, uint32_t n, uint32_t k)
{
    asc_init();
    constexpr uint32_t PAIRS = BN / 2 * BK / 2;
    __ubuf__ uint32_t decoded[BANKS][PAIRS];
    __ubuf__ uint8_t input[BANKS][RECORD_BYTES + 256];
    uint32_t sequence = 0;
    for (uint32_t unit = block_idx; unit < units; unit += block_num) {
        const uint32_t bank = sequence++ % BANKS;
        const auto event = static_cast<event_t>(bank);
        if (sequence > BANKS) asc_sync_wait(PIPE_V, PIPE_MTE2, event);
        asc_copy_gm2ub_align(input[bank], payload + uint64_t(unit) * RECORD_BYTES,
            1, RECORD_BYTES, 0, 0, false, asc_load_l2_cache_mode::NOTALLOC_KEEP, 0, 0);
        asc_sync_notify(PIPE_MTE2, PIPE_V, event);
        asc_sync_wait(PIPE_MTE2, PIPE_V, event);
        if (sequence > BANKS) asc_sync_wait(PIPE_MTE3, PIPE_V, event);
        asc_vf_call<decode_nz>(decoded[bank],
            reinterpret_cast<__ubuf__ uint16_t*>(input[bank]), input[bank] + LEAF_BYTES,
            reinterpret_cast<__ubuf__ uint16_t*>(input[bank] + LEAF_BYTES + STATE_BYTES),
            reinterpret_cast<__ubuf__ uint32_t*>(input[bank] + PATCH_OFFSET),
            reinterpret_cast<__ubuf__ uint32_t*>(input[bank] + PATCH_OFFSET + ES * 4));
        asc_sync_notify(PIPE_V, PIPE_MTE2, event);
        asc_sync_notify(PIPE_V, PIPE_MTE3, event);
        asc_sync_wait(PIPE_V, PIPE_MTE3, event);
        const uint32_t row = (unit / (2 * (k / BK))) * BN + (unit % 2) * (BN / 2);
        const uint32_t col = (unit / 2 % (k / BK)) * BK;
        const uint32_t rows = row >= n ? 0 : (n - row < BN / 2 ? n - row : BN / 2);
        if (rows) {
            // Traverse a row's K fragments consecutively so writeback fills
            // cache lines, instead of scattering 32-byte writes across rows.
            asc_set_ub2gm_loop_size(rows, 1);
            asc_set_ub2gm_loop1_stride(32, uint64_t(k) * 2);
            asc_set_ub2gm_loop2_stride(0, 0);
            asc_copy_ub2gm_align(output + (uint64_t(row) * k + col) / 2,
                decoded[bank], BK / 16, 32, asc_store_l2_cache_mode::NOTALLOC_CLEAN,
                32, (BN / 2) * 32);
            asc_set_ub2gm_loop_size(1, 1);
        }
        asc_sync_notify(PIPE_MTE3, PIPE_V, event);
    }
    for (uint32_t bank = 0; bank < BANKS && bank < sequence; ++bank) {
        asc_sync_wait(PIPE_V, PIPE_MTE2, static_cast<event_t>(bank));
        asc_sync_wait(PIPE_MTE3, PIPE_V, static_cast<event_t>(bank));
    }
    asc_sync();
}

extern "C" int statetree_decode_launch(void* stream, void* payload, void* output,
    uint32_t units, uint32_t n, uint32_t k)
{
    statetree_decode_dense<<<units < 56 ? units : 56, 0, stream>>>(
        static_cast<uint8_t*>(payload),
        static_cast<uint32_t*>(output), units, n, k);
    return 0;
}
