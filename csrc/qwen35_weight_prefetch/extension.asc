#include <torch/extension.h>
#include "torch_npu/csrc/core/npu/NPUGuard.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"

namespace {
constexpr uint32_t kChunkBytes = 32768;
constexpr uint32_t kMaxExperts = 256;

class RoutedWarm {
public:
    __aicore__ inline void Run(GM_ADDR weight, GM_ADDR groups, GM_ADDR done,
                              uint64_t expertBytes, uint64_t budget, uint32_t experts,
                              uint32_t cores, bool control)
    {
        const uint32_t core = AscendC::GetBlockIdx();
        AscendC::TPipe pipe;
        AscendC::TBuf<AscendC::TPosition::VECCALC> countsBuf, weightsBuf, doneBuf;
        pipe.InitBuffer(countsBuf, kMaxExperts * sizeof(int64_t));
        pipe.InitBuffer(weightsBuf, kChunkBytes);
        pipe.InitBuffer(doneBuf, 4 * sizeof(int64_t));
        auto counts = countsBuf.Get<int64_t>();
        auto weights = weightsBuf.Get<uint16_t>();
        auto result = doneBuf.Get<int64_t>();
        AscendC::GlobalTensor<int64_t> groupsGm, doneGm;
        AscendC::GlobalTensor<uint16_t> weightsGm;
        groupsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(groups), experts);
        doneGm.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(done), cores * 4);
        weightsGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t *>(weight), experts * expertBytes / 2);
        // CANN 8.5 DataCopyPad accepts non-32-byte-aligned GM->UB copies and
        // pads the local transfer to 32 bytes. Since experts <= kMaxExperts,
        // that padding fits countsBuf; only int64_t alignment is required.
        AscendC::DataCopyExtParams groupCopy{1, static_cast<uint32_t>(experts * sizeof(int64_t)), 0, 0, 0};
        AscendC::DataCopyPadExtParams<int64_t> groupPad{false, 0, 0, 0};
        AscendC::DataCopyPad(counts, groupsGm, groupCopy, groupPad);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID0);
        uint64_t selectedBytes = 0, copiedBytes = 0, chunks = 0;
        uint64_t lastExpert = 0, checksum = 0;
        for (uint32_t expert = 0; expert < experts && selectedBytes < budget; ++expert) {
            if (counts.GetValue(expert) <= 0) {
                continue;
            }
            const uint64_t remaining = budget - selectedBytes;
            const uint64_t take = remaining < expertBytes ? remaining : expertBytes;
            for (uint64_t offset = 0; offset < take; offset += kChunkBytes) {
                const uint64_t ordinal = (selectedBytes + offset) / kChunkBytes;
                if (ordinal % cores != core) {
                    continue;
                }
                const uint32_t bytes = static_cast<uint32_t>(
                    (take - offset) < kChunkBytes ? (take - offset) : kChunkBytes);
                if (!control) {
                    AscendC::DataCopyExtParams cp{1, bytes, 0, 0, 0};
                    AscendC::DataCopyPadExtParams<uint16_t> pad{false, 0, 0, 0};
                    AscendC::DataCopyPad(weights, weightsGm[(expert * expertBytes + offset) / 2], cp, pad);
                    AscendC::SetFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID1);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE2_S>(EVENT_ID1);
                    checksum ^= weights.GetValue(0);
                }
                copiedBytes += bytes;
                ++chunks;
                lastExpert = expert;
            }
            selectedBytes += take;
        }
        result.SetValue(0, static_cast<int64_t>(copiedBytes));
        result.SetValue(1, static_cast<int64_t>(chunks));
        result.SetValue(2, static_cast<int64_t>(lastExpert));
        result.SetValue(3, static_cast<int64_t>(checksum));
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
        AscendC::DataCopy(doneGm[core * 4], result, 4);
        AscendC::PipeBarrier<PIPE_MTE3>();
    }
};
}

extern "C" __global__ __aicore__ void qwen35_routed_warm_kernel(
    GM_ADDR weight, GM_ADDR groups, GM_ADDR done, uint64_t expertBytes,
    uint64_t budget, uint32_t experts, uint32_t cores, bool control)
{
    KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
    RoutedWarm kernel;
    kernel.Run(weight, groups, done, expertBytes, budget, experts, cores, control);
}

void Warm(const at::Tensor &weight, const at::Tensor &groups, at::Tensor done,
          int64_t budget, int64_t cores, bool control)
{
    for (const auto &tensor : {weight, groups, done}) {
        TORCH_CHECK(tensor.device().type() == c10::DeviceType::PrivateUse1 && tensor.is_contiguous(),
                    "warm inputs must be contiguous NPU tensors");
        TORCH_CHECK(tensor.device() == weight.device(), "all warm inputs must share a device");
    }
    TORCH_CHECK(weight.scalar_type() == at::kBFloat16 && weight.dim() == 3, "expected BF16 [E,K,N]");
    TORCH_CHECK(groups.scalar_type() == at::kLong && groups.dim() == 1 &&
                groups.numel() == weight.size(0) && groups.numel() <= kMaxExperts,
                "expected int64 expert counts, E <= 256");
    TORCH_CHECK(done.scalar_type() == at::kLong && done.dim() == 2 && done.size(0) == cores && done.size(1) == 4,
                "done must have shape [cores,4]");
    TORCH_CHECK(cores == 1 || cores == 2 || cores == 4, "unsupported vector core count");
    const uint64_t expertBytes = weight.size(1) * weight.size(2) * weight.element_size();
    TORCH_CHECK(expertBytes > 0 && expertBytes % kChunkBytes == 0, "expert byte size must align to 32 KiB");
    TORCH_CHECK(budget > 0 && budget <= weight.numel() * weight.element_size() && budget % 32 == 0,
                "invalid byte budget");
    const c10_npu::OptionalNPUGuard deviceGuard(weight.device());
    // Drain pending host submissions before issuing a direct ACL kernel launch.
    auto stream = c10_npu::getCurrentNPUStream().stream(true);
    qwen35_routed_warm_kernel<<<static_cast<uint32_t>(cores), nullptr, stream>>>(
        reinterpret_cast<uint8_t *>(weight.data_ptr()), reinterpret_cast<uint8_t *>(groups.data_ptr()),
        reinterpret_cast<uint8_t *>(done.data_ptr()), expertBytes, budget,
        static_cast<uint32_t>(weight.size(0)), static_cast<uint32_t>(cores), control);
}

PYBIND11_MODULE(TORCH_EXTENSION_NAME, module)
{
    module.def("warm", &Warm, "Route-aware GM to UB weight cache warming");
}
