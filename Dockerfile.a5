FROM quay.io/ascend/cann:9.2.1-950-ubuntu22.04-py3.12

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace

# Install CANN 950 (A5) ops-transformer package.
ARG TARGETPLATFORM
RUN ARCH=${TARGETPLATFORM:-$(uname -m)}; \
    case "$ARCH" in \
        "linux/arm64"|"aarch64") \
            OPS_TRANSFORMER_URL="https://ascend-ci.obs.cn-north-4.myhuaweicloud.com/package/master/20261028/aarch64/cann-950-ops-transformer_9.3.0_linux-aarch64.run" ;; \
        "linux/amd64"|"x86_64") \
            OPS_TRANSFORMER_URL="https://ascend-ci.obs.cn-north-4.myhuaweicloud.com/package/master/20261028/x86_64/cann-950-ops-transformer_9.3.0_linux-x86_64.run" ;; \
        *) echo "Skipping unsupported architecture: $ARCH" && exit 0 ;; \
    esac && \
    wget --quiet "$OPS_TRANSFORMER_URL" -O /tmp/cann-950-ops-transformer.run && \
    chmod +x /tmp/cann-950-ops-transformer.run && \
    /tmp/cann-950-ops-transformer.run --full --quiet --install-for-all && \
    rm -f /tmp/cann-950-ops-transformer.run

# Install clang-15 (for triton-ascend)
RUN apt-get update -y && \
    apt-get install -y git vim wget curl protobuf-compiler libprotobuf-dev net-tools gcc g++ cmake numactl libnuma-dev libibverbs-dev libhiredis-dev clang-15 && \
    update-alternatives --install /usr/bin/clang clang /usr/bin/clang-15 20 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-15 20 && \
    rm -rf /var/cache/apt/* && \
    rm -rf /var/lib/apt/lists/*

# Install vLLM
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_TAG=v0.32.0
ARG VLLM_COMMIT=""
ARG PYTORCH_INDEX_URL="https://download.pytorch.org/whl/cpu/"
ARG CARGO_BUILD_JOBS=16
RUN if [ -n "$VLLM_COMMIT" ]; then \
      git init /vllm-workspace/vllm && \
      git -C /vllm-workspace/vllm fetch --depth 1 $VLLM_REPO "$VLLM_COMMIT" && \
      git -C /vllm-workspace/vllm checkout FETCH_HEAD; \
    else \
      git clone --depth 1 -b $VLLM_TAG $VLLM_REPO /vllm-workspace/vllm; \
    fi && \
    VLLM_TARGET_DEVICE="empty" python3 -m pip install -e /vllm-workspace/vllm/[audio] --extra-index-url ${PYTORCH_INDEX_URL} && \
    # In x86, triton will be installed by vllm. But in Ascend, triton doesn't work correctly. we need to uninstall it.
    python3 -m pip uninstall -y triton && \
    # The same step also builds the optional Rust frontend (vllm-rs).
    cd /vllm-workspace/vllm && \
    export CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS && \
    export PATH="/root/.cargo/bin:$PATH" && \
    export PROTOC_INCLUDE=/usr/include && \
    python3 -m pip install -r requirements/build/rust.txt && \
    bash tools/build_rust.sh && \
    python3 -m pip cache purge

# Install vllm-ascend
# Limit cargo parallelism to avoid OOM in constrained build environments.
# Overridable via --build-arg CARGO_BUILD_JOBS=N (e.g. 32-CPU/128Gi buildkitd
# runs up to 2 builds in parallel, so 16 jobs keep memory within ~64Gi per build).
# Limit opc/c++ build parallelism to avoid OOM. Mirrors
# .github/workflows/_build_csrc_cache.yaml.
# TODO: auto-detect buildkitd CPU cores and set MAX_JOBS accordingly

# Dependency versions used by the vllm-ascend build.
ARG SOC_VERSION="ascend950dt_9582"
ARG MAX_JOBS=16
ENV SOC_VERSION=$SOC_VERSION \
    TASK_QUEUE_ENABLE=1 \
    OMP_NUM_THREADS=1 \
    CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS \
    MAX_JOBS=$MAX_JOBS
COPY . /vllm-workspace/vllm-ascend/

ARG ASCEND_INDEX_URL="https://mirrors.huaweicloud.com/ascend/repos/pypi \
    https://mirrors.huaweicloud.com/ascend/repos/pypi/nightly"
ARG COMPILE_CUSTOM_KERNELS=1
RUN export PIP_EXTRA_INDEX_URL="${ASCEND_INDEX_URL}" && \
    export VLLM_BATCH_INVARIANT=1 && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    python3 -m pip install -e /vllm-workspace/vllm-ascend/ --extra-index-url ${PYTORCH_INDEX_URL} && \
    python3 -m pip cache purge

# Install cannbot wheels
ARG TARGETPLATFORM
RUN case "$TARGETPLATFORM" in \
  linux/arm64) \
    wget -c "https://vllm-ascend.obs.cn-north-4.myhuaweicloud.com/vllm-ascend/cannbotdsl-0.6.0%2Bg91e7c8f-cp312-cp312-manylinux_2_28_aarch64.whl" -P /tmp && \
    wget -c "https://vllm-ascend.obs.cn-north-4.myhuaweicloud.com/vllm-ascend/cannbot_arena_net_ops-0.1.0-cp312-cp312-linux_aarch64.whl" -P /tmp && \
    python3 -m pip install /tmp/cannbotdsl-0.6.0+g91e7c8f-cp312-cp312-manylinux_2_28_aarch64.whl \
        /tmp/cannbot_arena_net_ops-0.1.0-cp312-cp312-linux_aarch64.whl && \
    rm -f /tmp/cannbot*.whl && \
    python3 -m pip cache purge ;; \
  linux/amd64) \
    echo "TARGET is x86_64, skip cannbot wheels install" ;; \
  *) echo "Unsupported platform: $TARGETPLATFORM" && exit 1 ;; \
esac

# ===== Install FLA and mooncake =====
ARG TARGETPLATFORM
ARG FLA_VERSION="26.9.1"
ARG FLA_PACKAGE="flash-linear-attention-npu-a5"
ARG MOONCAKE_VERSION="0.3.14rc3"
ARG MOONCAKE_RELEASE_TAG="v0.3.14-pre-3"
RUN case "${TARGETPLATFORM:-$(uname -m)}" in \
        linux/amd64|x86_64) MOONCAKE_ARCH=x86_64 ;; \
        linux/arm64|aarch64) MOONCAKE_ARCH=aarch64 ;; \
        *) echo "Unsupported platform: ${TARGETPLATFORM:-$(uname -m)}" && exit 1 ;; \
    esac && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    # Install mooncake NPU transfer engine
    MOONCAKE_BASE="https://github.com/kvcache-ai/Mooncake/releases/download/${MOONCAKE_RELEASE_TAG}" && \
    MOONCAKE_WHL="mooncake_transfer_engine_npu-${MOONCAKE_VERSION}-cp312-cp312-manylinux_2_35_${MOONCAKE_ARCH}.whl" && \
    python3 -m pip install --no-deps "${MOONCAKE_BASE}/${MOONCAKE_WHL}" && \
    # Install memfabric_hybrid kernels
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 mfcli kernel install --soc-version A5 && \
    # Install flash-linear-attention-npu from the Ascend mirror
    PIP_EXTRA_INDEX_URL="${ASCEND_INDEX_URL}" \
    python3 -m pip install --force-reinstall --no-deps \
        "${FLA_PACKAGE}===${FLA_VERSION}" && \
    python3 -m pip cache purge

# Append `libascend_hal.so` path (devlib) to LD_LIBRARY_PATH
RUN echo "export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/lib" >> ~/.bashrc

CMD ["/bin/bash"]
