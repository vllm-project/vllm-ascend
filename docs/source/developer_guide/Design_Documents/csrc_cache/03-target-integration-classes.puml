@startuml target_integration_classes
title Target: L1-assisted production, L0 delivery through GitHub Cache
skinparam classAttributeIconSize 0
hide empty members
left to right direction

package "Callers (thin workflow wiring)" {
  class "PR nightly / weekly entry" as PR <<existing workflows>>
  class "Image build entry" as Image <<existing workflow>>
  class "Trusted nightly publication" as Warm <<existing workflow>>
}
package "Coordination (reuse existing workflows)" {
  class "_ensure_csrc_cache.yaml" as Ensure <<extend>> {
    +pin_source_checkout()
    +resolve_target_matrix()
    +schedule_producers()
    +return_source_ref()
  }
  class "resolve_csrc_cache_targets.py" as Resolver <<extend>> {
    +configured_targets(ids)
    +Dockerfile_targets(FROM, SOC, architecture, OS)
    +nightly_targets(runtime_image, SOC)
  }
  class "BuildTarget" as Target <<JSON value, not new runtime class>> {
    runner / image / cache_arch / soc_version / os
    image_tag / nightly
  }
  class "_build_csrc_cache.yaml" as Producer <<extend>> {
    +lookup_L0_before_build()
    +restore_L1_on_L0_miss()
    +compile_in_target_container()
    +verify_artifacts()
    +publish_L0_to_GitHub_Cache()
    +save_L1_if_writer_credentials_present()
  }
}
package "Artifact identity and delivery" {
  class "Existing image / regular L0 identity" as ImageKey <<reuse>> {
    architecture + CANN tag + tracked csrc inputs
  }
  class "nightly_csrc_l0.py" as NightlyGuard <<small shared script>> {
    +cache_key(runtime, source, Python, Torch ABI, compiler, flags)
    +write_manifest(key, file_digests)
    +validate_and_copy(key, source_root)
  }
  class "nightly-csrc-l0-restore" as Restore <<small composite action>> {
    +compute_identity()
    +restore_exact_L0()
    +accept_only_valid_artifacts()
  }
  class "L0 artifact bundle" as L0 <<immutable cache value>> {
    vllm_ascend/*.so
    _cann_ops_custom / lib / include
    nightly manifest (nightly namespace only)
  }
  class "GitHub Actions Cache" as GHA <<existing L0 storage>>
}
package "Incremental production (reuse unchanged engine)" {
  class "csrc-l1-restore / csrc-l1-save" as L1 <<existing actions>>
  class "build.sh + build_cache.py" as Engine <<existing engine>> {
    inner content / environment validation
    successful-build pruning / .updated
  }
  class "OBS L1 snapshots" as OBS <<existing L1 storage>>
}
package "Consumers" {
  class "Image Docker build" as Docker <<existing path>> {
    +L0_hit: COMPILE_CUSTOM_KERNELS=0
    +miss_or_producer_failure: source_build()
  }
  class "PR nightly single-node source install" as Consumer <<extend>> {
    +validate_L0_then_skip_compilation()
    +miss_or_invalid: original_source_build()
  }
}

PR --> Ensure : exact PR head + current runtime image
Image --> Ensure : Dockerfile + source ref
Warm --> Ensure : main/release source + published runtime
Ensure --> Resolver
Resolver --> Target
Ensure --> Producer : pinned source + resolved target
Producer --> ImageKey : regular / image mode
Producer --> Restore : nightly mode
Producer --> L1 : only L0 miss
Producer --> Engine : normal or nightly dependency installation
L1 --> OBS
Engine ..> L0 : successful verified build
Producer --> NightlyGuard : record nightly manifest
Producer --> GHA : actions/cache/save
Restore --> NightlyGuard
Restore --> GHA : actions/cache/restore
Consumer --> Restore
Docker --> ImageKey
Docker --> GHA : actions/cache/restore

note bottom of Producer
  Single responsibility: materialize missing final artifacts.
  L0 HIT skips L1 download and compilation.
  Nightly mode keeps image-pinned Torch / Torch-NPU packages.
  No nested Docker lifecycle manager or copied compiler stage.
end note
note bottom of Consumer
  No direct persistent L1 dependency in the new nightly path.
  Existing multi-node Pod/PVC cache behavior is outside this integration.
end note
note bottom of GHA
  Native GitHub branch/ref cache visibility still applies.
  HIT requires the same key and literal transport paths.
  Normal L0 uses its existing namespace; nightly has a separate ABI namespace.
end note
legend bottom
  This is a responsibility/contract model, not a request for factories,
  abstract base classes, a storage framework, or additional runtime knobs.
endlegend
@enduml
