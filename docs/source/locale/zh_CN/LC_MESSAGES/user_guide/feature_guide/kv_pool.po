msgstr "### ASCEND_GLOBAL_RESOURCE_CONFIG"

msgid "| Field | Type | Default | Required | Value Range | Description |"
msgstr "| 字段 | 类型 | 默认值 | 是否必填 | 取值范围 | 描述 |"

