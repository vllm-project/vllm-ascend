msgid "`suffix`"
msgstr "`suffix`"

#: ../../source/user_guide/feature_guide/speculative_decoding.md
msgid "Suffix-based pattern matching (requires Arctic Inference)"
msgstr "基于后缀的模式匹配（需要 Arctic Inference）"

#: ../../source/user_guide/feature_guide/speculative_decoding.md
msgid "`medusa`"
msgstr "`medusa`"

#: ../../source/user_guide/feature_guide/speculative_decoding.md
msgid "Medusa heads embedded in the target model"
msgstr "嵌入在目标模型中的 Medusa 头"

#: ../../source/user_guide/feature_guide/speculative_decoding.md
msgid "`eagle`"
msgstr "`eagle`"

#: ../../source/user_guide/feature_guide/speculative_decoding.md
msgid "EAGLE-based draft model"
msgstr "基于 EAGLE 的草稿模型"

