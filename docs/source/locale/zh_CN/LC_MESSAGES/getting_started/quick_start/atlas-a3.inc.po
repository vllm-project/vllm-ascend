msgid "=== \"Atlas A3\""
msgstr "=== \"Atlas A3\""

msgid "**This path uses**"
msgstr "**本路径使用**"

msgid ""
"- Model: `Qwen/Qwen3-0.6B`\n"
"    - Mode: offline batch inference / online OpenAI-compatible serving\n"
"    - Model reference: [Qwen3 Dense](../tutorials/models/Qwen3-Dense.md)"
