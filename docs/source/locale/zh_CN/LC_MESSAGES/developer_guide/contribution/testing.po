msgid "The detailed report will be written to:"
msgstr "详细报告将写入："

#: ../../source/developer_guide/contribution/testing.md:373
msgid "`docs/_build/linkcheck/output.txt`"
msgstr "`docs/_build/linkcheck/output.txt`"

