msgstr "| 测试路径包含 | 运行器 |"

msgid "| Syntax | Scope |"
msgstr "| 语法 | 作用域 |"

msgid "| Syntax | Description |"
msgstr "| 语法 | 描述 |"

msgid "| Command | PR comments | Issue comments |"
msgstr "| 命令 | PR评论 | Issue评论 |"

msgid "| Command | Who can trigger |"
msgstr "| 命令 | 触发者 |"

msgid "| `four_card/_310p` | 310P 4-card |"
msgstr "| `four_card/_310p` | 310P 四卡 |"

msgid "| `_310p` (under `one_card`/`two_card`) | 310P single card |"
msgstr "| `_310p`（位于 `one_card`/`two_card` 下） | 310P 单卡 |"

msgid "| `four_card` | A3 4-card |"
msgstr "| `four_card` | A3 四卡 |"

msgid "| `two_card` | A3 2-card |"
msgstr "| `two_card` | A3 双卡 |"

msgid "| Others (e.g. `one_card`) | A2 single card |"
msgstr "| 其他（例如 `one_card`） | A2 单卡 |"

