msgid ""
"`--speculative-config '{\"method\": \"qwen3_5_mtp\", "
"\"num_speculative_tokens\": 3, \"enforce_eager\": true}'`"
msgstr ""
"`--speculative-config '{\"method\": \"qwen3_5_mtp\", "
"\"num_speculative_tokens\": 3, \"enforce_eager\": true}'`"

#: ../../source/tutorials/models/Qwen3.5-397B-A17B.md:841
msgid "Improves decode throughput when acceptance rate is good."
msgstr "在接受率良好时提高解码吞吐。"

#: ../../source/tutorials/models/Qwen3.5-397B-A17B.md:841
msgid "Reduce speculative tokens if latency or stability regresses."
