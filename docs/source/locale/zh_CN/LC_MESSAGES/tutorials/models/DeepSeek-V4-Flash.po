msgstr "        |`--dp-address`|str|是|-|数据并行主节点的 IP 地址。|"

msgid ""
"        |`--dp-rpc-port`|str|No|12345|RPC port for data parallel master "
"communication.|"
msgstr "        |`--dp-rpc-port`|str|否|12345|用于数据并行主节点通信的 RPC 端口。|"

msgid ""
"        |`--vllm-start-port`|int|No|9000|Starting port for each vLLM engine "
