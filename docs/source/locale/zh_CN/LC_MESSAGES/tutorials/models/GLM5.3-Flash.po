msgid "**`launch_online_dp.py` parameters:**"
msgstr ""

msgid "|Parameter|Type|Required|Default|Description|"
msgstr ""

msgid "|`--dp-size`|int|Yes|-|Data parallel size (total number of DP ranks across all nodes).|"
