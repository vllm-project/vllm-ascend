# CANN_QUAY_URL (optional): Registry URL of the CANN base image.
ARG CANN_QUAY_URL="quay.io/ascend/cann"
# CANN_VERSION (optional): CANN toolkit version used to select the base image tag.
ARG CANN_VERSION="9.1.0"

FROM ${CANN_QUAY_URL}:${CANN_VERSION}-950-openeuler24.03-py3.12

# Build-time arguments (declared once at the top of the stage for clarity).
# PYTORCH_INDEX_URL (optional): Extra pip index URL for PyTorch wheels.
ARG PYTORCH_INDEX_URL="https://download.pytorch.org/whl/cpu/"
# ASCEND_INDEX_URL (optional): Extra pip index URL for Ascend/CANN Python packages.
ARG ASCEND_INDEX_URL="https://mirrors.huaweicloud.com/ascend/repos/pypi"
# MOONCAKE_TAG (optional): Version tag of the mooncake-transfer-engine-npu package.
ARG MOONCAKE_TAG=v0.3.14-rc1
ARG MOONCAKE_OBS_PREFIX="https://mindie.obs.cn-north-4.myhuaweicloud.com/buildtools/docker_images_tools/Mooncake/v0.3.14.rc1"
# VLLM_REPO (optional): Git repository URL of vLLM.
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
# VLLM_TAG (optional): vLLM release tag to clone when VLLM_COMMIT is empty.
ARG VLLM_TAG=v0.31.0
# VLLM_COMMIT (optional): Exact vLLM commit to build; empty to fall back to VLLM_TAG.
ARG VLLM_COMMIT=""
# SOC_VERSION (optional): Ascend SoC version used for custom kernel compilation.
ARG SOC_VERSION="ascend950dt_9582"
# COMPILE_CUSTOM_KERNELS (optional): Whether to compile custom Ascend kernels (1 = yes, 0 = no).
ARG COMPILE_CUSTOM_KERNELS=1
# CARGO_BUILD_JOBS (optional): Number of parallel cargo build jobs.
ARG CARGO_BUILD_JOBS=16
# MAX_JOBS (optional): Number of parallel build jobs passed to make/ninja.
ARG MAX_JOBS=16
# BUILD_TYPE (optional): Build type: 'release' or 'daily' (daily installs extra deps).
ARG BUILD_TYPE="release"
# MEMCACHE_VERSION (optional, empty if unset): memcache package version for daily builds.
ARG MEMCACHE_VERSION
# MEMCACHE_DATE (optional, empty if unset): memcache package build date for daily builds.
ARG MEMCACHE_DATE
# MEMFABRIC_VERSION (optional, empty if unset): memfabric package version for daily builds.
ARG MEMFABRIC_VERSION
# MEMFABRIC_DATE (optional, empty if unset): memfabric package build date for daily builds.
ARG MEMFABRIC_DATE
# TORCH_NPU_VERSION (optional, empty if unset): torch_npu version for daily builds.
ARG TORCH_NPU_VERSION
# TORCH_NPU_DATE (optional, empty if unset): torch_npu build date for daily builds.
ARG TORCH_NPU_DATE
# TRITON_ASCEND_VERSION (optional, empty if unset): triton-ascend version for daily builds.
ARG TRITON_ASCEND_VERSION
# TRITON_ASCEND_PACKAGE_VERSION (optional, empty if unset): triton-ascend package version for daily builds.
ARG TRITON_ASCEND_PACKAGE_VERSION
# DAILY_DEPS_MODE (optional): Daily deps install mode: 'full' or 'torch_npu_only'.
ARG DAILY_DEPS_MODE="full"
ARG FLA_VERSION="26.9.1+dev812ccc8"
ARG FLA_RELEASE_TAG="v26.9.1-20261015-121515"

WORKDIR /workspace

SHELL ["/bin/bash", "-c"]

# Install clang (for triton-ascend)
RUN yum update -y && \
    yum install -y git vim wget curl protobuf protobuf-devel protobuf-compiler net-tools gcc gcc-c++ make cmake numactl numactl-devel libibverbs-devel hiredis-devel clang patch && \
    rm -rf /var/cache/yum/*

# ====== Install Mooncake ======
ARG TARGETPLATFORM
RUN ARCH=${TARGETPLATFORM:-$(uname -m)}; \
    case "$ARCH" in \
        "linux/arm64"|"aarch64") \
            MOONCAKE_WHL="mooncake_transfer_engine-0.3.13-cp312-cp312-manylinux_2_35_aarch64.whl" ;; \
        "linux/amd64"|"x86_64") \
            MOONCAKE_WHL="mooncake_transfer_engine-0.3.13-cp312-cp312-manylinux_2_35_x86_64.whl" ;; \
        *) echo "Unsupported arch for mooncake: $ARCH" && exit 1 ;; \
    esac && \
    MOONCAKE_URL="${MOONCAKE_OBS_PREFIX}/${MOONCAKE_WHL}" && \
    echo "Download mooncake whl: ${MOONCAKE_URL}" && \
    wget -q --no-check-certificate "${MOONCAKE_URL}" -P /tmp && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    pip install /tmp/${MOONCAKE_WHL} --force-reinstall --no-deps && \
    echo "***********check mooncake-transfer-engine-npu version***********" && \
    pip show mooncake-transfer-engine && \
    rm -rf /tmp/${MOONCAKE_WHL} && \
    pip cache purge

# Install modelscope (for fast download) and ray (for multinode)
RUN python3 -m pip install 'modelscope<1.38' 'ray>=2.47.1,<=2.48.0' 'protobuf>3.20.0' && \
    python3 -m pip cache purge

# Install vLLM
RUN  if [ -n "$VLLM_COMMIT" ]; then \
      git init /vllm-workspace/vllm && \
      git -C /vllm-workspace/vllm fetch --depth 1 $VLLM_REPO "$VLLM_COMMIT" && \
      git -C /vllm-workspace/vllm checkout FETCH_HEAD; \
    else \
      git clone --depth 1 -b $VLLM_TAG $VLLM_REPO /vllm-workspace/vllm; \
    fi

# In x86, triton will be installed by vllm. But in Ascend, triton doesn't work correctly. we need to uninstall it.
RUN VLLM_TARGET_DEVICE="empty" python3 -m pip install -e /vllm-workspace/vllm/[audio] --extra-index-url ${PYTORCH_INDEX_URL} && \
    python3 -m pip uninstall -y triton && \
    python3 -m pip cache purge

# Install vllm-ascend
# Limit cargo parallelism to avoid OOM in constrained build environments.
# Overridable via --build-arg CARGO_BUILD_JOBS=N (e.g. 32-CPU/128Gi buildkitd
# runs up to 2 builds in parallel, so 16 jobs keep memory within ~64Gi per build).
# Limit opc/c++ build parallelism to avoid OOM. Mirrors
# .github/workflows/_build_csrc_cache.yaml.
# TODO: auto-detect buildkitd CPU cores and set MAX_JOBS accordingly
ENV SOC_VERSION=$SOC_VERSION \
    TASK_QUEUE_ENABLE=1 \
    OMP_NUM_THREADS=1 \
    CARGO_BUILD_JOBS=$CARGO_BUILD_JOBS \
    MAX_JOBS=$MAX_JOBS
COPY . /vllm-workspace/vllm-ascend/

RUN export PIP_EXTRA_INDEX_URL="${ASCEND_INDEX_URL}" && \
    export VLLM_BATCH_INVARIANT=1 && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    python3 -m pip install -e /vllm-workspace/vllm-ascend/ --extra-index-url ${PYTORCH_INDEX_URL} && \
    python3 -m pip uninstall -y triton triton-ascend && \
    python3 -m pip install triton-ascend==3.6.0 --extra-index-url ${ASCEND_INDEX_URL} && \
    python3 -m pip install concurrent-log-handler && \
    python3 -m pip cache purge

# Install flash-linear-attention-npu (A5 only)
ARG TARGETPLATFORM
RUN ARCH=${TARGETPLATFORM:-$(uname -m)}; \
    case "$ARCH" in \
        "linux/arm64"|"aarch64") \
            FLA_WHL="flash_linear_attention_npu_a5-${FLA_VERSION}-py3-none-manylinux_2_34_aarch64.whl"; \
            FLA_SHA256="52718f982f39e7e83bb3e9eb6d81f17d7062bb8350ce2fb85f4b9f155114cec2" ;; \
        "linux/amd64"|"x86_64") \
            FLA_WHL="flash_linear_attention_npu_a5-${FLA_VERSION}-py3-none-manylinux_2_34_x86_64.whl"; \
            FLA_SHA256="d0b7ae671b0cad699a9767c12d9ec622397acd5e607f5eb31753dd8b0c43e112" ;; \
        *) echo "Unsupported arch for flash-linear-attention-npu: $ARCH" && exit 1 ;; \
    esac && \
    FLA_DOWNLOAD_URL="https://github.com/flashserve/flash-linear-attention-npu/releases/download/${FLA_RELEASE_TAG}/${FLA_WHL}"; \
    if [ -n "${GIT_PROXY}" ]; then \
        FLA_DOWNLOAD_URL="${GIT_PROXY}${FLA_DOWNLOAD_URL}"; \
    fi && \
    wget --quiet "$FLA_DOWNLOAD_URL" -O /tmp/${FLA_WHL} && \
    echo "${FLA_SHA256}  /tmp/${FLA_WHL}" | sha256sum --check && \
    python3 -m pip install --force-reinstall --no-deps /tmp/${FLA_WHL} && \
    rm -f /tmp/${FLA_WHL} && \
    python3 -m pip cache purge

# Install cannbot wheels (only aarch64)
RUN ARCH=$(uname -m); \
    if [ "$ARCH" = "aarch64" ]; then \
        wget -c "https://raw.githubusercontent.com/GDzhu01/cannbot-wheels/main/cannbotdsl-0.6.0+g91e7c8f-cp312-cp312-manylinux_2_28_aarch64.whl" -P /tmp && \
        wget -c "https://raw.githubusercontent.com/GDzhu01/cannbot-wheels/main/cannbot_arena_net_ops-0.1.0-cp312-cp312-linux_aarch64.whl" -P /tmp && \
        python3 -m pip install /tmp/cannbot*.whl && \
        rm -f /tmp/cannbot*.whl && \
        python3 -m pip cache purge; \
    else \
        echo "x86_64, skip cannbot wheels"; \
    fi

# Install _rust_tool_parser for the Rust frontend.
# The default toolchain is read from vllm's rust-toolchain.toml (falling back
# to stable).
ENV PATH="/root/.cargo/bin:$PATH"
RUN cd /vllm-workspace/vllm && \
    export PROTOC_INCLUDE=/usr/include && \
    python3 -m pip install -r requirements/build/rust.txt && \
    bash tools/build_rust.sh

RUN echo "export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/lib" >> ~/.bashrc

# ===== Conditional installation based on BUILD_TYPE =====

# Install daily packages via shared script
COPY .github/workflows/scripts/install_daily_deps.sh /tmp/
RUN if [ "$BUILD_TYPE" = "daily" ]; then \
        bash /tmp/install_daily_deps.sh; \
    else \
        echo "Building release version without daily packages"; \
    fi && rm -f /tmp/install_daily_deps.sh

CMD ["/bin/bash"]
