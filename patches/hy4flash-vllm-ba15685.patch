index 0000000000000000000000000000000000000000..12db894da496b1305f1d0b5736b3b49bc3d037c2
--- /dev/null
+++ b/vllm/models/hy_v4_flash/reference.py
@@ -0,0 +1,130 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Torch reference operations for HYV4 Flash."""
+
+import torch
+import torch.nn.functional as F
+
+INDEX_DIM = 128
+FP8_MAX = 448.0
+
+
+def indexpool_fp8(vectors: torch.Tensor) -> torch.Tensor:
+    """Apply the orthonormal Hadamard transform and E4M3 row rounding."""
+    x = vectors.float()
+    width = x.shape[-1]
+    stride = 1
+    while stride < width:
+        left, right = x.reshape(-1, 2, stride).unbind(1)
+        x = torch.stack((left + right, left - right), dim=1).reshape(vectors.shape)
+        stride *= 2
+    x = x * width**-0.5
+    scale = torch.exp2(
+        torch.ceil(torch.log2(x.abs().amax(-1, keepdim=True).clamp_min(1e-4) / FP8_MAX))
+    )
+    magnitude = (x / scale).abs().clamp_max(FP8_MAX)
+    # E4M3FN has three mantissa bits and subnormals spaced at 2**-9.
+    unit = torch.exp2(torch.floor(torch.log2(magnitude.clamp_min(2**-6))) - 3)
+    return (magnitude / unit).round() * unit * x.sign() * scale
+
+
+def decode_e4m3fn(bits: torch.Tensor) -> torch.Tensor:
+    """Decode FP8 bytes without requiring float8 tensor support on device."""
+    bits = bits.int()
+    exp = (bits >> 3) & 15
+    fraction = (bits & 7).float() / 8
+    magnitude = torch.exp2(exp.float().clamp_min(1) - 7)
+    magnitude = magnitude * (fraction + (exp != 0))
+    value = torch.where(bits >= 128, -magnitude, magnitude)
+    return value.masked_fill((bits & 127) == 127, torch.nan)
+
+
+def pooled_keys(raw, value_weight, gate_weight, ape, norm_weight, eps):
+    values = F.linear(raw.float(), value_weight)
+    gates = F.linear(raw.float(), gate_weight)
+    pooled = (values * (gates + ape).softmax(dim=1)).sum(dim=1)
+    return F.rms_norm(pooled, (INDEX_DIM,), norm_weight, eps).to(raw.dtype)
+
+
+def sparse_candidates(query, weights, keys, positions, ratio, history_budget):
+    """Recall complete groups and the causally visible part of the current group."""
+    offsets = torch.arange(ratio, device=positions.device)
+    group_at_query = positions // ratio
+    num_groups = keys.shape[-2]
+    if num_groups:
+        if keys.ndim == 3:
+            per_head = torch.bmm(query, keys.transpose(1, 2))
+            scores = (per_head.relu() * weights.unsqueeze(-1)).sum(1)
+        else:
+            per_head = torch.matmul(query.transpose(0, 1), keys.T)
+            scores = (per_head.relu() * weights.T.unsqueeze(-1)).sum(0)
+        groups = torch.arange(num_groups, device=keys.device)
+        scores = scores.masked_fill(groups >= group_at_query[:, None], -torch.inf)
+        count = min(history_budget, num_groups)
+        scores, selected = scores.topk(count, dim=-1)
+        selected = selected.masked_fill(scores == -torch.inf, num_groups)
+        selected = selected.sort(dim=-1).values
+        history = selected.unsqueeze(-1) * ratio + offsets
+        history = history.masked_fill(
+            selected.unsqueeze(-1) >= group_at_query[:, None, None], -1
+        )
+        history = history.flatten(1)
+    else:
+        history = positions.new_empty((positions.shape[0], 0))
+    tail = group_at_query[:, None] * ratio + offsets
+    return torch.cat((history, tail.masked_fill(tail > positions[:, None], -1)), dim=-1)
+
+
+def window_candidates(positions, window):
+    offsets = torch.arange(1 - window, 1, device=positions.device)
+    return (positions[:, None] + offsets).clamp_min(-1)
+
+
+def mla_attention_probs(query, latent, candidates, sink, scale):
+    # The sink contributes a logit and a zero-valued vector.
+    scores = torch.bmm(query.float(), latent.float().transpose(1, 2)) * scale
+    scores.masked_fill_(candidates[:, None, :] < 0, -torch.inf)
+    sink_logits = sink.view(1, -1, 1).expand(query.shape[0], -1, -1)
+    probs = torch.cat((scores, sink_logits), dim=-1).softmax(dim=-1)[..., :-1]
+    return probs
+
+
+def hash_ngrams(
+    input_ids,
+    lookback,
+    token_map,
+    multipliers,
+    primes,
+    offsets,
+    pad_id,
+    pad_token_id,
+    visual_ids,
+):
+    """lookback[0] is the token immediately before this chunk."""
+    depth = multipliers.shape[1] - 1
+    tokens = torch.cat((lookback[:depth].flip(0), input_ids)).long()
+    dead = tokens >= token_map.numel()
+    source = token_map[tokens.clamp(0, token_map.numel() - 1)].long()
+    count = input_ids.numel()
+    rolling = torch.zeros(
+        (multipliers.shape[0], count), dtype=torch.int64, device=input_ids.device
+    )
+    blocked = torch.zeros(count, dtype=torch.bool, device=input_ids.device)
+    hashes = []
+    for shift in range(depth + 1):
+        start = depth - shift
+        span = slice(start, start + count)
+        blocked = blocked | dead[span] | (tokens[span] < 0)
+        mapped = torch.where(blocked, pad_id, source[span])
+        rolling = torch.bitwise_xor(rolling, mapped * multipliers[:, shift, None])
+        if shift:
+            hashes.append(
+                (rolling.unsqueeze(-1) % primes[:, None, shift - 1])
+                + offsets.reshape_as(primes)[:, None, shift - 1]
+            )
+    invalid = (
+        (input_ids < 0) | (input_ids >= token_map.numel()) | (input_ids == pad_token_id)
+    )
+    for token_id in visual_ids:
+        invalid = invalid | (input_ids == token_id)
+    return torch.cat(hashes, dim=-1).masked_fill(invalid[None, :, None], -1).int()
