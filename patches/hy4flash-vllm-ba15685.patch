+    pixel_values_videos: Annotated[torch.Tensor, TensorShape("np", "cps")]
+    video_grid_thw: Annotated[torch.Tensor, TensorShape("nv", 3)]
+
+
+@MULTIMODAL_REGISTRY.register_processor(
+    HYV4VLMultiModalProcessor,
