+        )
+        with self._mark_tower_model(vllm_config, {"image", "video"}):
+            self.visual = None
+            if enabled:
+                quant = vllm_config.quant_config
+                self.visual = HYV4VisionTransformer(
+                    self.config.vision_config,
+                    quant_config=quant,
