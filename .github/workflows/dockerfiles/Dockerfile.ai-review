#
# Pre-installed image for the ai-review bot job (triggered by the `ai-review`
# label, see .github/workflows/ai_review.yml). The image carries Node.js and
# the DeepSeek Harness CLI (`dsh`) so that the agent job starts with zero
# per-run installation; the model itself runs on the DeepSeek API side.
#
# Built and pushed by .github/workflows/_schedule_ai_review_image_build.yaml
# as quay.io/ascend-ci/vllm-ascend:ai-review.

FROM ubuntu:22.04

ARG TARGETARCH

# curl/jq/git are the same tooling contract the ci-gate bot jobs rely on:
# every step talks to the GitHub API through the gh-compatible REST surface.
# pyyaml is needed by the ai-review orchestrator (domains.yaml registry).
RUN apt-get update -y && \
    apt-get install -y curl git jq ca-certificates xz-utils python3 python3-pip && \
    rm -rf /var/cache/apt/* && \
    rm -rf /var/lib/apt/lists/* && \
    python3 -m pip install pyyaml regex

# gh CLI: the orchestrator drives every GitHub API call through it.
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /usr/share/keyrings/githubcli-archive-keyring.gpg && \
    echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list && \
    apt-get update -y && \
    apt-get install -y gh && \
    rm -rf /var/cache/apt/* && \
    rm -rf /var/lib/apt/lists/*

# Node.js 22 LTS (dsh is a Node application; keep the major pinned so a
# upstream Node release cannot silently break the agent image)
ARG NODE_MAJOR=22
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/cache/apt/* && \
    rm -rf /var/lib/apt/lists/*

# DeepSeek Harness CLI. Builds are manual and deliberate, so this installs
# the current release; the version used lands in the build log via the
# `dsh --version` smoke check below.
RUN npm install -g "@deepseek-ai/dsh@next" && \
    npm cache clean --force

# Smoke check: fail the build early if the CLIs cannot start in this image.
RUN dsh --version && gh --version

CMD ["/bin/bash"]
