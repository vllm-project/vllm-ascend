# This file is a part of the vllm-ascend project.
#
# 基于空白麒麟 V10 SP3（glibc 2.28）自建 vLLM v0.23.0 + vllm-ascend 0.23.0 环境。
#
# 交付形态：完全离线镜像。构建期允许联网（麒麟 dnf 源 / PyPI / CANN 下载），
# 运行期所需依赖全部固化进镜像，不依赖外网。
#
# 构建上下文要求：无（CANN/etcd 在镜像内下载，motor wheel 走 build secret）
#
#   MindIE-Motor（PD 分离）官方 wheel 通过 build secret 提供：
#     docker buildx build --secret id=motor_wheel,src=<motor>.whl --build-arg MOTOR_REQUIRED=1 ...
#   未传 secret 且 MOTOR_REQUIRED=0（默认）时仅告警并跳过，便于 CI 构建基础镜像。
#
# mooncake 与客户环境一致：不做 pip 安装，从源码编译 0.3.12.post1
# memfabric / memcache 由 requirements.txt 固定版本（1.3.0）随 vllm-ascend 安装。
# etcd 由官方 release 下载后内置，供 MindIE-Motor 做服务发现。
#
# 可选参数：
#   --build-arg KYLIN_REPO_URL=<麒麟 dnf 源 .repo 地址>   基础镜像已内置源，缺省即用镜像内配置
#   --build-arg CANN_BASE_URL=<内网 CANN 包地址>          外网不可达时改为内网镜像
#   --build-arg CANN_PKG_ARCH=aarch64|x86_64             缺省按构建架构自动选择
#   --build-arg ETCD_VERSION=v3.5.21                     内置 etcd 版本
#   --build-arg GCC_VERSION=12.3.0                       软件源无 C++20 工具链时源码编译的 GCC 版本
#   --build-arg GCC_TARBALL_URL=<内网 gcc 源码 tar 地址>   可选，优先于公网地址
#   --build-arg MAX_JOBS=32
#
# 本仓库源码必须是 releases/v0.23.0 分支（main 为 vLLM 0.33 世代，无法在此环境运行）。

ARG OS_IMAGE=cr.kylinos.cn/kylin/kylin-server-init:v10sp3-2403
FROM ${OS_IMAGE}

ARG PYTHON_VERSION=3.12.4
ARG KYLIN_REPO_URL=""
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
ARG VLLM_TAG=v0.23.0
ARG VLLM_COMMIT=""
ARG PYTORCH_INDEX_URL=https://download.pytorch.org/whl/cpu/
ARG ASCEND_INDEX_URL=https://mirrors.huaweicloud.com/ascend/repos/pypi
ARG SOC_VERSION=ascend910_9382
ARG FLA_VERSION="26.10.0+feature"
ARG FLASH_ATTN_NPU_VERSION="0.5.0"
ARG MOONCAKE_REPO=https://github.com/kvcache-ai/Mooncake.git
ARG MOONCAKE_TAG=v0.3.12.post1
ARG MAX_JOBS

# CANN 9.1.0 官方包（内网可整体替换 CANN_BASE_URL）
# 包名中的架构段默认按构建架构自动选择（aarch64 / x86_64），
# CI 的 a3 矩阵同时跑 amd64 与 arm64 runner，写死会在另一架构上装不上。
ARG CANN_BASE_URL=https://ascend-repo.obs.cn-east-2.myhuaweicloud.com/CANN/CANN%209.1.0
ARG CANN_VERSION=9.1.0
ARG CANN_PKG_ARCH=""

WORKDIR /workspace
SHELL ["/bin/bash", "-c"]

# 1) 系统依赖：基础镜像已内置 kylin_aarch64.repo（V10SP3-2403 base/updates），
#    这里只校验 dnf 可用；KYLIN_REPO_URL 非空时用外部 .repo 覆盖。
RUN set -e; \
    PM="$(command -v dnf || command -v yum || true)"; \
    if [ -z "$PM" ]; then \
        echo "ERROR: 基础镜像无 dnf/yum，需换带包管理器的麒麟基础镜像"; \
        exit 1; \
    fi; \
    if [ -n "${KYLIN_REPO_URL}" ]; then \
        curl -fsSL "${KYLIN_REPO_URL}" -o /etc/yum.repos.d/kylin.repo; \
    fi; \
    $PM makecache || { echo "ERROR: dnf 无可用软件源，请配置 .repo 或传 KYLIN_REPO_URL"; exit 1; }; \
    $PM install -y git vim wget curl make patch tar gzip gawk sed grep findutils gcc gcc-c++ m4 \
        openssl-devel bzip2-devel libffi-devel zlib-devel xz xz-devel \
        sqlite-devel readline-devel ncurses-devel \
        numactl numactl-devel libibverbs-devel hiredis-devel libcurl-devel \
        yaml-cpp-devel gflags-devel boost-devel \
        zstd libzstd-devel \
        jemalloc clang && \
    for p in libaio-devel libunwind-devel jsoncpp-devel liburing-devel xxhash xxhash-devel; do \
        $PM install -y "$p" || echo "WARN: 可选依赖 $p 不可用，稍后由源码编译环节兜底"; \
    done; \
    if ! command -v mpicc >/dev/null 2>&1; then \
        $PM install -y mpich mpich-devel >/dev/null 2>&1 || \
        $PM install -y openmpi openmpi-devel >/dev/null 2>&1 || \
        echo "WARN: 软件源无 MPI 开发包，mooncake 的 USE_ASCEND 传输层将无法编译"; \
    fi; \
    rm -rf /var/cache/yum/* /var/cache/dnf/*

# 1b) C++20 工具链：vllm-ascend 的依赖 arctic-inference 用 nanobind 构建，要求 C++20，
#     麒麟自带 GCC 7.3 不支持。优先安装软件源里的新版工具链（gcc-toolset-*/gcc-NN），
#     源里没有则源码编译 GCC 到 /usr/local。最终统一软链到 /usr/local/bin，供后续所有编译使用。
ARG GCC_VERSION=12.3.0
ARG GCC_TARBALL_URL=""
RUN set -e; \
    PM="$(command -v dnf || command -v yum)"; \
    probe() { \
        printf 'int main(){return 0;}\n' > /tmp/probe.cpp; \
        "$1" -std=c++20 /tmp/probe.cpp -o /tmp/probe.out >/dev/null 2>&1; \
    }; \
    CXX_BIN=""; \
    if probe /usr/bin/g++; then \
        echo "INFO: 系统 g++ 已支持 C++20，无需升级"; \
        CXX_BIN=/usr/bin/g++; \
    else \
        for pkgset in "gcc-toolset-12-gcc gcc-toolset-12-gcc-c++" \
                      "gcc-toolset-11-gcc gcc-toolset-11-gcc-c++" \
                      "gcc-toolset-10-gcc gcc-toolset-10-gcc-c++" \
                      "gcc-10 gcc-c++-10" \
                      "gcc10 gcc10-c++"; do \
            echo "INFO: 尝试从软件源安装 ${pkgset}"; \
            $PM install -y ${pkgset} >/dev/null 2>&1 || continue; \
            for c in /opt/rh/gcc-toolset-12/root/usr/bin/g++ \
                     /opt/rh/gcc-toolset-11/root/usr/bin/g++ \
                     /opt/rh/gcc-toolset-10/root/usr/bin/g++ \
                     /usr/bin/g++-10 /usr/bin/g++10; do \
                if [ -x "$c" ] && probe "$c"; then CXX_BIN="$c"; break; fi; \
            done; \
            [ -n "$CXX_BIN" ] && break; \
        done; \
    fi; \
    if [ -z "$CXX_BIN" ]; then \
        echo "INFO: 软件源无可用 C++20 编译器，源码编译 GCC ${GCC_VERSION}"; \
        GCC_TAR=/tmp/gcc.tar; rm -f "$GCC_TAR"; \
        URLS="https://mirrors.huaweicloud.com/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz \
https://mirrors.huaweicloud.com/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.gz \
https://repo.huaweicloud.com/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.gz \
https://mirrors.aliyun.com/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz \
https://mirrors.tuna.tsinghua.edu.cn/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz \
https://ftp.gnu.org/gnu/gcc/gcc-${GCC_VERSION}/gcc-${GCC_VERSION}.tar.xz"; \
        if [ -n "${GCC_TARBALL_URL}" ]; then URLS="${GCC_TARBALL_URL} ${URLS}"; fi; \
        for url in $URLS; do \
            echo "INFO: 下载 GCC 源码 ${url}"; \
            if curl -fL --retry 3 --retry-delay 3 --connect-timeout 20 \
                    --speed-limit 102400 --speed-time 30 --max-time 900 \
                    -o "$GCC_TAR" "$url" && tar -tf "$GCC_TAR" >/dev/null 2>&1; then \
                break; \
            fi; \
            echo "INFO: 该地址失败或过慢，换下一个"; \
            rm -f "$GCC_TAR"; \
        done; \
        if ! tar -tf "$GCC_TAR" >/dev/null 2>&1; then \
            echo "ERROR: GCC 源码下载失败（网络不稳可直接用 --build-arg GCC_TARBALL_URL 指内网地址）"; \
            exit 1; \
        fi; \
        mkdir -p /tmp/gccsrc && tar -xf "$GCC_TAR" -C /tmp/gccsrc --strip-components=1; \
        dep_fetch() { \
            local target="$1"; shift; \
            for url in "$@"; do \
                echo "INFO: 下载 GCC 依赖 ${url}"; \
                if curl -fL --retry 3 --retry-delay 3 --connect-timeout 20 \
                        --speed-limit 51200 --speed-time 30 --max-time 600 \
                        -o /tmp/dep.tar "$url" && tar -tf /tmp/dep.tar >/dev/null 2>&1; then \
                    mkdir -p "/tmp/gccsrc/${target}" && \
                    tar -xf /tmp/dep.tar -C "/tmp/gccsrc/${target}" --strip-components=1 && \
                    rm -f /tmp/dep.tar && return 0; \
                fi; \
                rm -f /tmp/dep.tar; \
            done; \
            return 1; \
        }; \
        dep_fetch gmp gmp-6.2.1 \
            https://mirrors.huaweicloud.com/gnu/gmp/gmp-6.2.1.tar.xz \
            https://mirrors.aliyun.com/gnu/gmp/gmp-6.2.1.tar.xz \
            https://mirrors.tuna.tsinghua.edu.cn/gnu/gmp/gmp-6.2.1.tar.xz \
            https://gcc.gnu.org/pub/gcc/infrastructure/gmp-6.2.1.tar.bz2 \
            || { echo "ERROR: GMP 源码下载失败"; exit 1; }; \
        dep_fetch mpfr mpfr-4.1.0 \
            https://mirrors.huaweicloud.com/gnu/mpfr/mpfr-4.1.0.tar.xz \
            https://mirrors.aliyun.com/gnu/mpfr/mpfr-4.1.0.tar.xz \
            https://mirrors.tuna.tsinghua.edu.cn/gnu/mpfr/mpfr-4.1.0.tar.xz \
            https://gcc.gnu.org/pub/gcc/infrastructure/mpfr-4.1.0.tar.bz2 \
            || { echo "ERROR: MPFR 源码下载失败"; exit 1; }; \
        dep_fetch mpc mpc-1.2.1 \
            https://mirrors.huaweicloud.com/gnu/mpc/mpc-1.2.1.tar.gz \
            https://mirrors.aliyun.com/gnu/mpc/mpc-1.2.1.tar.gz \
            https://mirrors.tuna.tsinghua.edu.cn/gnu/mpc/mpc-1.2.1.tar.gz \
            https://gcc.gnu.org/pub/gcc/infrastructure/mpc-1.2.1.tar.gz \
            || { echo "ERROR: MPC 源码下载失败"; exit 1; }; \
        if ! dep_fetch isl isl-0.24 \
                https://gcc.gnu.org/pub/gcc/infrastructure/isl-0.24.tar.bz2 \
                https://libisl.sourceforge.io/isl-0.24.tar.bz2; then \
            echo "WARN: ISL 下载失败，构建时自动跳过 graphite（不影响 C/C++ 编译）"; \
        fi; \
        mkdir -p /tmp/gccbuild && cd /tmp/gccbuild && \
        /tmp/gccsrc/configure --prefix=/usr/local --enable-languages=c,c++ \
            --disable-bootstrap --disable-multilib --with-system-zlib && \
        make -j"${MAX_JOBS:-$(nproc)}" && make install-strip; \
        cd / && rm -rf /tmp/gccsrc /tmp/gccbuild "$GCC_TAR"; \
        CXX_BIN=/usr/local/bin/g++; \
    fi; \
    probe "$CXX_BIN" || { echo "ERROR: $CXX_BIN 仍不支持 C++20"; exit 1; }; \
    CC_BIN="${CXX_BIN%g++}gcc"; \
    echo "INFO: 选用编译器 $CXX_BIN (版本 $("$CXX_BIN" -dumpversion))"; \
    mkdir -p /usr/local/bin /usr/local/lib64; \
    link_tool() { \
        src="$1"; dst="/usr/local/bin/$2"; \
        if [ "$(readlink -f "$src")" = "$(readlink -f "$dst")" ]; then return 0; fi; \
        ln -sf "$src" "$dst"; \
    }; \
    link_tool "$CXX_BIN" g++; \
    link_tool "$CC_BIN" gcc; \
    link_tool "$CXX_BIN" c++; \
    link_tool "$CC_BIN" cc; \
    STDCPP="$("$CXX_BIN" -print-file-name=libstdc++.so)"; \
    if [ -f "$STDCPP" ]; then \
        CXX_LIBDIR="$(dirname "$(readlink -f "$STDCPP")")"; \
        if [ "$CXX_LIBDIR" != "/usr/local/lib64" ]; then \
            for f in "$CXX_LIBDIR"/libstdc++.so.6*; do \
                [ -e "$f" ] || continue; \
                ln -sf "$f" /usr/local/lib64/; \
            done; \
        fi; \
    fi; \
    ldconfig; \
    /usr/local/bin/g++ --version | head -1

ENV CC=/usr/local/bin/gcc \
    CXX=/usr/local/bin/g++

# 2) 源码编译 Python 3.12（麒麟 V10 自带 3.7，不满足 torch 2.10 / vLLM 0.23 要求）
RUN curl -fsSL https://www.python.org/ftp/python/${PYTHON_VERSION}/Python-${PYTHON_VERSION}.tgz -o /tmp/Python.tgz && \
    mkdir -p /tmp/pybuild && tar -xzf /tmp/Python.tgz -C /tmp/pybuild --strip-components=1 && \
    cd /tmp/pybuild && \
    ./configure --prefix=/usr/local --enable-shared --with-ensurepip=install && \
    make -j"${MAX_JOBS:-$(nproc)}" && make install && \
    mkdir -p /etc/ld.so.conf.d && printf '/usr/local/lib\n/usr/local/lib64\n' > /etc/ld.so.conf.d/usr-local.conf && ldconfig && \
    cd /tmp && rm -rf /tmp/pybuild /tmp/Python.tgz && \
    LD_LIBRARY_PATH=/usr/local/lib python3 -V && \
    LD_LIBRARY_PATH=/usr/local/lib python3 -m pip install -U pip setuptools wheel

ENV PATH=/usr/local/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/lib64:/usr/local/lib

# 2b) CANN 安装前需要的基础 Python 库（CANN 9.1 官方安装依赖清单；
#     pathlib2 已不兼容 py3.12，故不安装）
RUN python3 -m pip install attrs cython numpy decorator sympy cffi pyyaml \
        psutil protobuf scipy requests absl-py && \
    python3 -m pip cache purge

# 3) 下载并安装 CANN 9.1.0（toolkit 必装；nnal、A3-ops 存在则装；驱动由宿主机提供）
#    注意：NNAL 要求"已安装同版本 Toolkit 并配置环境变量"，否则安装器直接退出（rc=4），
#    所以 toolkit 装完后先 source set_env.sh 再装 nnal / A3-ops。
RUN set -e; cd /tmp; \
    if [ -z "${CANN_PKG_ARCH}" ]; then \
        case "$(uname -m)" in \
            aarch64) CANN_PKG_ARCH=aarch64 ;; \
            x86_64)  CANN_PKG_ARCH=x86_64 ;; \
            *) echo "ERROR: 不支持的架构 $(uname -m)"; exit 1 ;; \
        esac; \
    fi; \
    TOOLKIT_PKG="Ascend-cann-toolkit_${CANN_VERSION}_linux-${CANN_PKG_ARCH}.run"; \
    NNAL_PKG="Ascend-cann-nnal_${CANN_VERSION}_linux-${CANN_PKG_ARCH}.run"; \
    OPS_PKG="Ascend-cann-A3-ops_${CANN_VERSION}_linux-${CANN_PKG_ARCH}.run"; \
    echo "INFO: CANN 包架构 ${CANN_PKG_ARCH}"; \
    fetch() { \
        echo "INFO: downloading $1"; \
        curl -fL --retry 3 --retry-delay 5 --connect-timeout 30 \
            -H "Referer: https://www.hiascend.com/" \
            -o "$(basename "$1")" "$1"; \
    }; \
    fetch "${CANN_BASE_URL}/${TOOLKIT_PKG}"; \
    fetch "${CANN_BASE_URL}/${NNAL_PKG}"; \
    fetch "${CANN_BASE_URL}/${OPS_PKG}" || echo "WARN: ops 包下载失败，跳过"; \
    df -h /tmp; \
    for t in awk sed grep tar gzip md5sum; do \
        command -v "$t" >/dev/null || echo "WARN: 缺少命令 $t"; \
    done; \
    ls -lh /tmp/*.run; \
    chmod +x /tmp/*.run; \
    report() { \
        rc=$1; name=$2; log=$3; \
        echo "===== CANN ${name} 安装失败 rc=${rc} ====="; \
        df -h /tmp /usr/local || true; \
        echo "----- ${log} 末尾 15 行 -----"; \
        tail -n 15 "$log" || true; \
        echo "----- ${log} 错误行 -----"; \
        grep -i -E "\[ERROR\]|ERR_NO|failed|No space|Permission denied" "$log" | tail -n 10 || true; \
        if [ -f /var/log/ascend_seclog/ascend_install.log ]; then \
            echo "----- ascend_install.log 错误行 -----"; \
            grep -i -E "\[ERROR\]|ERR_NO|failed" /var/log/ascend_seclog/ascend_install.log | tail -n 10 || true; \
        fi; \
        ls -l /var/log/ascend_seclog/ 2>/dev/null || true; \
        echo "CANN_FAIL ${name} rc=${rc} log=${log}"; \
        exit $rc; \
    }; \
    /tmp/${TOOLKIT_PKG} --install --quiet > /tmp/cann_toolkit.log 2>&1 || report $? toolkit /tmp/cann_toolkit.log; \
    for f in /usr/local/Ascend/cann/set_env.sh /usr/local/Ascend/ascend-toolkit/set_env.sh; do if [ -f "$f" ]; then . "$f"; fi; done; \
    /tmp/${NNAL_PKG} --install --quiet > /tmp/cann_nnal.log 2>&1 || report $? nnal /tmp/cann_nnal.log; \
    if [ -f "/tmp/${OPS_PKG}" ]; then \
        /tmp/${OPS_PKG} --install --quiet > /tmp/cann_ops.log 2>&1 || report $? a3-ops /tmp/cann_ops.log; \
    fi; \
    rm -f /tmp/*.run

# 4) modelscope / ray（多机） / protobuf；cmake>=3.26 与 ninja 由 pip 提供
#    （麒麟源里的 cmake 版本低于 vllm-ascend 要求，且镜像初始无 cmake）
#    限定 cmake < 4：CMake 4 移除了对 cmake_minimum_required<3.5 的兼容，
#    glog 0.6.0 / mooncake 0.3.12 这类旧工程会直接配置失败
RUN python3 -m pip install 'modelscope<1.38' 'ray>=2.47.1,<=2.48.0' 'protobuf>3.20.0' \
        'cmake>=3.26,<4' ninja && \
    python3 -m pip cache purge

# 4b) glog：麒麟 V10 SP3 源里没有 glog/glog-devel，mooncake 依赖 libglog，源码编译
ARG GLOG_TAG=v0.6.0
RUN git clone --depth 1 -b ${GLOG_TAG} https://github.com/google/glog.git /tmp/glog && \
    cmake -S /tmp/glog -B /tmp/glog/build \
        -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_INSTALL_PREFIX=/usr/local && \
    cmake --build /tmp/glog/build -j"${MAX_JOBS:-$(nproc)}" && \
    cmake --install /tmp/glog/build && ldconfig && \
    rm -rf /tmp/glog

# 5) 安装 vLLM v0.23.0（源码方式，TARGET_DEVICE=empty；0.23 无 rust 前端）
RUN if [ -n "$VLLM_COMMIT" ]; then \
      git init /vllm-workspace/vllm && \
      git -C /vllm-workspace/vllm fetch --depth 1 $VLLM_REPO "$VLLM_COMMIT" && \
      git -C /vllm-workspace/vllm checkout FETCH_HEAD; \
    else \
      git clone --depth 1 -b $VLLM_TAG $VLLM_REPO /vllm-workspace/vllm; \
    fi && \
    VLLM_TARGET_DEVICE="empty" python3 -m pip install -e /vllm-workspace/vllm/[audio] \
        --extra-index-url ${PYTORCH_INDEX_URL} && \
    python3 -m pip uninstall -y triton && \
    python3 -m pip cache purge

# 6) 编译安装 vllm-ascend（源码必须是 releases/v0.23.0）
ENV SOC_VERSION=$SOC_VERSION \
    TASK_QUEUE_ENABLE=1 \
    OMP_NUM_THREADS=1
COPY . /vllm-workspace/vllm-ascend/
RUN export PIP_EXTRA_INDEX_URL="${ASCEND_INDEX_URL}" && \
    export VLLM_BATCH_INVARIANT=1 && \
    for f in /usr/local/Ascend/cann/set_env.sh /usr/local/Ascend/ascend-toolkit/set_env.sh; do if [ -f "$f" ]; then . "$f"; fi; done && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    python3 -m pip install -e /vllm-workspace/vllm-ascend/ \
        --extra-index-url ${PYTORCH_INDEX_URL} && \
    python3 -m pip cache purge

# 7) memfabric kernel + flash-linear-attention + flash_attn_npu
#    FLA(a3) 在 Ascend 源上的所有版本都只提供 manylinux_2_34 轮子，而麒麟 V10 glibc 是 2.28，
#    pip 会直接判 "not a supported wheel"。该包是 py3-none（纯 python + CANN 算子 .so），
#    所以按架构下载后把平台标签改写为 any 再本地安装，绕开 pip 的标签校验。
RUN export PIP_EXTRA_INDEX_URL="${ASCEND_INDEX_URL}" && \
    for f in /usr/local/Ascend/cann/set_env.sh /usr/local/Ascend/ascend-toolkit/set_env.sh; do if [ -f "$f" ]; then . "$f"; fi; done && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    TORCH_DEVICE_BACKEND_AUTOLOAD=0 mfcli kernel install --soc-version A3 --install-for-all && \
    case "$(uname -m)" in \
        aarch64) PKG_ARCH=aarch64 ;; \
        x86_64)  PKG_ARCH=x86_64 ;; \
        *) echo "ERROR: 不支持的架构 $(uname -m)"; exit 1 ;; \
    esac && \
    FLA_WHL="flash_linear_attention_npu_a3-${FLA_VERSION}-py3-none-manylinux_2_34_${PKG_ARCH}.whl" && \
    curl -fL --retry 3 --retry-delay 5 -o /tmp/fla.whl \
        "${ASCEND_INDEX_URL}/flash-linear-attention-npu-a3/${FLA_WHL}" && \
    cp /tmp/fla.whl "/tmp/flash_linear_attention_npu_a3-${FLA_VERSION}-py3-none-any.whl" && \
    python3 -m pip install --force-reinstall --no-deps \
        "/tmp/flash_linear_attention_npu_a3-${FLA_VERSION}-py3-none-any.whl" && \
    rm -f /tmp/fla.whl "/tmp/flash_linear_attention_npu_a3-${FLA_VERSION}-py3-none-any.whl" && \
    FLASH_ATTN_BUILD_NPU=910 python3 -m pip install --no-build-isolation \
        "flash_attn_npu==${FLASH_ATTN_NPU_VERSION}" && \
    python3 -m pip cache purge

# 8) 从源码编译 mooncake 0.3.12.post1（与客户环境一致，不走 pip 二进制）
#    mooncake 的 cmake 通过 find_package(yalantinglibs) 找 coro_rpc 依赖，该库以子模块
#    extern/yalantinglibs 形式提供，必须 --recurse-submodules 一起拉下来并先装好，
#    否则 configure 直接报 "Could not find a package configuration file provided by yalantinglibs"。
RUN for f in /usr/local/Ascend/cann/set_env.sh /usr/local/Ascend/ascend-toolkit/set_env.sh; do if [ -f "$f" ]; then . "$f"; fi; done; \
    LOG=/tmp/mooncake_build.log; : > "$LOG"; \
    set -o pipefail; \
    trap 'rc=$?; if [ $rc -ne 0 ]; then echo "===== MOONCAKE ERROR SUMMARY ====="; grep -nE "error:|undefined reference|Error [0-9]+|No such file|not found" "$LOG" | tail -n 40; echo "===== END SUMMARY ====="; fi' EXIT; \
    { git clone -b ${MOONCAKE_TAG} --recurse-submodules ${MOONCAKE_REPO} /tmp/Mooncake && \
      cmake -S /tmp/Mooncake/extern/yalantinglibs -B /tmp/ylt-build \
          -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
          -DBUILD_EXAMPLES=OFF -DBUILD_BENCHMARK=OFF -DBUILD_UNIT_TESTS=OFF && \
      cmake --build /tmp/ylt-build -j"${MAX_JOBS:-$(nproc)}" && \
      cmake --install /tmp/ylt-build && \
      rm -rf /tmp/ylt-build && ldconfig && \
      if [ ! -e /usr/include/xxhash.h ] && [ ! -e /usr/local/include/xxhash.h ]; then \
          echo "INFO: 系统无 xxhash 开发头文件，源码编译 xxHash v0.8.3"; \
          git clone --depth 1 -b v0.8.3 https://github.com/Cyan4973/xxHash.git /tmp/xxHash && \
          cmake -S /tmp/xxHash/cmake_unofficial -B /tmp/xxHash/build \
              -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr/local \
              -DXXHASH_BUILD_XXHSUM=OFF && \
          cmake --build /tmp/xxHash/build -j"${MAX_JOBS:-$(nproc)}" && \
          cmake --install /tmp/xxHash/build && \
          rm -rf /tmp/xxHash && ldconfig; \
      fi; \
      cd /tmp/Mooncake && mkdir -p build && cd build && \
      MPI_ARGS=""; \
      for d in /usr/lib64/mpich /usr/lib64/openmpi /usr/lib/x86_64-linux-gnu/openmpi \
               /usr/lib/aarch64-linux-gnu/openmpi; do \
          if [ -x "$d/bin/mpicc" ]; then \
              MPI_ARGS="-DMPI_C_COMPILER=$d/bin/mpicc -DMPI_CXX_COMPILER=$d/bin/mpicxx"; \
              export LD_LIBRARY_PATH="$d/lib:$d/lib64:$LD_LIBRARY_PATH"; \
              break; \
          fi; \
      done; \
      cmake .. -DCMAKE_BUILD_TYPE=Release \
          -DCMAKE_CXX_FLAGS="-Wno-maybe-uninitialized -Wno-stringop-overflow" \
          -DWITH_TE=ON -DUSE_CUDA=OFF -DUSE_ASCEND=ON ${MPI_ARGS} && \
      make -j"${MAX_JOBS:-$(nproc)}" && make install && ldconfig; } 2>&1 | tee -a "$LOG"

# 9) mooncake python 绑定
RUN for f in /usr/local/Ascend/cann/set_env.sh /usr/local/Ascend/ascend-toolkit/set_env.sh; do if [ -f "$f" ]; then . "$f"; fi; done && \
    cd /tmp/Mooncake && python3 -m pip install . && \
    rm -rf /tmp/Mooncake && python3 -m pip cache purge

RUN echo 'export LD_PRELOAD=/usr/lib64/libjemalloc.so.2:$LD_PRELOAD' >> ~/.bashrc && \
    echo 'export LD_LIBRARY_PATH=/usr/local/lib64:/usr/local/lib:$LD_LIBRARY_PATH' >> ~/.bashrc

# 10) 内置 etcd（MindIE-Motor 服务发现；离线运行不再依赖外部 etcd）
ARG ETCD_VERSION=v3.5.21
RUN set -e; \
    case "$(uname -m)" in \
        aarch64) ETCD_ARCH=arm64 ;; \
        x86_64)  ETCD_ARCH=amd64 ;; \
        *) echo "ERROR: 不支持的架构 $(uname -m)"; exit 1 ;; \
    esac; \
    ETCD_PKG="etcd-${ETCD_VERSION}-linux-${ETCD_ARCH}"; \
    curl -fsSL "https://github.com/etcd-io/etcd/releases/download/${ETCD_VERSION}/${ETCD_PKG}.tar.gz" \
        -o /tmp/etcd.tgz; \
    tar -xzf /tmp/etcd.tgz -C /tmp; \
    install -m 0755 "/tmp/${ETCD_PKG}/etcd" /usr/local/bin/; \
    install -m 0755 "/tmp/${ETCD_PKG}/etcdctl" /usr/local/bin/; \
    rm -rf /tmp/etcd.tgz "/tmp/${ETCD_PKG}"; \
    etcd --version; etcdctl version

# 11) MindIE-Motor（PD 分离服务）：官方 wheel 打进镜像，运行期离线可用
#     wheel 通过 build secret 传入，不依赖构建上下文里存在 offline/ 目录：
#       docker buildx build --secret id=motor_wheel,src=<motor>.whl ...
#     未传 secret 时按 MOTOR_REQUIRED 决定告警跳过还是失败。
ARG MOTOR_REQUIRED=0
RUN --mount=type=secret,id=motor_wheel \
    set -e; \
    if [ -f /run/secrets/motor_wheel ]; then \
        install -m 0644 /run/secrets/motor_wheel /tmp/motor.whl; \
        python3 -m pip install /tmp/motor.whl; \
        rm -f /tmp/motor.whl; \
        python3 -m pip cache purge; \
    elif [ "${MOTOR_REQUIRED}" = "1" ]; then \
        echo "ERROR: 未提供 MindIE-Motor wheel，请用 --secret id=motor_wheel,src=<wheel>"; \
        exit 1; \
    else \
        echo "WARN: 未提供 MindIE-Motor wheel，跳过 PD 分离组件安装"; \
    fi

CMD ["/bin/bash"]
