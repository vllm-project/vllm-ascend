{
  "dump": {
    "auto_max_times": 0,
    "auto_cooldown_seconds": 300,
    "manual_dump": false,
    "dump_dir": null
  },
  "ascend_log": {
    "level": "INFO",
    "debug": [],
    "modules": {}
  },
  "report": {
    "save_sensitive_info": false,
    "max_prompt_token_ids": 100000,
    "max_output_token_ids": 100000,
    "max_per_req": 1
  },
  "actions": {
    "defaults": {
      "on_trigger": [
        "report"
      ]
    }
  },
  "detector": {
    "spec_acceptance": {
      "enabled": false,
      "window": 10,
      "low_threshold": 0.3,
      "len_low_threshold": 1.4,
      "high_threshold": 0.96,
      "len_high_threshold": 2.8
    },
    "token_repeat": {
      "enabled": false,
      "window": 32,
      "repeat_sum_threshold": 64,
      "min_tokens": 32,
      "consecutive_hits": 1,
      "ignore_token_ids": []
    },
    "logits_finite": {
      "enabled": false,
      "item_sync": false
    }
  }
}
