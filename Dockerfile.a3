# CANN_QUAY_URL (optional): Registry URL of the CANN base image.
ARG CANN_QUAY_URL="quay.io/ascend/cann"
# CANN_VERSION: CANN toolkit version used to select the base image tag.
# CI does not override this pinned value; update it here.
ARG CANN_VERSION="9.1.0"

FROM ${CANN_QUAY_URL}:${CANN_VERSION}-a3-ubuntu22.04-py3.12

# Build-time arguments (declared once at the top of the stage for clarity).
# PYTORCH_INDEX_URL (optional): Extra pip index URL for PyTorch wheels.
ARG PYTORCH_INDEX_URL="https://download.pytorch.org/whl/cpu/"
# ASCEND_INDEX_URL (optional): Extra pip index URL for Ascend/CANN Python packages.
ARG ASCEND_INDEX_URL="https://mirrors.huaweicloud.com/ascend/repos/pypi"
# MOONCAKE_TAG (optional): Version tag of the mooncake-transfer-engine-npu package.
ARG MOONCAKE_TAG=0.3.11.post1
# VLLM_REPO (optional): Git repository URL of vLLM.
ARG VLLM_REPO=https://github.com/vllm-project/vllm.git
# VLLM_TAG (optional): vLLM release tag to clone when VLLM_COMMIT is empty.
ARG VLLM_TAG=v0.31.0
# VLLM_COMMIT (optional): Exact vLLM commit to build; empty to fall back to VLLM_TAG.
ARG VLLM_COMMIT=""
# SOC_VERSION (optional): Ascend SoC version used for custom kernel compilation.
ARG SOC_VERSION="ascend910_9391"
# COMPILE_CUSTOM_KERNELS (optional): Whether to compile custom Ascend kernels (1 = yes, 0 = no).
ARG COMPILE_CUSTOM_KERNELS=1
# ===== Pinned dependency versions (single source of truth) =====
# Release and nightly builds use the same Dockerfile and these exact versions.
# Update the pins here; CI does not override them.
# MEMCACHE_VERSION: memcache package version.
ARG MEMCACHE_VERSION="1.3.0"
# MEMCACHE_DATE: memcache package build date.
ARG MEMCACHE_DATE="20261017.1"
# MEMFABRIC_VERSION: memfabric package version.
ARG MEMFABRIC_VERSION="1.3.0"
# MEMFABRIC_DATE: memfabric package build date.
ARG MEMFABRIC_DATE="20261017.1"
# TORCH_NPU_VERSION: torch_npu package version.
ARG TORCH_NPU_VERSION="26.2.0"
# TORCH_NPU_DATE: torch_npu package build date.
ARG TORCH_NPU_DATE="20261015.5"
# TRITON_ASCEND_VERSION: triton-ascend package version.
ARG TRITON_ASCEND_VERSION="20261013220622"
# TRITON_ASCEND_PACKAGE_VERSION: URL-encoded triton-ascend wheel version.
ARG TRITON_ASCEND_PACKAGE_VERSION="3.6.0%2Bdev20261013220622"
# flash-linear-attention-npu
ARG FLA_VERSION="26.9.1+dev812ccc8"
ARG FLA_RELEASE_TAG="v26.9.1-20261015-121515"

ENV DEBIAN_FRONTEND=noninteractive

WORKDIR /workspace

# Install clang-15 (for triton-ascend) and Mooncake
RUN apt-get update -y && \
    apt-get install -y git vim wget curl protobuf-compiler libprotobuf-dev net-tools gcc g++ cmake numactl libnuma-dev libibverbs-dev libhiredis-dev clang-15 && \
    update-alternatives --install /usr/bin/clang clang /usr/bin/clang-15 20 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-15 20 && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    python3 -m pip install mooncake-transfer-engine-npu==${MOONCAKE_TAG} && \
    rm -rf /var/cache/apt/* && \
    rm -rf /var/lib/apt/lists/*

# Install modelscope (for fast download) and ray (for multinode)
RUN python3 -m pip install 'modelscope<1.38' 'ray>=2.47.1,<=2.48.0' 'protobuf>3.20.0' && \
    python3 -m pip cache purge

# Install vLLM
RUN if [ -n "$VLLM_COMMIT" ]; then \
      git init /vllm-workspace/vllm && \
      git -C /vllm-workspace/vllm fetch --depth 1 $VLLM_REPO "$VLLM_COMMIT" && \
      git -C /vllm-workspace/vllm checkout FETCH_HEAD; \
    else \
      git clone --depth 1 -b $VLLM_TAG $VLLM_REPO /vllm-workspace/vllm; \
    fi

# In x86, triton will be installed by vllm. But in Ascend, triton doesn't work correctly. we need to uninstall it.
RUN VLLM_TARGET_DEVICE="empty" python3 -m pip install -e /vllm-workspace/vllm/[audio] --extra-index-url ${PYTORCH_INDEX_URL} && \
    python3 -m pip uninstall -y triton && \
    python3 -m pip cache purge

# Install vllm-ascend
ENV DEBIAN_FRONTEND=noninteractive
ENV SOC_VERSION=$SOC_VERSION \
    TASK_QUEUE_ENABLE=1 \
    OMP_NUM_THREADS=1
COPY . /vllm-workspace/vllm-ascend/

RUN export PIP_EXTRA_INDEX_URL="${ASCEND_INDEX_URL}" && \
    export VLLM_BATCH_INVARIANT=1 && \
    source /usr/local/Ascend/ascend-toolkit/set_env.sh && \
    source /usr/local/Ascend/nnal/atb/set_env.sh && \
    python3 -m pip install -e /vllm-workspace/vllm-ascend/ --extra-index-url ${PYTORCH_INDEX_URL} && \
    python3 -m pip uninstall -y triton triton-ascend && \
    python3 -m pip install concurrent-log-handler && \
    python3 -m pip cache purge

# Install flash-linear-attention-npu (A3 only)
ARG TARGETPLATFORM
RUN ARCH=${TARGETPLATFORM:-$(uname -m)}; \
    case "$ARCH" in \
        "linux/arm64"|"aarch64") \
            FLA_WHL="flash_linear_attention_npu_a3-${FLA_VERSION}-py3-none-manylinux_2_34_aarch64.whl"; \
            FLA_SHA256="eca7ecde3c5d311e00db6bed376899459b91433afb2c86a8513ad487825a3b8c" ;; \
        "linux/amd64"|"x86_64") \
            FLA_WHL="flash_linear_attention_npu_a3-${FLA_VERSION}-py3-none-manylinux_2_34_x86_64.whl"; \
            FLA_SHA256="81425360c763342ccbc872b077ee1d7eb62bba91f312d5d8cc128de917fb57d5" ;; \
        *) echo "Unsupported arch for flash-linear-attention-npu: $ARCH" && exit 1 ;; \
    esac && \
    FLA_DOWNLOAD_URL="https://github.com/flashserve/flash-linear-attention-npu/releases/download/${FLA_RELEASE_TAG}/${FLA_WHL}"; \
    if [ -n "${GIT_PROXY}" ]; then \
        FLA_DOWNLOAD_URL="${GIT_PROXY}${FLA_DOWNLOAD_URL}"; \
    fi && \
    wget --quiet "$FLA_DOWNLOAD_URL" -O /tmp/${FLA_WHL} && \
    echo "${FLA_SHA256}  /tmp/${FLA_WHL}" | sha256sum --check && \
    python3 -m pip install --force-reinstall --no-deps /tmp/${FLA_WHL} && \
    rm -f /tmp/${FLA_WHL} && \
    python3 -m pip cache purge

# Install _rust_tool_parser for the Rust frontend.
# The default toolchain is read from vllm's rust-toolchain.toml (falling back
# to stable).
ENV PATH="/root/.cargo/bin:$PATH"
RUN cd /vllm-workspace/vllm && \
    export PROTOC_INCLUDE=/usr/include && \
    python3 -m pip install -r requirements/build/rust.txt && \
    bash tools/build_rust.sh

# Append `libascend_hal.so` path (devlib) to LD_LIBRARY_PATH
RUN echo "export LD_LIBRARY_PATH=$LD_LIBRARY_PATH:/usr/local/lib" >> ~/.bashrc

# ===== Install pinned dependencies =====

# These packages are installed on every build, so release and nightly images
# share exactly the same dependency set.
COPY .github/workflows/scripts/install_daily_deps.sh /tmp/
RUN bash /tmp/install_daily_deps.sh && rm -f /tmp/install_daily_deps.sh

CMD ["/bin/bash"]
