+constexpr const char *kSchema_mega_recurrent_kda_ssm =
+    "npu_mega_recurrent_kda_ssm(Tensor x, Tensor qkv, Tensor wa, Tensor wb, Tensor beta, Tensor gate, "
+    "Tensor norm, Tensor wo, Tensor conv_weights, Tensor(a!) conv, Tensor checkpoint, Tensor(b!) correction, "
+    "Tensor(c!) raw_key_gate, Tensor scratch, Tensor slots, Tensor accepted, Tensor a_log, Tensor bias, "
+    "Tensor prefix, Tensor scales, int algorithm, float scale, float lower, float eps, Tensor(d!) out, "
+    "int stream) -> Tensor(d!)";
+
+Tensor run_mega_recurrent_kda_ssm(Tensor x, Tensor weight, Tensor wa, Tensor wb, Tensor beta, Tensor gate,
+    Tensor norm, Tensor wo, Tensor convW, Tensor conv, Tensor checkpoint, Tensor correction, Tensor kg,
+    Tensor scratch, Tensor slots, Tensor accepted, Tensor aLog, Tensor bias, Tensor prefix, Tensor scales,
+    int64_t algorithm, double scale, double lower, double eps, Tensor out, int64_t stream)
+{
+    const auto h = meta_of(x), w = meta_of(weight), sw = meta_of(scales);
+    if (w.ndim != 3 || w.sizes[0] != 1 || w.sizes[1] != 7168 || w.sizes[2] <= 0 ||
+        w.sizes[2] % 384 || w.scalar_type != 24 || !w.contiguous || w.storage_offset ||
+        (sw.scalar_type != 0 && sw.scalar_type != 44) || !sw.contiguous ||
+        sw.sizes != std::vector<int64_t>{1,112,w.sizes[2],2} || meta_of(kg).scalar_type != 15)
+        throw std::invalid_argument("Invalid MX ReplaySSM weights or key/gate record");
