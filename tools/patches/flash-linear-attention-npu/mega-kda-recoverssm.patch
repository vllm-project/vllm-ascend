+++ b/fla/ops/ascendc/kda/mega_recurrent_kda/op_kernel/arch35/ssm_rows.h
@@ -0,0 +1,40 @@
+#pragma once
+#include "simt_api/device_functions.h"
+
+namespace kda {
+// Full verification batches use their input and output in place. Only ragged batches
+// map compact model rows to the fixed recurrence window, inside the same launch.
+template <bool Unpack>
+__simt_vf__ __aicore__ LAUNCH_BOUND(1024) inline void SsmRows(
+    __gm__ uint16_t *dst, __gm__ const uint16_t *src, __gm__ const int32_t *starts,
+    uint32_t batch, uint32_t width, uint32_t tokens, uint32_t core, uint32_t cores)
+{
+    uint32_t rows = Unpack ? tokens : batch * width;
+    uint64_t chunks = uint64_t(rows) * 7;
+    for (uint64_t tile = core; tile < chunks; tile += cores) {
+        uint32_t row = tile / 7, col = (tile % 7)*1024 + AscendC::Simt::GetThreadIdx();
+        uint32_t b = row / width;
+        if constexpr (Unpack) {
+            uint32_t lo = 0, hi = batch;
+            while (lo < hi) {
+                uint32_t mid = lo + (hi-lo)/2;
+                if (starts[mid+1] <= int32_t(row)) lo = mid+1;
+                else hi = mid;
+            }
+            b = lo;
+        }
+        uint16_t value = 0;
+        if (b < batch) {
+            int32_t start = starts[b], end = starts[b+1];
+            if (start >= 0 && end >= start && uint32_t(end) <= tokens && uint32_t(end-start) <= width) {
+                int32_t offset = Unpack ? int32_t(row)-start : int32_t(row%width);
+                if (offset >= 0 && offset < end-start) {
+                    uint32_t from = Unpack ? b*width+offset : start+offset;
+                    value = src[uint64_t(from)*7168 + col];
+                }
+            }
+        }
+        dst[uint64_t(row)*7168 + col] = value;
+    }
+}
+} // namespace kda
